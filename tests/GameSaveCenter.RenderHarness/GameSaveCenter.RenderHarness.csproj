<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <StartupObject>GameSaveCenter.RenderHarness.Program</StartupObject>
    <GscSourceRoot Condition="'$(GscSourceRoot)' == ''">$(GSC_SOURCE_ROOT)</GscSourceRoot>
    <GscSourceRoot Condition="'$(GscSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..</GscSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GscSourceRoot" Value="$(GscSourceRoot)" />
    <AssemblyMetadata Include="GscBuildCommit" Value="$(GscBuildCommit)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameSaveCenter.Playnite\GameSaveCenter.Playnite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" PrivateAssets="all" />
    <PackageReference Include="PlayniteSDK" PrivateAssets="all" />
  </ItemGroup>
</Project>
