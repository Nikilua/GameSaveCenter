<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- Render/build QA artifacts can live below a project directory; never compile their generated sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/artifacts/**;**/artifacts/**/*</DefaultItemExcludes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>0.6.70</VersionPrefix>
    <AssemblyVersion>0.6.70.0</AssemblyVersion>
    <FileVersion>0.6.70.0</FileVersion>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
