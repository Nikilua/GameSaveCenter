<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- Render/build QA artifacts can live below a project directory; never compile their generated sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/artifacts/**;**/artifacts/**/*;**/bin/**;**/bin/**/*;**/obj/**;**/obj/**/*</DefaultItemExcludes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>0.6.73</VersionPrefix>
    <AssemblyVersion>0.6.73.0</AssemblyVersion>
    <FileVersion>0.6.73.0</FileVersion>
    <!-- The build scripts provide one explicit source revision. Do not let the SDK
         append SourceRevisionId a second time to InformationalVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GscBuildCommit Condition="'$(GscBuildCommit)' == ''">$(GSC_BUILD_COMMIT)</GscBuildCommit>
    <GscBuildCommit Condition="'$(GscBuildCommit)' == ''">unknown</GscBuildCommit>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(VersionPrefix)+$(GscBuildCommit)</InformationalVersion>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Optional per-run isolation for builds/tests while another testhost or Worker
         still holds files in the repository's normal bin/obj tree. This is intentionally
         opt-in so regular IDE and CI output locations remain unchanged. -->
    <BaseOutputPath Condition="'$(GscBuildOutputRoot)' != ''">$(GscBuildOutputRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(GscBuildOutputRoot)' != ''">$(GscBuildOutputRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
