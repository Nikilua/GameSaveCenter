<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <ControlTemplate x:Key="WpfApple.ScrollThumb.Vertical" TargetType="{x:Type Thumb}">
    <Grid UseLayoutRounding="True">
      <Rectangle Margin="2,1" RadiusX="4" RadiusY="4"
                 Fill="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="WpfApple.ScrollThumb.Horizontal" TargetType="{x:Type Thumb}">
    <Grid UseLayoutRounding="True">
      <Rectangle Margin="1,2" RadiusX="4" RadiusY="4"
                 Fill="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
    </Grid>
  </ControlTemplate>
  <Style x:Key="WpfApple.ScrollBar.Vertical" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid>
            <Track x:Name="PART_Track" Margin="0,4" Orientation="Vertical" IsDirectionReversed="True">
              <Track.Resources>
                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">64</sys:Double>
              </Track.Resources>
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb MinHeight="32" Background="#8A8F9D" Template="{StaticResource WpfApple.ScrollThumb.Vertical}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WpfApple.ScrollBar.Horizontal" TargetType="{x:Type ScrollBar}">
    <Setter Property="Height" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid>
            <Track x:Name="PART_Track" Margin="4,0" Orientation="Horizontal">
              <Track.Resources>
                <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">64</sys:Double>
              </Track.Resources>
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb MinWidth="32" Background="#8A8F9D" Template="{StaticResource WpfApple.ScrollThumb.Horizontal}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
