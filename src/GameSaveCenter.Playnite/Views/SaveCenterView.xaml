<UserControl x:Class="GameSaveCenter.Playnite.Views.SaveCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GameSaveCenter.Playnite.Infrastructure"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             Foreground="{DynamicResource GscPrimaryTextBrush}" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <!-- Redesign already merges WpfUiProduction and its component dictionaries. -->
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
<Style x:Key="SaveDataGrid" TargetType="DataGrid" BasedOn="{StaticResource GscRedesignWorkspaceDataGrid}"/>
            <Style x:Key="SaveTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="SaveLongText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
            <Style x:Key="SavePathText" TargetType="TextBlock" BasedOn="{StaticResource GscPathText}"><Setter Property="ToolTip" Value="{Binding Path}"/></Style>
            <Style x:Key="SaveHistoryTimeText" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyTimeCell}"><Setter Property="ToolTip" Value="{Binding CreatedFullDisplay, Mode=OneWay}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding CreatedFullDisplay, Mode=OneWay}"/></Style>
            <Style x:Key="SaveCountValue" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyNumericCell}"/>
            <Style x:Key="SaveSizeValue" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyNumericCell}"><Setter Property="TextTrimming" Value="None"/><Setter Property="Tag" Value="SaveHistorySize"/></Style>
            <Style x:Key="SaveHealthStateBadge" TargetType="Border" BasedOn="{StaticResource GscRedesignContextPill}">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Healthy">
                        <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Ready">
                        <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Risk">
                        <Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Warning">
                        <Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Attention">
                        <Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Running">
                        <Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SaveHealthStateText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Healthy">
                        <Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Ready">
                        <Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Risk">
                        <Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Warning">
                        <Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Attention">
                        <Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Running">
                        <Setter Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SaveFirstHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="SaveLastHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="SaveTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ui:AmbientMaterialLayer Panel.ZIndex="-1"/>
        <TabControl Grid.Row="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource GscRedesignWorkspaceTabControl}" SelectedIndex="{Binding SaveTabIndex, Mode=TwoWay}"><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource SaveTabItem}"/></TabControl.Resources>
            <TabItem Header="历史版本">
                <ScrollViewer x:Name="SaveHistoryPageScrollViewer" Style="{DynamicResource GscPageScrollViewer}" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid x:Name="SaveHistoryLayout" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscWorkspaceInspectorWidth}"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <Border x:Name="SaveHistoryTableFrame" Grid.Column="0" Grid.Row="0" Style="{StaticResource SaveTableFrame}">
                        <Grid x:Name="SaveHistoryTableLayout">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="SaveHistorySummaryCard" Grid.Row="0" Style="{DynamicResource GscReadingCardStyle}" Padding="12,4" Margin="0,0,0,2">
                                <Grid x:Name="SaveHistorySummaryGrid">
                                    <!-- Keep both groups finite-width so commands cannot squeeze the summary into a zero-width column. -->
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel x:Name="SaveHistorySummaryContentStack" Grid.Row="0" MinWidth="0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="存档清单" Style="{DynamicResource GscSectionTitleStyle}" VerticalAlignment="Center"/>
                                            <Border Style="{DynamicResource GscRedesignContextPill}" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Backups.Count, Mode=OneWay, StringFormat={}{0} 个版本}" Foreground="{DynamicResource GscAccentBrush}" FontSize="{DynamicResource GscCaptionFontSize}" FontWeight="SemiBold"/>
                                            </Border>
                                            <ui:Button x:Name="SaveHistoryCompactDetailsButton"
                                                       Style="{DynamicResource GscWpfUiCompactButton}"
                                                       Content="查看版本详情 ›"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"
                                                       Click="OnSaveHistoryCompactDetailsClick"
                                                       ToolTip="{Binding RestoreAvailabilityHint, Mode=OneWay}"
                                                       AutomationProperties.Name="查看或收起所选版本详情"
                                                       AutomationProperties.HelpText="{Binding RestoreAvailabilityHint, Mode=OneWay}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SaveHistoryTargetGame" Text="{Binding SelectedGame.Name, Mode=OneWay, TargetNullValue=未选择游戏, FallbackValue=未选择游戏}" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.IdentityDisplay, Mode=OneWay, TargetNullValue=未选择游戏, FallbackValue=未选择游戏}" AutomationProperties.Name="存档历史当前游戏" AutomationProperties.HelpText="{Binding SelectedGame.IdentityDisplay, Mode=OneWay, TargetNullValue=未选择游戏, FallbackValue=未选择游戏}"/>
                                        <TextBlock Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.HealthReasonDisplay, Mode=OneWay}"><Run Text="{Binding SelectedGame.MatchStateDisplay, Mode=OneWay, TargetNullValue=当前规则未匹配}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay, TargetNullValue=尚未校验}"/></TextBlock>
                                        <TextBlock Text="{Binding BackupHistoryRangeSummary, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.HelpText="历史版本日期范围和可见数量"/>
                                        <Border x:Name="SaveDetailsStaleBanner" Padding="8" Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource GscDiagnosticHintBubble}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SaveDetailsStaleVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SaveDetailsStateDetail}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding LoadDetailsCommand}" Content="重试" Margin="8,0,0,0" AutomationProperties.Name="重试读取存档列表"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="SaveBackupPreviewCard" Padding="8" Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource GscDiagnosticHintBubble}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackupPreview.State}" Value="Loading"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupPreview.State}" Value="Ready"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupPreview.State}" Value="NoData"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupPreview.State}" Value="Unavailable"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupPreview.State}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="备份前变更摘要" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding BackupPreview.StateDisplay, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}"/></Grid>
                                                <TextBlock Text="{Binding BackupPreview.Summary, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding BackupPreview.PathSummaryDisplay, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding BackupPreview.IdentifiedPathsDisplay, Mode=OneWay}" Style="{StaticResource GscPathText}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="{Binding BackupPreview.IdentifiedPathsDisplay, Mode=OneWay}"/>
                                                <TextBlock Text="预览不产生归档；“立即备份”执行前会重新扫描，不使用过期预览保证安全。" Style="{DynamicResource GscCaptionStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="SaveBackupResultCard" Padding="8" Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource GscDiagnosticHintBubble}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackupResult.HasResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="本次备份结果" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding BackupResult.StateDisplay, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap"/></Grid>
                                                <TextBlock Text="{Binding BackupResult.Summary, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding BackupResult.RemediationDisplay, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <ui:Button Margin="0,7,0,0" Content="单独重试云端上传" Command="{Binding RetrySelectedGameCloudUploadCommand}" ToolTip="只重试已保留本地版本的云端上传，不重新创建本地备份" AutomationProperties.Name="单独重试当前游戏云端上传">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource GscWpfUiCompactButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BackupResult.CanRetryCloudUpload}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <WrapPanel x:Name="SaveHistorySummaryActions" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Appearance="Primary" Command="{Binding DetectPathsCommand}" MinWidth="100" Margin="0,0,8,0" AutomationProperties.Name="立即扫描存档路径">
                                            <StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscActionIcon}" IconData="{StaticResource GscIconActionBrowseFolder}"/><TextBlock Text="立即扫描" VerticalAlignment="Center"/></StackPanel>
                                        </ui:Button>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding PreviewBackupCommand}" MinWidth="100" Margin="0,0,8,0" ToolTip="只扫描当前游戏本次备份范围，不创建归档" AutomationProperties.Name="预览当前游戏备份范围">
                                            <StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscActionIcon}" IconData="{StaticResource GscIconActionVerify}"/><TextBlock Text="预览备份" VerticalAlignment="Center"/></StackPanel>
                                        </ui:Button>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding ValidateCommand}" MinWidth="100" Margin="0,0,8,0" AutomationProperties.Name="重新校验存档路径">
                                            <StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscActionIcon}" IconData="{StaticResource GscIconActionVerify}"/><TextBlock Text="重新校验" VerticalAlignment="Center"/></StackPanel>
                                        </ui:Button>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding LoadDetailsCommand}" MinWidth="100" AutomationProperties.Name="重新加载存档详情" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscActionIcon}" IconData="{StaticResource GscIconActionRefresh}"/><TextBlock Text="重新加载详情" VerticalAlignment="Center"/></StackPanel>
                                        </ui:Button>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="历史范围" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ComboBox Style="{DynamicResource GscWpfUiFilterComboBox}" ItemsSource="{Binding BackupHistoryRangeOptions}" SelectedItem="{Binding BackupHistoryRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="108" ToolTip="按本地日历日期筛选历史版本；今天/昨天不按固定 24 小时计算。" AutomationProperties.Name="历史版本日期范围"/>
                                        </StackPanel>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Content="清空范围" Command="{Binding ClearBackupHistoryRangeCommand}" Margin="0,0,8,0" ToolTip="恢复显示全部历史版本" AutomationProperties.Name="清空历史版本日期范围"/>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Content="最近版本" Command="{Binding JumpToRecentBackupCommand}" Margin="0,0,8,0" ToolTip="选择当前日期范围内最新的版本" AutomationProperties.Name="跳到最近历史版本"/>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Content="较早版本" Command="{Binding JumpToEarlierBackupCommand}" Margin="0,0,8,0" ToolTip="选择当前已载入日期范围内最早的版本" AutomationProperties.Name="跳到较早历史版本"/>
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Content="加载更早版本" Command="{Binding LoadMoreBackupHistoryCommand}" Margin="0,0,8,0" ToolTip="按创建时间继续载入下一段历史；已选版本会保持不变。" AutomationProperties.Name="加载更早的备份历史" AutomationProperties.HelpText="{Binding BackupHistoryRangeSummary, Mode=OneWay}"/>
                                        <ui:Button x:Name="SaveHistoryColumnVisibilityButton" Style="{DynamicResource GscWpfUiCompactButton}" Content="显示列" ToolTip="选择存档历史表格显示的列；时间、类型和状态始终显示。" AutomationProperties.Name="设置存档历史表格显示列"/>
                                        <ComboBox x:Name="SaveHistoryViewConfigurationComboBox" Width="132" Style="{DynamicResource GscWpfUiFilterComboBox}" ToolTip="选择默认或已保存的存档历史表格布局" AutomationProperties.Name="存档历史表格视图"/>
                                        <Expander x:Name="SaveHistoryViewConfigurationExpander" Style="{StaticResource GscDisclosureCard}" Header="管理视图" IsExpanded="False" MaxWidth="{Binding ActualWidth, ElementName=SaveHistoryTableFrame}" AutomationProperties.Name="存档历史视图管理" AutomationProperties.HelpText="展开后可保存、复制、重命名或删除表格视图；不更改存档数据。">
                                            <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                                                <TextBox x:Name="SaveHistoryViewConfigurationNameBox" Width="110" MaxLength="48" Style="{DynamicResource GscWpfUiTextBox}" ToolTip="输入视图名称，最多 48 个字符" AutomationProperties.Name="存档历史视图名称" Margin="0,0,8,4"/>
                                                <ui:Button x:Name="SaveHistoryViewConfigurationSaveButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="保存当前" AutomationProperties.Name="保存当前存档历史视图" Margin="0,0,8,4"/>
                                                <ui:Button x:Name="SaveHistoryViewConfigurationCopyButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="另存副本" AutomationProperties.Name="另存存档历史视图副本" Margin="0,0,8,4"/>
                                                <ui:Button x:Name="SaveHistoryViewConfigurationRenameButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="重命名" AutomationProperties.Name="重命名存档历史视图" Margin="0,0,8,4"/>
                                                <ui:Button x:Name="SaveHistoryViewConfigurationDeleteButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="删除" AutomationProperties.Name="删除存档历史视图" Margin="0,0,8,4"/>
                                                <TextBlock x:Name="SaveHistoryViewConfigurationDirtyStatusText" Text="" Style="{DynamicResource GscCaptionStyle}" Visibility="Collapsed" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="存档历史视图保存状态"/>
                                                <ui:Button x:Name="SaveHistoryViewConfigurationRestoreButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="恢复已保存" ToolTip="放弃临时视图改动并恢复已保存排列；不更改业务配置" AutomationProperties.Name="恢复已保存存档历史视图" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,4"/>
                                                <ui:Button x:Name="SaveHistoryViewConfigurationResetButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="重置…" ToolTip="先预览范围，再选择只重置存档历史或全部工作视图" AutomationProperties.Name="预览存档历史布局重置范围" Margin="0,0,8,4"/>
                                            </WrapPanel>
                                        </Expander>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="SaveHistoryGrid" AutomationProperties.Name="存档历史" Grid.Row="1" Style="{StaticResource SaveDataGrid}" RowStyle="{StaticResource GscStableDataGridRow}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" SelectionMode="Extended" SelectionChanged="OnSaveHistorySelectionChanged" infra:DataGridClipboardBehavior.Enabled="True" infra:DataGridClipboardBehavior.Profile="SaveHistory" ToolTip="Ctrl+C 复制所选行；Ctrl+Shift+C 复制当前单元格" AutomationProperties.HelpText="Ctrl+C 复制所选存档行；Ctrl+Shift+C 复制当前单元格">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="SaveHistoryTimeColumn" HeaderStyle="{StaticResource SaveFirstHeader}" Header="时间" infra:DataGridColumnHeaderHelpBehavior.Description="相对时间；悬停可查看本地时区、完整秒级时间和原始 UTC 值。" Binding="{Binding CreatedRelativeDisplay, Mode=OneWay}" Width="110" MinWidth="104"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveHistoryTimeText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTemplateColumn x:Name="SaveHistoryTypeColumn" Header="类型" Width="124" MinWidth="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource GscRedesignTableStatusPill}" BorderBrush="{DynamicResource GscAccentTintStrongBrush}">
                                                <TextBlock Text="{Binding BackupTypeDisplay, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="{DynamicResource GscCaptionFontSize}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="SaveHistoryFileCountColumn" Header="文件数" infra:DataGridColumnHeaderHelpBehavior.Description="文件数量；单位为个。" Binding="{Binding FileCount, Mode=OneWay}" Width="82" MinWidth="56"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveCountValue}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn x:Name="SaveHistorySizeColumn" Header="大小" infra:DataGridColumnHeaderHelpBehavior.Description="总大小；按 1024 进制显示 B、KiB、MiB 或 GiB。" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="116" MinWidth="78"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveSizeValue}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn x:Name="SaveHistoryDeviceColumn" Header="设备" Binding="{Binding SourceDisplay, Mode=OneWay}" Width="120" MinWidth="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn x:Name="SaveHistoryNoteColumn" HeaderStyle="{StaticResource SaveLastHeader}" Header="备注" Binding="{Binding Comment, Mode=OneWay}" Width="*" MinWidth="116">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn x:Name="SaveHistoryStateColumn" Header="状态" infra:DataGridColumnHeaderHelpBehavior.Description="锁定状态与恢复可用性；未验证不表示安全。" Width="106" MinWidth="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="{StaticResource GscHairlineThickness}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                                                        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RestoreReadiness.Status, Mode=OneWay}" Value="Ready">
                                                                <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
