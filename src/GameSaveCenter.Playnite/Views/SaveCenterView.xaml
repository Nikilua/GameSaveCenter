<UserControl x:Class="GameSaveCenter.Playnite.Views.SaveCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             Foreground="{DynamicResource GscPrimaryTextBrush}" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SaveDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/><Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/><Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/><Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserSortColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/></Style>
            <Style x:Key="SaveTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="SaveLongText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
            <Style x:Key="SaveHealthStateBadge" TargetType="Border" BasedOn="{StaticResource GscRedesignContextPill}">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Healthy">
                        <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Ready">
                        <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Risk">
                        <Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Warning">
                        <Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Attention">
                        <Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Running">
                        <Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SaveHealthStateText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Healthy">
                        <Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Ready">
                        <Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Risk">
                        <Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Warning">
                        <Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Attention">
                        <Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Running">
                        <Setter Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SaveFirstHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="SaveLastHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="SaveTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="SaveTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TabControl Grid.Row="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource SaveTabControl}"><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource SaveTabItem}"/></TabControl.Resources>
            <TabItem Header="历史版本">
                <Grid x:Name="SaveHistoryLayout" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource SaveTableFrame}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="SaveHistoryGrid" Style="{StaticResource SaveDataGrid}" RowStyle="{StaticResource GscStableDataGridRow}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" SelectionChanged="OnSaveHistorySelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn HeaderStyle="{StaticResource SaveFirstHeader}" Header="时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTemplateColumn Header="类型" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource GscRedesignTableStatusPill}" BorderBrush="{DynamicResource GscAccentTintStrongBrush}">
                                                <TextBlock Text="{Binding BackupTypeDisplay, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount, Mode=OneWay}" Width="82"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="90"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn Header="设备" Binding="{Binding SourceDevice, Mode=OneWay}" Width="120"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn x:Name="SaveHistoryNoteColumn" Header="备注" Binding="{Binding Comment, Mode=OneWay}" Width="*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn HeaderStyle="{StaticResource SaveLastHeader}" Header="状态" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                                                        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked, Mode=OneWay}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LockStateDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="暂无存档历史&#xA;完成一次备份后，历史版本会显示在这里。" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Backups.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaveHistoryLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:WorkspaceStatePresenter State="Loading" Title="正在读取存档历史" Message="Worker 正在读取当前游戏的历史版本。" IsHitTestVisible="False">
                                <ui:WorkspaceStatePresenter.Style>
                                    <Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaveHistoryLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:WorkspaceStatePresenter.Style>
                            </ui:WorkspaceStatePresenter>
                            <ui:Button x:Name="SaveHistoryCompactDetailsButton"
                                       Grid.Row="1"
                                       Style="{DynamicResource GscWpfUiSecondaryButton}"
                                       Content="查看版本详情 ›"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,8,8,0"
                                       Visibility="Collapsed"
                                       Click="OnSaveHistoryCompactDetailsClick"
                                       AutomationProperties.Name="查看或收起所选版本详情"/>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="SaveHistoryActionsScrollViewer" Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource GscInspectorScrollViewer}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedBackup}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Border Style="{DynamicResource GscReadingCardStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="版本详情" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <TextBlock Text="{Binding SelectedBackup.BackupId, TargetNullValue=选择一个存档版本查看详情}" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedBackup.BackupId}"/>
                                <Separator Margin="0,14,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="创建时间" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Grid.Column="1" Text="{Binding SelectedBackup.CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="触发方式" Style="{DynamicResource GscCaptionStyle}" Margin="0,9,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBackup.BackupTypeDisplay, Mode=OneWay}" Margin="0,9,0,0"/>
                                    <TextBlock Grid.Row="2" Text="文件数量" Style="{DynamicResource GscCaptionStyle}" Margin="0,9,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBackup.FileCount, Mode=OneWay}" Margin="0,9,0,0"/>
                                    <TextBlock Grid.Row="3" Text="大小" Style="{DynamicResource GscCaptionStyle}" Margin="0,9,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedBackup.SizeDisplay, Mode=OneWay}" Margin="0,9,0,0"/>
                                    <TextBlock Grid.Row="4" Text="设备" Style="{DynamicResource GscCaptionStyle}" Margin="0,9,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedBackup.SourceDevice, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" ToolTip="{Binding SelectedBackup.SourceDevice}"/>
                                </Grid>
                                <TextBlock Text="版本备注" Style="{DynamicResource GscCaptionStyle}" Margin="0,16,0,6"/>
                                <TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding BackupComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="锁定版本" FontWeight="SemiBold"/><TextBlock Text="保留策略不会清理锁定版本" Style="{DynamicResource GscCaptionStyle}" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="1" Style="{DynamicResource GscCheckBox}" Content="锁定" IsChecked="{Binding LockSelectedBackup}" VerticalAlignment="Center"/></Grid>
                                <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding UpdateBackupMetadataCommand}" Content="保存备注与锁定" Margin="0,16,0,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding CompareBackupCommand}" Content="与上一版本比较" Margin="0,8,0,0"/>
                                <Separator Margin="0,16,0,12"/>
                                <TextBlock Text="恢复可用性" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedBackup.RestoreReadinessStatusDisplay, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SelectedBackup.RestoreReadinessSummaryDisplay, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SelectedBackup.RestoreReadinessMetricsDisplay, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding ValidateRestoreReadinessCommand}" Content="验证可恢复性" Margin="0,10,0,0"/>
                                <Separator Margin="0,16,0,12"/>
                                <TextBlock Text="恢复操作" FontWeight="SemiBold"/>
                                <TextBlock Text="恢复前会创建并锁定当前快照，完成后可校验并撤销。" Style="{DynamicResource GscCaptionStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding RestoreCommand}" Content="安全恢复" Margin="0,12,0,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding UndoRestoreCommand}" Content="撤销最近恢复" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="路径与校验">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="SaveCurrentRuleCard" Grid.Row="0" Style="{DynamicResource GscReadingCardStyle}" Padding="12,10" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="SaveCurrentRuleActionsRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition x:Name="SaveCurrentRuleStatusColumn" Width="Auto"/>
                                <ColumnDefinition x:Name="SaveCurrentRuleActionsColumn" Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource GscSelectedGameIconControl}" Content="{Binding SelectedGameIcon}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="当前存档规则" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <TextBlock Text="{Binding SelectedGame.LudusaviName, Mode=OneWay, TargetNullValue=尚未匹配 Ludusavi 规则}" Style="{DynamicResource GscBodyStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.LudusaviName}"/>
                                <TextBlock Style="{DynamicResource GscCaptionStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.HealthReasonDisplay, Mode=OneWay}"><Run Text="{Binding SelectedGame.MatchStateDisplay, Mode=OneWay, TargetNullValue=未匹配}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay, TargetNullValue=尚未校验}"/></TextBlock>
                            </StackPanel>
                            <Border x:Name="SaveHealthBadge" Grid.Column="2" Style="{StaticResource SaveHealthStateBadge}" Margin="14,0,0,0" ToolTip="{Binding SelectedGame.HealthReasonDisplay, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SaveHealthStateText}" HorizontalAlignment="Center"><Run Text="校验状态："/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay, TargetNullValue=尚未校验}" FontWeight="SemiBold"/></TextBlock>
                            </Border>
                            <WrapPanel x:Name="SaveCurrentRuleActions" Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ui:Button x:Name="SaveDetectPathsButton" Style="{DynamicResource GscWpfUiCompactButton}" Appearance="Primary" Command="{Binding DetectPathsCommand}" Content="立即扫描" MinHeight="38" MinWidth="100" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:Button x:Name="SaveValidateButton" Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding ValidateCommand}" Content="重新校验" MinHeight="38" MinWidth="100" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:Button x:Name="SaveLoadDetailsButton" Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding LoadDetailsCommand}" Content="刷新详情" MinHeight="38" MinWidth="100" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Grid x:Name="SaveCandidateLayout" Grid.Row="2" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource SaveTableFrame}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="SaveCandidateGrid" Style="{StaticResource SaveDataGrid}" ItemsSource="{Binding SaveCandidates}" SelectedItem="{Binding SelectedCandidate}" SelectionChanged="OnSaveCandidateSelectionChanged"><DataGrid.Columns><DataGridTemplateColumn HeaderStyle="{StaticResource SaveFirstHeader}" Header="可信度" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="0,0,8,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="60"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding Score, Mode=OneWay}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Score, Mode=OneWay, StringFormat=P0}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="90"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="路径" Binding="{Binding Path, Mode=OneWay}" Width="*" MinWidth="300"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{StaticResource SaveLastHeader}" Header="依据" Binding="{Binding ReasonsDisplay, Mode=OneWay}" Width="1.2*" MinWidth="250"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><TextBlock Text="暂无待处理的存档路径候选&#xA;可以点击“立即扫描”重新检测候选目录。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SaveCandidates.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ui:Button x:Name="SaveCandidateCompactDetailsButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="查看候选详情 ›" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,8,0" Visibility="Collapsed" Click="OnSaveCandidateCompactDetailsClick" AutomationProperties.Name="查看或收起所选候选详情"/></Grid></Border>
                <ScrollViewer x:Name="SaveCandidateInspectorScrollViewer" Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource GscInspectorScrollViewer}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCandidate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Style="{DynamicResource GscReadingCardStyle}" Padding="16"><StackPanel><TextBlock Text="判断依据" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="{Binding SelectedCandidate.Path, TargetNullValue=选择候选路径后查看详情}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedCandidate.Path}" Margin="0,4,0,0"/><Separator Margin="0,12,0,10"/><TextBlock Text="{Binding SelectedCandidate.ReasonsDisplay, TargetNullValue=暂无判断依据}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}"/><Separator Margin="0,14,0,12"/><TextBlock Text="操作" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding DetectPathsCommand}" Content="立即扫描" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding AcceptCandidateCommand}" Content="接受并生成规则草案" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding RejectCandidateCommand}" Content="忽略候选" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
                </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="备份策略">
                <ScrollViewer Style="{DynamicResource GscPageScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel x:Name="SavePolicyStack" MaxWidth="{StaticResource GscFormMaxWidth}" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前游戏自动策略" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="存档与媒体自动化可以按当前游戏独立关闭；手动备份、恢复和媒体同步仍可使用。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SavePolicyCommand}" Content="保存策略"/></Grid>
                        <Expander Style="{StaticResource GscDisclosureCard}" Header="策略模板 · 新建 / 保存 / 应用 / 删除" IsExpanded="False" Margin="0,0,0,14">
                        <Border x:Name="SavePolicyTemplatesCard" Style="{DynamicResource GscReadingCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="策略模板" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <TextBlock Text="模板是可复用的策略快照。先保存修改，再明确应用到当前游戏；应用后不会建立实时继承关系。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="选择模板" Style="{DynamicResource GscCaptionStyle}" Margin="0,0,0,5"/>
                                        <ComboBox Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding PolicyTemplates}" SelectedItem="{Binding SelectedPolicyTemplate}" ToolTip="内置模板不可直接修改；新建副本后可编辑">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="模板名称" Style="{DynamicResource GscCaptionStyle}" Margin="0,0,0,5"/>
                                        <TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding PolicyTemplateNameDraft, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPolicyTemplate}" MaxLength="80" ToolTip="用户模板名称，最多 80 个字符"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{DynamicResource GscRedesignSubCard}" Padding="12" Margin="0,12,0,0">
                                    <StackPanel IsEnabled="{Binding CanEditPolicyTemplate}">
                                        <TextBlock Text="模板参数" Style="{DynamicResource GscCaptionStyle}" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="启用自动任务" IsChecked="{Binding PolicyTemplateDraft.Policy.Enabled}" Margin="0,0,18,8"/>
                                            <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="退出后备份" IsChecked="{Binding PolicyTemplateDraft.Policy.BackupOnGameStop}" Margin="0,0,18,8"/>
                                            <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="游玩中周期备份" IsChecked="{Binding PolicyTemplateDraft.Policy.BackupDuringPlay}" Margin="0,0,18,8"/>
                                            <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="上传备份到云端" IsChecked="{Binding PolicyTemplateDraft.Policy.UploadAfterBackup}" Margin="0,0,18,8"/>
                                            <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="游玩中同步媒体" IsChecked="{Binding PolicyTemplateDraft.Policy.SyncMediaDuringPlay}" Margin="0,0,18,8"/>
                                            <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="退出后同步媒体" IsChecked="{Binding PolicyTemplateDraft.Policy.SyncMediaOnGameStop}" Margin="0,0,18,8"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Width="280" Margin="0,0,18,14">
                                                <TextBlock Text="游玩中周期备份间隔" Style="{StaticResource GscFormFieldLabel}"/>
                                                <StackPanel Orientation="Horizontal"><TextBox VerticalAlignment="Center" Style="{StaticResource GscNumericFieldInput}" Text="{Binding PolicyTemplateDraft.Policy.DuringPlayIntervalMinutes, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="模板游玩中周期备份间隔，分钟" ToolTip="周期备份间隔，允许 1–1440 分钟"/><TextBlock Text="分钟" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock Text="允许 1–1440；游戏运行期间按此间隔自动创建备份。" Style="{DynamicResource GscFormFieldHelper}"/>
                                            </StackPanel>
                                            <StackPanel Width="280" Margin="0,0,18,14">
                                                <TextBlock Text="最近版本保留小时" Style="{StaticResource GscFormFieldLabel}"/>
                                                <StackPanel Orientation="Horizontal"><TextBox VerticalAlignment="Center" Style="{StaticResource GscNumericFieldInput}" Text="{Binding PolicyTemplateDraft.Policy.KeepRecentAllHours, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="模板最近版本保留小时" ToolTip="最近版本保留小时数"/><TextBlock Text="小时" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock Text="最近创建的全量备份在该时间窗内优先保留。" Style="{DynamicResource GscFormFieldHelper}"/>
                                            </StackPanel>
                                            <StackPanel Width="280" Margin="0,0,18,14">
                                                <TextBlock Text="每日保留天数" Style="{StaticResource GscFormFieldLabel}"/>
                                                <StackPanel Orientation="Horizontal"><TextBox VerticalAlignment="Center" Style="{StaticResource GscNumericFieldInput}" Text="{Binding PolicyTemplateDraft.Policy.KeepDailyDays, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="模板每日保留天数" ToolTip="每日版本保留天数"/><TextBlock Text="天" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock Text="保留策略按日归档清理时使用的天数窗口。" Style="{DynamicResource GscFormFieldHelper}"/>
                                            </StackPanel>
                                            <StackPanel Width="280" Margin="0,0,0,14">
                                                <TextBlock Text="每周保留周数" Style="{StaticResource GscFormFieldLabel}"/>
                                                <StackPanel Orientation="Horizontal"><TextBox VerticalAlignment="Center" Style="{StaticResource GscNumericFieldInput}" Text="{Binding PolicyTemplateDraft.Policy.KeepWeeklyWeeks, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="模板每周保留周数" ToolTip="每周版本保留周数"/><TextBlock Text="周" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock Text="保留策略按周归档清理时使用的周数窗口。" Style="{DynamicResource GscFormFieldHelper}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="自动恢复不属于模板可编辑项，始终保持关闭。" Style="{DynamicResource GscCaptionStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="异常保护" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Width="180" Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding BackupAnomalyProtectionOptions}" SelectedValuePath="Value" SelectedValue="{Binding PolicyTemplateDraft.Policy.AnomalyProtectionLevel}" AutomationProperties.Name="模板备份异常保护等级"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding CreatePolicyTemplateCommand}" Content="新建模板副本" Margin="0,0,8,8"/>
                                    <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SavePolicyTemplateCommand}" Content="保存模板" Margin="0,0,8,8"/>
                                    <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding ApplyPolicyTemplateCommand}" Content="应用到当前游戏" Margin="0,0,8,8"/>
                                    <ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DeletePolicyTemplateCommand}" Content="删除自定义模板" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        </Expander>
                        <Grid x:Name="SavePolicyCardsLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                            <Border x:Name="SaveBackupAutomationCard" Grid.Column="0" Style="{DynamicResource GscReadingCardStyle}" Padding="18"><StackPanel><TextBlock Text="备份自动化" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="与存档版本有关的开关放在同一张阅读卡中。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,10"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="启用当前游戏自动任务" IsChecked="{Binding SelectedGame.Policy.Enabled}" Margin="0,0,0,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="退出游戏后备份" IsChecked="{Binding SelectedGame.Policy.BackupOnGameStop}" Margin="0,0,0,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="游玩中周期备份" IsChecked="{Binding SelectedGame.Policy.BackupDuringPlay}" Margin="0,0,0,8"/><Border Style="{DynamicResource GscRedesignSubCard}" Padding="12" Margin="24,10,0,0"><StackPanel><TextBlock Text="游玩中周期备份间隔" Style="{StaticResource GscFormFieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource GscNumericFieldInput}" Text="{Binding SelectedGame.Policy.DuringPlayIntervalMinutes, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="游玩中周期备份间隔，分钟" ToolTip="允许 1–1440 分钟"/><TextBlock Grid.Column="1" Text="分钟" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock Grid.Column="2" Text="允许 1–1440" Style="{DynamicResource GscFormFieldHelper}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><TextBlock Text="在游戏运行期间，按该间隔自动创建备份；仅在启用“游玩中周期备份”后生效。" Style="{DynamicResource GscFormFieldHelper}"/></StackPanel></Border><StackPanel Margin="0,10,0,0"><TextBlock Text="异常保护" Style="{StaticResource GscFormFieldLabel}"/><StackPanel Orientation="Horizontal"><ComboBox Width="180" Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding BackupAnomalyProtectionOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedGame.Policy.AnomalyProtectionLevel}" AutomationProperties.Name="当前游戏备份异常保护等级"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><TextBlock Text="云端上传、完整性异常或依赖不可用时的保护级别；不会改变本地备份主副本语义。" Style="{DynamicResource GscFormFieldHelper}"/></StackPanel></StackPanel></Border>
                            <Border x:Name="SavePolicyMediaCard" Grid.Column="2" Style="{DynamicResource GscReadingCardStyle}" Padding="18"><StackPanel><TextBlock Text="媒体与云端" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="与当前游戏关联的媒体归档和单向云端复制策略。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,10"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="上传备份到云端" IsChecked="{Binding SelectedGame.Policy.UploadAfterBackup}" Margin="0,0,0,8"/><Border Style="{DynamicResource GscRedesignInfoBand}" Padding="12" Margin="0,8,0,0"><TextBlock Text="云端失败不会撤销本地成功的备份；重试和完整错误统一进入任务中心。" Foreground="{DynamicResource GscInfoBrush}" TextWrapping="Wrap"/></Border><TextBlock Text="{Binding RetentionSummary, TargetNullValue=保留策略尚未生成}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding PreviewRetentionCommand}" Content="预览保留策略" Margin="0,12,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
                            <Border x:Name="SavePolicySafetyCard" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Style="{DynamicResource GscReadingCardStyle}" Padding="16" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GscWarningIconFillBrush}"><TextBlock Text="!" Foreground="{DynamicResource GscWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="安全边界" FontWeight="SemiBold"/><TextBlock Text="自动恢复始终关闭。恢复会先创建并锁定当前快照，再执行恢复后校验和可撤销快照。" Style="{DynamicResource GscBodyStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="比较与保留">
                <Grid x:Name="SaveCompareLayout" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource GscReadingCardStyle}" Padding="18">
                        <ScrollViewer x:Name="SaveCompareMainScrollViewer" Style="{DynamicResource GscInspectorScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="版本比较" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="当前选中版本与上一版本的只读文件清单差异。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                    <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding CompareBackupCommand}" Content="比较所选版本"/>
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,16,0,0">
                                    <Border Style="{DynamicResource GscRedesignSubCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="新增文件" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding LastBackupDiff.Added.Count, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                    <Border Style="{DynamicResource GscRedesignSubCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="修改文件" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding LastBackupDiff.Modified.Count, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                    <Border Style="{DynamicResource GscRedesignSubCard}"><StackPanel><TextBlock Text="删除文件" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding LastBackupDiff.Removed.Count, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                </UniformGrid>
                                <Border Style="{DynamicResource GscRedesignInfoBand}" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock Text="{Binding DiffSummary, TargetNullValue=尚未比较版本。选择历史版本后点击“比较所选版本”。}" TextWrapping="Wrap" Foreground="{DynamicResource GscInfoBrush}"/><TextBlock Text="{Binding LastBackupDiff.ComparisonQualityDisplay, TargetNullValue=尚未计算比较精度。}" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0"/></StackPanel></Border>
                                <TextBlock Text="变更文件" Style="{DynamicResource GscSectionTitleStyle}" Margin="0,18,0,8"/>
                                <ItemsControl ItemsSource="{Binding LastBackupDiff.Added}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="＋ 新增" Foreground="{DynamicResource GscSuccessBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding LastBackupDiff.Modified}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="≈ 修改" Foreground="{DynamicResource GscAccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding LastBackupDiff.Removed}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="－ 删除" Foreground="{DynamicResource GscMutedTextBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="变更清单会在比较完成后显示；未执行比较时不会猜测文件状态。" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer x:Name="SaveCompareRetentionScrollViewer" Grid.Column="2" Style="{DynamicResource GscInspectorScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{DynamicResource GscReadingCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="保留策略预览" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <TextBlock Text="只读预览，不执行不安全的单版本删除。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Separator Margin="0,14,0,12"/>
                                <TextBlock Text="{Binding RetentionSummary, TargetNullValue=尚未生成保留预览。}" Style="{DynamicResource GscBodyStyle}" TextWrapping="Wrap"/>
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="预计保留版本" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Grid.Column="1" Text="{Binding LastRetentionPreview.KeepBackupIds.Count, TargetNullValue=—}" FontWeight="SemiBold"/></Grid>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="候选清理" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Grid.Column="1" Text="{Binding LastRetentionPreview.DeleteCandidateIds.Count, TargetNullValue=—}" FontWeight="SemiBold"/></Grid>
                                <Border Style="{DynamicResource GscRedesignInfoBand}" Padding="10" Margin="0,16,0,0"><TextBlock Text="锁定版本和已验证的健康恢复点永远不会进入候选清理。预览结果只供确认，不会自动删除文件。" Foreground="{DynamicResource GscInfoBrush}" TextWrapping="Wrap"/></Border>
                                <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding PreviewRetentionCommand}" Content="刷新保留预览" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
