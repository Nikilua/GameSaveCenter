<UserControl x:Class="GameSaveCenter.Playnite.Views.NotificationInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="NotificationDataGrid" TargetType="DataGrid" BasedOn="{StaticResource GscRedesignWorkspaceDataGrid}">
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="NotificationSeverityPill" TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource GscWarningIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Success"><Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Information"><Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NotificationSurface" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="NotificationInboxLayout" ClipToBounds="True">
        <ui:AmbientMaterialLayer Panel.ZIndex="-1"/>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource GscRedesignSectionCard}" Padding="18,8" Margin="0,0,0,8" MinHeight="68">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding NotificationUnreadCount, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource GscAccentBrush}"/>
                        <TextBlock Text="未读通知" FontSize="{DynamicResource GscCaptionFontSize}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="通知记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding NotificationInboxCountSummary, Mode=OneWay}" FontSize="{DynamicResource GscCaptionFontSize}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{DynamicResource GscRedesignSectionCard}" Padding="10,8" Margin="0,0,0,8">
                <Grid x:Name="NotificationFilterGrid">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="NotificationInboxSearchHost" Grid.Row="0" Grid.Column="0" MinWidth="160" Margin="0,0,10,0">
                        <TextBox x:Name="NotificationInboxSearchTextBox" Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding NotificationInboxSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索通知标题、摘要或关联 ID" AutomationProperties.Name="搜索通知" Padding="30,7,10,7"/>
                        <TextBlock Text="搜索通知…" VerticalAlignment="Center" Margin="30,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource GscMutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GscCaptionStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NotificationInboxSearchTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="NotificationSeverityFilterComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" Style="{DynamicResource GscWpfUiFilterComboBox}" ItemsSource="{Binding NotificationSeverityOptions}" SelectedItem="{Binding NotificationSeverityFilter, Mode=TwoWay}" ToolTip="按通知级别筛选" AutomationProperties.Name="通知级别"/>
                    <ComboBox x:Name="NotificationTimeFilterComboBox" Grid.Row="0" Grid.Column="2" Margin="0,0,8,0" Style="{DynamicResource GscWpfUiFilterComboBox}" ItemsSource="{Binding NotificationTimeOptions}" SelectedItem="{Binding NotificationTimeFilter, Mode=TwoWay}" ToolTip="按通知时间筛选" AutomationProperties.Name="通知时间"/>
                    <ui:Button x:Name="NotificationInboxRefreshButton" Grid.Row="0" Grid.Column="3" Content="刷新" Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding RefreshNotificationInboxCommand}" AutomationProperties.Name="刷新通知收件箱" Padding="14,7"/>
                    <ui:Button x:Name="NotificationCompactDetailsButton" Grid.Row="0" Grid.Column="4" Content="查看详情" Style="{DynamicResource GscWpfUiContextButton}" Click="OnCompactDetailsClick" AutomationProperties.Name="查看所选通知详情" Padding="12,7" Visibility="Collapsed"/>
                    <WrapPanel x:Name="NotificationReadActions" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,4,0,0">
                        <ui:Button x:Name="NotificationMarkSelectedReadButton" Content="标记所选已读" Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding MarkSelectedNotificationReadCommand}" AutomationProperties.Name="标记所选通知为已读" AutomationProperties.HelpText="只更新所选通知的已读状态，不会解决或关闭关联问题。" Padding="12,5" Margin="0,0,8,0"/>
                        <ui:Button x:Name="NotificationMarkVisibleReadButton" Content="筛选结果全部已读" Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding MarkVisibleNotificationsReadCommand}" ToolTip="只标记当前筛选结果中的未读通知" AutomationProperties.Name="将当前筛选结果中的未读通知全部标为已读" AutomationProperties.HelpText="只更新当前筛选结果中的未读通知；被筛除的通知保持原状态。" Padding="12,5" Margin="0,0,8,0"/>
                        <ui:Button x:Name="NotificationClearReadButton" Content="清除已读记录" Style="{DynamicResource GscWpfUiContextDangerButton}" Command="{Binding ClearReadNotificationRecordsCommand}" ToolTip="只删除已读通知记录" AutomationProperties.Name="清除已读通知记录" AutomationProperties.HelpText="清除前会要求确认；不会删除任务、审计日志或恢复证据。" Padding="12,5"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Visibility="{Binding HasNotificationInboxError, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{DynamicResource GscRedesignSectionCard}" Padding="10,7" Margin="0,0,0,8" BorderBrush="{DynamicResource GscErrorBrush}">
                <TextBlock Text="{Binding NotificationInboxErrorMessage, Mode=OneWay}" Foreground="{DynamicResource GscErrorBrush}" TextWrapping="Wrap"/>
            </Border>

            <Grid x:Name="NotificationResultsLayout" Grid.Row="3" ClipToBounds="True">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="NotificationListColumn" Width="*"/><ColumnDefinition x:Name="NotificationInspectorGap" Width="14"/><ColumnDefinition x:Name="NotificationInspectorColumn" Width="320"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="NotificationCompactInspectorRow" Height="0"/></Grid.RowDefinitions>
                <Border x:Name="NotificationTableFrame" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Style="{DynamicResource GscRedesignTableFrame}" Padding="5" ClipToBounds="True">
                    <DataGrid x:Name="NotificationGrid" Style="{StaticResource NotificationDataGrid}" ItemsSource="{Binding NotificationInboxItems}" SelectedItem="{Binding SelectedNotification, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="通知列表">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="级别" Width="88" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource NotificationSeverityPill}" HorizontalAlignment="Left" Padding="7,3"><TextBlock Text="{Binding SeverityDisplay}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="通知" Binding="{Binding Title}" Width="2*" MinWidth="160"/>
                            <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="3*" MinWidth="200"/>
                            <DataGridTextColumn Header="尝试" Binding="{Binding OccurrenceDisplay}" Width="68" MinWidth="64"/>
                            <DataGridTemplateColumn Header="问题" Width="76" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ResolvedDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="时间" Width="155" MinWidth="145">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CreatedRelativeDisplay, Mode=OneWay}" ToolTip="{Binding CreatedFullDisplay, Mode=OneWay}" AutomationProperties.HelpText="{Binding CreatedFullDisplay, Mode=OneWay}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="78" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ReadStateDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border x:Name="NotificationInspectorCard" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource NotificationSurface}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock Text="通知详情" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedNotification.SeverityDisplay, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ScrollViewer x:Name="NotificationDetailScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedNotification.Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedNotification.Summary, Mode=OneWay}" Margin="0,7,0,7" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap"/>
                                <StackPanel Visibility="{Binding SelectedNotification.HasIssue, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SelectedNotification.OccurrenceDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedNotification.ResolvedDisplay, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="首次发生" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedNotification.FirstOccurredFullDisplay, Mode=OneWay}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="最近发生" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedNotification.LastOccurredFullDisplay, Mode=OneWay}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="最后错误" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedNotification.LastError, Mode=OneWay, TargetNullValue=无}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="时间" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}"/>
                                <TextBlock Text="{Binding SelectedNotification.CreatedFullDisplay, Mode=OneWay}" AutomationProperties.HelpText="{Binding SelectedNotification.CreatedRawUtcDisplay, Mode=OneWay}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="游戏 ID" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}"/>
                                <TextBlock Text="{Binding SelectedNotification.GameId, Mode=OneWay, TargetNullValue=无}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="最近任务 ID" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}"/>
                                <TextBlock Text="{Binding SelectedNotification.TaskId, Mode=OneWay, TargetNullValue=无}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button x:Name="NotificationOpenGameButton" Content="打开关联游戏" Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding OpenSelectedNotificationGameCommand}" Visibility="{Binding HasSelectedNotificationGameId, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="打开通知关联游戏" AutomationProperties.HelpText="只按 Playnite 稳定游戏 ID 定位，不会按同名游戏猜测。" Padding="11,4" Margin="0,0,8,4"/>
                                    <ui:Button x:Name="NotificationOpenTaskButton" Content="打开最近任务" Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding OpenSelectedNotificationTaskCommand}" Visibility="{Binding HasSelectedNotificationTaskId, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="打开通知最近关联任务" AutomationProperties.HelpText="只按任务稳定 ID 查询；找不到时保留通知摘要并说明原因。" Padding="11,4" Margin="0,0,8,4"/>
                                    <ui:Button x:Name="NotificationOpenFirstTaskButton" Content="打开首次失败" Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding OpenSelectedNotificationFirstTaskCommand}" Visibility="{Binding HasSelectedNotificationFirstTaskId, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="打开通知首次失败任务" AutomationProperties.HelpText="归并通知保留首次任务入口；只按任务稳定 ID 查询。" Padding="11,4" Margin="0,0,8,4"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding NotificationContextMessage, Mode=OneWay}" Style="{StaticResource GscCaptionStyle}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource GscGlassFillBrush}" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Visibility="{Binding NotificationInboxHasNoRecords, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="还没有通知" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="任务完成、失败或退出摘要会出现在这里。" Margin="0,7,0,0" Foreground="{DynamicResource GscSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource GscGlassFillBrush}" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Visibility="{Binding NotificationInboxHasNoFilterResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="没有匹配的通知" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="调整级别、时间或搜索条件后重试。" Margin="0,7,0,0" Foreground="{DynamicResource GscSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Text="{Binding NotificationInboxLoadStatus, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Foreground="{DynamicResource GscSecondaryTextBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
