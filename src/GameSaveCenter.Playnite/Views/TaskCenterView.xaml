<UserControl x:Class="GameSaveCenter.Playnite.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GameSaveCenter.Playnite.Infrastructure"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="TaskLongTextCell" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="TaskTimeCell" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyTimeCell}">
                <Setter Property="ToolTip" Value="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
            </Style>
            <Style x:Key="TaskDataGrid" TargetType="DataGrid" BasedOn="{StaticResource GscRedesignWorkspaceDataGrid}">
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
            </Style>
            <Style x:Key="TaskCompactDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource GscStableDataGridRow}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>
            <Style x:Key="TaskTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="TaskFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter>
            </Style>
            <Style x:Key="TaskLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter>
            </Style>
            <!-- Metric cards follow the Demo's three-line reading rhythm and the shared
                 10-DIP gap; the queue owns the remaining finite viewport below. -->
            <Style x:Key="TaskInspectorStatusPill" TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Succeeded"><Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Failed"><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Running"><Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Cancelled"><Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TaskSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="TaskPageScrollSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
        <ui:AmbientMaterialLayer Panel.ZIndex="-1"/>
    <Grid x:Name="TaskWorkspaceLayout" Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="TaskSummaryPanel" Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="6,14" MinHeight="84" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="14,2,14,0">
                    <TextBlock Text="{Binding TaskTotalCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TaskTotalCountLabel, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource GscTableDividerBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4"/>
                <StackPanel Grid.Column="2" Margin="14,2,14,0">
                    <TextBlock Text="{Binding RunningTaskCount, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="运行中" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TaskWaitingSummaryText" Text="{Binding TaskWaitingSummary, Mode=OneWay}" Foreground="{DynamicResource GscMutedTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="14,2,14,0">
                    <TextBlock Text="{Binding RetryableTaskCount, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="当前结果可重试" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TaskRetrySummaryText" Text="{Binding TaskRetrySummary, Mode=OneWay}" Foreground="{DynamicResource GscMutedTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,2,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource GscTableDividerBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4"/>
                <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource GscTableDividerBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4"/>
                <StackPanel Grid.Column="6" Margin="14,2,14,0">
                    <TextBlock Text="{Binding CompletedTaskCount, Mode=OneWay}" Foreground="{DynamicResource GscSuccessBrush}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="今日完成" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Keep the Demo order: filter toolbar, optional game filter, then the
             queue card. Each row is measured independently so the table can never
             push the filters underneath itself. -->
        <Border x:Name="TaskFilterBar" Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="10,8" Margin="0,0,0,8">
            <Grid x:Name="TaskFiltersPanel" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The search hint belongs inside the field. Keeping the label as a
                     separate Auto column made the real host give the input only a
                     narrow sliver, while the Demo uses one continuous search field. -->
                <Grid x:Name="TaskSearchBoxHost" Grid.Row="0" Grid.Column="0" MinWidth="180" Margin="0,0,10,0">
                    <TextBox x:Name="TaskSearchTextBox" Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding TaskSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索任务、游戏或错误" AutomationProperties.Name="搜索任务" HorizontalAlignment="Stretch" Padding="30,7,38,7"/>
                    <ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconSearch}" Width="16" Height="16" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="搜索任务…" VerticalAlignment="Center" Margin="30,0,12,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GscCaptionStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TaskSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                            Tag="{Binding ElementName=TaskSearchTextBox}" ToolTip="清除搜索"
                            AutomationProperties.Name="清除任务搜索" Click="OnClearSearchTextBoxClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GscSearchClearButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TaskSearchTextBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=TaskSearchTextBox}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <TextBlock x:Name="TaskStatusFilterLabel" Grid.Row="0" Grid.Column="1" Text="状态：" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="TaskStatusFilterComboBox" Grid.Row="0" Grid.Column="2" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="112" MaxWidth="160" ItemsSource="{Binding TaskStatusFilterOptions}" SelectedItem="{Binding TaskStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="任务状态" Margin="0,0,10,0"/>
                <TextBlock x:Name="TaskTypeFilterLabel" Grid.Row="0" Grid.Column="3" Text="类型：" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="TaskTypeFilterComboBox" Grid.Row="0" Grid.Column="4" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="110" MaxWidth="180" ItemsSource="{Binding TaskTypeFilterOptions}" SelectedItem="{Binding TaskTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="任务类型" Margin="0,0,10,0"/>
                <ComboBox x:Name="TaskHistoryScopeComboBox" Grid.Row="0" Grid.Column="5" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="110" ItemsSource="{Binding TaskHistoryScopeOptions}" SelectedItem="{Binding TaskHistoryScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="任务范围" AutomationProperties.Name="任务范围" Margin="0,0,10,0"/>
                <ComboBox x:Name="TaskHistoryRangeComboBox" Grid.Row="0" Grid.Column="6" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="100" ItemsSource="{Binding TaskHistoryRangeOptions}" SelectedItem="{Binding TaskHistoryRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="时间范围" AutomationProperties.Name="任务时间范围" Margin="0,0,10,0"/>
                <!-- Icon-only: toolbar refresh remains discoverable by tooltip and UI Automation. -->
                <ui:Button x:Name="TaskRefreshButton" Grid.Row="0" Grid.Column="7" Style="{DynamicResource GscIconOnlyToolbarButton}" Command="{Binding RefreshCommand}" ToolTip="刷新任务列表" AutomationProperties.Name="刷新任务列表"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnRefresh}" Width="18" Height="18"/></ui:Button>
                <WrapPanel x:Name="TaskFilterPresetRow" Grid.Row="1" Grid.ColumnSpan="8" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="筛选预设" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TaskFilterPresetComboBox" Width="180" Style="{DynamicResource GscWpfUiFilterComboBox}" ItemsSource="{Binding TaskFilterPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTaskFilterPreset, Mode=TwoWay}" ToolTip="选择已保存的任务筛选组合" AutomationProperties.Name="任务筛选预设" Margin="0,0,8,0"/>
                    <ui:Button x:Name="TaskFilterPresetApplyButton" Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding ApplyTaskFilterPresetCommand}" Content="应用" ToolTip="应用选中的任务筛选预设" AutomationProperties.Name="应用任务筛选预设" Margin="0,0,8,0"/>
                    <TextBox x:Name="TaskFilterPresetNameBox" Width="132" Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding TaskFilterPresetNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入预设名称" AutomationProperties.Name="任务筛选预设名称" Margin="0,0,8,0"/>
                    <ui:Button Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding SaveTaskFilterPresetCommand}" Content="保存" ToolTip="保存当前任务筛选组合" AutomationProperties.Name="保存任务筛选预设" Margin="0,0,8,0"/>
                    <ui:Button Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding RenameTaskFilterPresetCommand}" Content="重命名" ToolTip="确认后重命名选中的任务筛选预设" AutomationProperties.Name="重命名任务筛选预设" Margin="0,0,8,0"/>
                    <ui:Button Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding DeleteTaskFilterPresetCommand}" Content="删除" ToolTip="确认后删除选中的任务筛选预设" AutomationProperties.Name="删除任务筛选预设"/>
                </WrapPanel>
                <Border x:Name="TaskNavigationSourceBanner" Grid.Row="2" Grid.ColumnSpan="8" Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GscDiagnosticHintBubble}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTaskNavigationTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconStatusInfo}" Width="18" Height="18" Foreground="{DynamicResource GscInfoBrush}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TaskNavigationSourceText" Grid.Column="1" Text="{Binding TaskNavigationSourceSummary, Mode=OneWay}" Style="{StaticResource GscDiagnosticHintText}" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding TaskNavigationSourceSummary, Mode=OneWay}"/>
                        <ui:Button Grid.Column="2" Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding ClearTaskNavigationContextCommand}" Content="清除带入条件" ToolTip="仅清除带入的游戏条件，保留其他任务筛选" AutomationProperties.Name="清除带入的任务筛选" Margin="12,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Expander x:Name="TaskMoreFiltersExpander" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GscDisclosureCard}" Visibility="Collapsed" Margin="0,0,0,8">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="更多筛选" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TaskActiveFiltersSummary, Mode=OneWay}" Style="{DynamicResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="12,0,12,0" VerticalAlignment="Center"/>
                    <!-- Icon-only: clear filters keeps an explicit accessible name. -->
                    <ui:Button x:Name="TaskClearFiltersButton" Grid.Column="2" Command="{Binding ClearTaskFiltersCommand}" ToolTip="清除搜索、状态、类型、游戏和时间筛选" AutomationProperties.Name="清除任务筛选" Click="OnClearTaskFiltersClick"><ui:Button.Content><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnClear}" Width="18" Height="18"/></ui:Button.Content>
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource GscIconOnlyButtonBase}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TaskHasActiveFilters}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Expander.Header>
            <StackPanel x:Name="TaskMoreFiltersHost" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="TaskGameFilterLabel" Text="游戏" Style="{DynamicResource GscBodyStyle}" VerticalAlignment="Center"/>
                <ComboBox x:Name="TaskGameFilterComboBox" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="130" MaxWidth="210" ItemsSource="{Binding TaskGameFilterOptions}" SelectedItem="{Binding TaskGameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="游戏筛选" Margin="10,0,6,0"/>
                <TextBlock x:Name="TaskHistoryScopeLabel" Text="范围：" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                <TextBlock x:Name="TaskHistoryRangeLabel" Text="时间：" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="6,0,4,0"/>
            </StackPanel>
        </Expander>
        <Border x:Name="TaskQueuePanel" Grid.Row="3" Grid.Column="0" Style="{DynamicResource GscRedesignSectionCard}" Padding="6,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,2,12,8">
                    <TextBlock Text="任务队列" FontSize="15" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding RetryAllTasksCommand}" Content="重试可恢复" ToolTip="只处理当前已加载且符合筛选的记录；按游戏和任务类型各重试一次" AutomationProperties.Name="批量重试当前结果中的可恢复任务" Margin="0,0,10,0"/>
                        <ui:Button Command="{Binding LoadMoreTasksCommand}" Content="加载更多" ToolTip="按稳定游标继续加载历史任务">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource GscWpfUiSecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding TaskHistoryHasMore}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Content="重置列宽" ToolTip="恢复任务表格的默认列宽" AutomationProperties.Name="重置任务表格列宽" Click="OnResetColumnLayoutClick" Margin="10,0,0,0"/>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding TaskLoadedSummary}" Style="{DynamicResource GscCaptionStyle}"/>
                            <TextBlock x:Name="TaskQueueFilterSummary" Text="{Binding TaskActiveFiltersSummary}" Foreground="{DynamicResource GscInfoBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskActiveFiltersSummary}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GscCaptionStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TaskHasActiveFilters}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="TaskQueueLastUpdatedSummary" Text="{Binding TaskPageStatusSummary}" Style="{DynamicResource GscCaptionStyle}" Foreground="{DynamicResource GscMutedTextBrush}" Margin="0,2,0,0" ToolTip="{Binding TaskPageStatusSummary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border x:Name="TaskStaleDataBanner" Grid.Row="1" Padding="10,7" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GscRedesignSubCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TaskPageLoadFailed}" Value="True"/>
                                        <Condition Binding="{Binding TaskPageHasItems}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsTaskPageLoading}" Value="True"/>
                                        <Condition Binding="{Binding TaskPageHasItems}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TaskPageStatusSummary}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding RefreshCommand}" Content="重试" Margin="10,0,0,0" AutomationProperties.Name="重试任务记录读取"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource TaskTableFrame}">
                    <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="TaskGrid" Style="{StaticResource TaskDataGrid}" RowStyle="{StaticResource GscStableDataGridRow}" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}" SelectionMode="Extended" SelectionChanged="OnTaskSelectionChanged" infra:DataGridClipboardBehavior.Enabled="True" infra:DataGridClipboardBehavior.Profile="Task" ToolTip="Ctrl+C 复制所选行；Ctrl+Shift+C 复制当前单元格" AutomationProperties.HelpText="Ctrl+C 复制所选任务行；Ctrl+Shift+C 复制当前单元格">
                <DataGrid.Columns>
                    <DataGridTextColumn HeaderStyle="{StaticResource TaskFirstColumnHeader}" Header="本地时间" infra:DataGridColumnHeaderHelpBehavior.Description="本地时间；悬停可查看完整秒级时间。" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" Width="112" MinWidth="104" ElementStyle="{StaticResource TaskTimeCell}"/>
                    <DataGridTextColumn Header="任务" infra:DataGridColumnHeaderHelpBehavior.Description="任务类型；用于区分备份、校验、同步等工作。" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="104" MinWidth="96" ElementStyle="{StaticResource TaskLongTextCell}"/>
