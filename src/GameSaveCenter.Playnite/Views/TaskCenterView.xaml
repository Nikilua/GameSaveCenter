                        </Style>
                    </ui:WorkspaceStatePresenter.Style>
                </ui:WorkspaceStatePresenter>
                <ui:WorkspaceStatePresenter State="Error" Title="任务记录读取失败" Message="Worker 暂时没有返回任务列表；可以重试，已有旧数据不会被清除。" Detail="{Binding TaskPageErrorMessage}" RetryCommand="{Binding RefreshCommand}" RetryText="重试">
