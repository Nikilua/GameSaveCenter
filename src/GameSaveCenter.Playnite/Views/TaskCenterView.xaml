            </Border>
        <Border x:Name="TaskDetailCard" CornerRadius="12" Padding="14"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource TaskSurface}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock FontWeight="SemiBold"><Run Text="{Binding SelectedTask.GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTask.TaskTypeDisplay, Mode=OneWay}"/></TextBlock><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="状态" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource TaskInspectorStatusPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedTask.StateDisplay, Mode=OneWay, Converter={StaticResource GscStatusGlyphConverter}}" Foreground="{DynamicResource GscPrimaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" HorizontalAlignment="Center"/></Border><TextBlock Grid.Row="1" Text="开始时间" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.StartedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}, TargetNullValue=未开始}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.StartedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/><TextBlock Grid.Row="2" Text="耗时" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.DurationDisplay, Mode=OneWay}" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Text="任务 ID" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.TaskId, Mode=OneWay}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.TaskId, Mode=OneWay}"/></Grid><StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="进度" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedTask.ProgressDisplay, Mode=OneWay}" Style="{StaticResource GscTypographyPercentCell}" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid><ProgressBar Margin="0,6,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedTask.ProgressValue, Mode=OneWay}"/></StackPanel><Border x:Name="TaskInspectorErrorCard" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask.State}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="失败详情" FontWeight="SemiBold" Foreground="{DynamicResource GscErrorBrush}"/><TextBlock Text="{Binding SelectedTask.FailureSummary, Mode=OneWay}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.FailureSummary, Mode=OneWay}" Margin="0,4,0,0" FontSize="{DynamicResource GscCaptionFontSize}" AutomationProperties.Name="任务失败摘要"/><TextBlock Text="{Binding SelectedTask.ErrorCode, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0" AutomationProperties.Name="任务错误码"/></StackPanel></Border><TextBlock Text="完整详情" FontWeight="SemiBold" Margin="0,14,0,0"/><Expander x:Name="TaskTechnicalDetailsExpander" Style="{StaticResource GscDisclosureCard}" Header="技术详情" IsExpanded="False" Margin="0,6,0,0" AutomationProperties.Name="展开任务技术详情"><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding SelectedTask.SafeDetailMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="180" AutomationProperties.Name="任务可选择技术详情"/></Expander></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Content="查看关联游戏" Command="{Binding OpenSelectedTaskGameCommand}" ToolTip="按稳定 PlayniteId 打开任务对应的游戏详情；找不到对象时不会替换当前游戏" AutomationProperties.Name="查看关联游戏详情"/><WrapPanel x:Name="TaskDetailActions" VerticalAlignment="Center"><ui:Button Style="{DynamicResource GscIconOnlyButtonBase}" Command="{Binding CopyTaskErrorCommand}" ToolTip="复制任务摘要与详情" AutomationProperties.Name="复制任务摘要和错误码"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnCopy}" Width="18" Height="18"/></ui:Button><ui:Button Style="{DynamicResource GscIconOnlyButtonBase}" Command="{Binding RetryTaskCommand}" ToolTip="安全重试" AutomationProperties.Name="安全重试任务"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnRetry}" Width="18" Height="18"/></ui:Button><TextBlock x:Name="TaskCancellationStatusText" Text="正在取消…" Foreground="{DynamicResource GscWarningBrush}" VerticalAlignment="Center" Margin="4,0,8,0" AutomationProperties.HelpText="取消请求正在等待 Worker 安全收尾。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCancellingTask}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ui:Button Style="{DynamicResource GscIconOnlyDangerButton}" Command="{Binding CancelTaskCommand}" ToolTip="取消任务" AutomationProperties.Name="取消任务"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnCancel}" Width="18" Height="18"/></ui:Button></WrapPanel></StackPanel><ui:Button x:Name="TaskCompactCloseDetailsButton" Grid.Row="0" Style="{DynamicResource GscIconOnlyButtonBase}" ToolTip="收起详情" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Click="OnTaskCompactDetailsClick" AutomationProperties.Name="收起所选任务详情"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnCollapse}" Width="18" Height="18"/></ui:Button></Grid></Border>
            <Border x:Name="TaskProgressTelemetryCard" Padding="10" Margin="0,10,0,0">
