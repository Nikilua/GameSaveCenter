                            <DataTrigger Binding="{Binding SelectedTask.IsCancellationPending}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTask.State}" Value="Cancelled"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
