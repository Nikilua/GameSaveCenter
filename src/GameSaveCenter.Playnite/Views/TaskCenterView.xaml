<UserControl x:Class="GameSaveCenter.Playnite.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
            </Style>
            <Style x:Key="TaskLongTextCell" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="TaskDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
                <Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
            </Style>
            <Style x:Key="TaskTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="TaskFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter>
            </Style>
            <Style x:Key="TaskLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter>
            </Style>
            <!-- Metric cards follow the Demo's three-line reading rhythm and the shared
                 10-DIP gap; the queue owns the remaining finite viewport below. -->
            <Style x:Key="TaskInspectorStatusPill" TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Succeeded"><Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Failed"><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Running"><Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Cancelled"><Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TaskSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="TaskPageScrollSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
    <Grid x:Name="TaskWorkspaceLayout" Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="6,12" Margin="0,0,0,8">
            <UniformGrid x:Name="TaskSummaryPanel" Grid.Row="0" Grid.ColumnSpan="3" Columns="4">
                <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="14,2"><StackPanel><TextBlock Text="{Binding Tasks.Count, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="任务总数" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="Transparent" BorderBrush="{DynamicResource GscTableDividerBrush}" BorderThickness="1,0,0,0" Padding="14,2"><StackPanel><TextBlock Text="{Binding RunningTaskCount, Mode=OneWay}" Foreground="{DynamicResource GscInfoBrush}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="运行中" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="Transparent" BorderBrush="{DynamicResource GscTableDividerBrush}" BorderThickness="1,0,0,0" Padding="14,2"><StackPanel><TextBlock Text="{Binding RetryableTaskCount, Mode=OneWay}" Foreground="{DynamicResource GscErrorBrush}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="需要重试" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="Transparent" BorderBrush="{DynamicResource GscTableDividerBrush}" BorderThickness="1,0,0,0" Padding="14,2"><StackPanel><TextBlock Text="{Binding CompletedTaskCount, Mode=OneWay}" Foreground="{DynamicResource GscSuccessBrush}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="今日完成" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
            </UniformGrid>
        </Border>
        <!-- Keep the Demo order: filter toolbar, optional game filter, then the
             queue card. Each row is measured independently so the table can never
             push the filters underneath itself. -->
        <Border x:Name="TaskFilterBar" Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="10,8" Margin="0,0,0,8">
            <Grid x:Name="TaskFiltersPanel" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The search hint belongs inside the field. Keeping the label as a
                     separate Auto column made the real host give the input only a
                     narrow sliver, while the Demo uses one continuous search field. -->
                <Grid x:Name="TaskSearchBoxHost" Grid.Row="0" Grid.Column="0" MinWidth="180" Margin="0,0,10,0">
                    <TextBox x:Name="TaskSearchTextBox" Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding TaskSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索任务、游戏或错误" AutomationProperties.Name="搜索任务" HorizontalAlignment="Stretch" Padding="30,7,10,7"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="搜索任务…" VerticalAlignment="Center" Margin="30,0,12,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GscCaptionStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TaskSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="TaskStatusFilterLabel" Grid.Row="0" Grid.Column="1" Text="状态:" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="TaskStatusFilterComboBox" Grid.Row="0" Grid.Column="2" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="112" MaxWidth="160" ItemsSource="{Binding TaskStatusFilterOptions}" SelectedItem="{Binding TaskStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="任务状态" Margin="0,0,10,0"/>
                <TextBlock x:Name="TaskTypeFilterLabel" Grid.Row="0" Grid.Column="3" Text="类型:" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="TaskTypeFilterComboBox" Grid.Row="0" Grid.Column="4" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="110" MaxWidth="180" ItemsSource="{Binding TaskTypeFilterOptions}" SelectedItem="{Binding TaskTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="任务类型" Margin="0,0,10,0"/>
                <ui:Button x:Name="TaskRefreshButton" Grid.Row="0" Grid.Column="5" Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding RefreshCommand}" Content="刷新" ToolTip="刷新任务列表"/>
            </Grid>
        </Border>
        <Expander x:Name="TaskMoreFiltersExpander" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GscDisclosureCard}" Header="更多筛选" Visibility="Collapsed" Margin="0,0,0,8">
            <StackPanel x:Name="TaskMoreFiltersHost" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="TaskGameFilterLabel" Text="游戏" Style="{DynamicResource GscBodyStyle}" VerticalAlignment="Center"/>
                <ComboBox x:Name="TaskGameFilterComboBox" Style="{DynamicResource GscWpfUiFilterComboBox}" MinWidth="130" MaxWidth="210" ItemsSource="{Binding TaskGameFilterOptions}" SelectedItem="{Binding TaskGameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="游戏筛选" Margin="10,0,6,0"/>
            </StackPanel>
        </Expander>
        <Border x:Name="TaskQueuePanel" Grid.Row="3" Grid.Column="0" Style="{DynamicResource GscRedesignSectionCard}" Padding="6,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,2,12,8">
                    <TextBlock Text="任务队列" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="按提交时间倒序 · 实时更新" Style="{DynamicResource GscCaptionStyle}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource TaskTableFrame}">
                    <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="TaskGrid" Style="{StaticResource TaskDataGrid}" RowStyle="{StaticResource GscStableDataGridRow}" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}" SelectionChanged="OnTaskSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn HeaderStyle="{StaticResource TaskFirstColumnHeader}" Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="106" ElementStyle="{StaticResource TaskLongTextCell}"/>
                    <DataGridTextColumn Header="任务" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="96" ElementStyle="{StaticResource TaskLongTextCell}"/>
                    <DataGridTextColumn Header="游戏" Binding="{Binding GameName, Mode=OneWay}" Width="1.15*" MinWidth="100" ElementStyle="{StaticResource TaskLongTextCell}"/>
                    <DataGridTemplateColumn Header="状态" Width="94"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="TaskStatusPill" Style="{DynamicResource GscRedesignTableStatusPill}"><TextBlock Text="{Binding StateDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" HorizontalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Running"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscControlFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="进度" Width="126" MinWidth="116"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="52"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ProgressBar Height="8" MinWidth="52" HorizontalAlignment="Stretch" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn HeaderStyle="{StaticResource TaskLastColumnHeader}" Header="详情" Binding="{Binding DetailMessage, Mode=OneWay}" Width="1.4*" MinWidth="140" ElementStyle="{StaticResource TaskLongTextCell}"/>
                </DataGrid.Columns>
            </DataGrid>
                <ui:WorkspaceStatePresenter State="Empty" Title="暂无任务记录" Message="完成备份、媒体同步或维护操作后，任务会显示在这里。" IsHitTestVisible="False">
                    <ui:WorkspaceStatePresenter.Style>
                        <Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TasksView.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:WorkspaceStatePresenter.Style>
                </ui:WorkspaceStatePresenter>
                <ui:Button x:Name="TaskCompactDetailsButton"
                           Grid.Row="1"
                           Style="{DynamicResource GscWpfUiSecondaryButton}"
                           Content="查看任务详情 ›"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0"
                           Visibility="Collapsed"
                           Click="OnTaskCompactDetailsClick"
                            AutomationProperties.Name="查看或收起所选任务详情"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer x:Name="TaskDetailScrollViewer" Grid.Row="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource GscInspectorScrollViewer}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Border x:Name="TaskDetailCard" CornerRadius="12" Padding="14"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource TaskSurface}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock FontWeight="SemiBold"><Run Text="{Binding SelectedTask.GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTask.TaskTypeDisplay, Mode=OneWay}"/></TextBlock><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="状态" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource TaskInspectorStatusPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedTask.StateDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/></Border><TextBlock Grid.Row="1" Text="开始时间" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.StartedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}, TargetNullValue=未开始}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.StartedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/><TextBlock Grid.Row="2" Text="耗时" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.DurationDisplay, Mode=OneWay}" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Text="任务 ID" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.TaskId, Mode=OneWay}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.TaskId, Mode=OneWay}"/></Grid><StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="进度" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedTask.ProgressPercent, Mode=OneWay, StringFormat={}{0}%}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid><ProgressBar Margin="0,6,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedTask.ProgressPercent, Mode=OneWay}"/></StackPanel><TextBlock Text="完整详情" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedTask.DetailMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,6,0,0"/><Border x:Name="TaskInspectorErrorCard" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask.State}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="失败详情" FontWeight="SemiBold" Foreground="{DynamicResource GscErrorBrush}"/><TextBlock Text="{Binding SelectedTask.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/><TextBlock Text="{Binding SelectedTask.ErrorCode, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></StackPanel><WrapPanel x:Name="TaskDetailActions" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CopyTaskErrorCommand}" Content="复制详情" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding RetryTaskCommand}" Content="安全重试" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CancelTaskCommand}" Content="取消任务" Margin="0"/></WrapPanel></Grid></Border>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
