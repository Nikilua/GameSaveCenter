                    </ui:WorkspaceStatePresenter.Style>
                </ui:WorkspaceStatePresenter>
                <ui:WorkspaceStatePresenter State="FilterEmpty" Title="当前筛选没有任务" Message="任务记录仍然存在，但不符合当前搜索、状态、类型或时间条件。" RetryCommand="{Binding ClearTaskFiltersCommand}" RetryText="清除筛选">
