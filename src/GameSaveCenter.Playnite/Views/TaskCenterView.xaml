                    <DataGridTemplateColumn Header="状态" infra:DataGridColumnHeaderHelpBehavior.Description="任务生命周期状态；失败和取消不会伪装成完成。" Width="104" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="TaskStatusPill" Style="{DynamicResource GscRedesignTableStatusPill}"><TextBlock Text="{Binding StateDisplay, Mode=OneWay, Converter={StaticResource GscStatusGlyphConverter}}" Foreground="{DynamicResource GscPrimaryTextBrush}" HorizontalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Running"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscControlFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="进度" infra:DataGridColumnHeaderHelpBehavior.Description="完成比例；有效值为 0–100%，未知或排队状态不伪造百分比。" Width="132" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="52"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ProgressBar Height="8" MinWidth="52" HorizontalAlignment="Stretch" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"/><TextBlock Grid.Column="1" Text="{Binding ProgressDisplay, Mode=OneWay}" Style="{StaticResource GscTypographyPercentCell}" Foreground="{DynamicResource GscSecondaryTextBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn HeaderStyle="{StaticResource TaskLastColumnHeader}" Header="详情" Binding="{Binding DetailMessage, Mode=OneWay}" Width="1.2*" MinWidth="160" ElementStyle="{StaticResource TaskLongTextCell}"/>
