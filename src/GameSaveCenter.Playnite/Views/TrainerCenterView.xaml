<UserControl x:Class="GameSaveCenter.Playnite.Views.TrainerCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             xmlns:contracts="clr-namespace:GameSaveCenter.Playnite.XamlValues"
             Foreground="{DynamicResource GscPrimaryTextBrush}" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
             AllowDrop="True" PreviewDragOver="OnToolDragOver" Drop="OnToolDrop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrainerTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="TrainerTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="TrainerTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="TrainerCompactNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource GscNumericTextBox}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="9,4"/>
            </Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <!-- Let Grid star rows determine the viewport.  A fixed Height here
                     makes the installed and catalog tabs collapse or leave large
                     unused regions when the host is resized. -->
                <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ui:AmbientMaterialLayer Panel.ZIndex="-1"/><TabControl Grid.Row="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource TrainerTabControl}"><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource TrainerTabItem}"/></TabControl.Resources>
        <TabItem Header="已绑定工具"><Grid x:Name="InstalledToolsLayout" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="TrainerToolsToolbarRow" Height="Auto"/>
                    <RowDefinition x:Name="TrainerToolsHintRow" Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource GscSelectedGameIconControl}" Width="36" Height="36" Content="{Binding SelectedGameIcon}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="当前游戏工具" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="当前游戏工具"/>
                <StackPanel x:Name="TrainerToolsToolbar" Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportTrainerCommand}" Content="导入修改器" Margin="0,0,8,0"/>
                    <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportToolFolderCommand}" Content="导入目录" Margin="0,0,8,0"/>
                    <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportCheatTableCommand}" Content="导入 CT" Margin="0,0,8,0"/>
                    <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportCustomLaunchItemCommand}" Content="+ 添加启动项"/>
                </StackPanel>
                <TextBlock x:Name="TrainerToolsDropHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="拖入 EXE / CT / LNK / BAT / CMD / PS1 / ZIP 到此页导入" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="拖入 EXE / CT / LNK / BAT / CMD / PS1 / ZIP 到此页导入" AutomationProperties.Name="拖入工具文件到此页导入"/>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource GscAccentTintBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingGameToolEntrySelection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><WrapPanel><StackPanel VerticalAlignment="Center" Margin="0,0,14,8"><TextBlock Text="选择修改器主程序" FontWeight="SemiBold"/><TextBlock Text="检测到多个 EXE，确认后才会完成导入。" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><ComboBox Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding ImportEntryCandidates}" SelectedItem="{Binding SelectedImportEntryCandidate}" MinWidth="260" MaxWidth="440" VerticalAlignment="Center" Margin="0,0,12,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding ConfirmGameToolImportCommand}" Content="确认导入" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding CancelGameToolImportCommand}" Content="取消" Margin="0,0,0,8"/></WrapPanel></Border>
            <Border x:Name="TrainerToolsTable" Grid.Row="2" Style="{StaticResource TrainerTableFrame}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="TrainerToolsList" ItemsSource="{Binding GameTools}" SelectedItem="{Binding SelectedGameTool}" SelectionChanged="OnTrainerToolsSelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource GscAccentTintStrongBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,12,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"><Run Text="{Binding TypeDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ActiveVersion.VersionName, Mode=OneWay}"/></TextBlock></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FileStateDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding AutoStartDisplay, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="暂无已安装工具&#xA;可以导入 EXE、ZIP、文件夹或 CT 文件。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock><ui:WorkspaceStatePresenter State="Empty" Title="暂无已安装工具" Message="可以导入 EXE、ZIP、文件夹或 CT 文件。" IsHitTestVisible="False"><ui:WorkspaceStatePresenter.Style><Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding GameTools.Count}" Value="0"/><Condition Binding="{Binding IsTrainerToolsLoading}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></ui:WorkspaceStatePresenter.Style></ui:WorkspaceStatePresenter><ui:WorkspaceStatePresenter State="Loading" Title="正在读取游戏工具" Message="Worker 正在读取当前游戏已绑定的工具。" IsHitTestVisible="False"><ui:WorkspaceStatePresenter.Style><Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrainerToolsLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:WorkspaceStatePresenter.Style></ui:WorkspaceStatePresenter><ui:Button x:Name="TrainerToolsCompactDetailsButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="查看工具详情 ›" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,8,0" Visibility="Collapsed" Click="OnTrainerToolsCompactDetailsClick" AutomationProperties.Name="查看或收起所选工具详情"/></Grid></Border>
            <ScrollViewer x:Name="TrainerToolsSettingsScrollViewer" Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" Margin="0,0,0,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource GscInspectorScrollViewer}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGameTool}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Border Style="{DynamicResource GscReadingCardStyle}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="工具设置" FontSize="15" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="名称" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,0,0,3"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding SelectedGameTool.DisplayName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/><TextBlock Text="版本" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,6,0,3"/><ComboBox ItemsSource="{Binding SelectedGameTool.Versions}" SelectedItem="{Binding SelectedGameToolVersion}" Style="{DynamicResource GscWpfUiComboBox}" Margin="0,0,0,6" ToolTip="选择要使用的版本"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding VersionName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EntryPath}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="路径" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,6,0,3"/><TextBlock Text="{Binding SelectedGameToolVersion.EntryPath, TargetNullValue=未选择版本}" Foreground="{DynamicResource GscMutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGameToolVersion.EntryPath}" Margin="0,0,0,6"/><TextBlock Text="工作目录" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,6,0,3"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding SelectedGameToolVersion.WorkingDirectory, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/><TextBlock Text="启动参数" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,6,0,3"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding SelectedGameToolVersion.Arguments, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/><StackPanel Margin="0,0,0,6"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameTool.IsCustomExecutable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="已有实例时" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,6,0,3"/><ComboBox ItemsSource="{Binding GameToolIfAlreadyRunningOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedGameTool.IfAlreadyRunning}" Style="{DynamicResource GscWpfUiComboBox}" ToolTip="仅按解析后的 EXE 完整路径匹配，不会按名称关闭其他程序"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Margin="0,0,0,6"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameTool.IsCustomExecutable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="工具类别" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,6,0,3"/><ComboBox ItemsSource="{Binding GameToolRiskCategoryOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedGameTool.RiskCategory}" Style="{DynamicResource GscWpfUiComboBox}" ToolTip="反作弊游戏中仅允许标记为通用工具的自定义启动项自动启动"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameTool.RiskCategory}" Value="{x:Static contracts:GameToolRiskCategory.Unknown}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="反作弊游戏中允许此未分类工具自动启动" IsChecked="{Binding SelectedGameTool.AllowUnknownToolWithAntiCheat}" AutomationProperties.Name="反作弊游戏中允许此未分类工具自动启动"/></StackPanel></StackPanel><TextBlock Text="{Binding SelectedGameTool.AutoStartRiskHint}" Foreground="{DynamicResource GscWarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding SelectedGameTool.ExternalReferenceHint}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameTool.IsExternalReference}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><WrapPanel Margin="0,2,0,0"><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="启用" IsChecked="{Binding SelectedGameTool.Enabled}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="随游戏启动" IsChecked="{Binding SelectedGameTool.AutoStart}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="退出后关闭" IsChecked="{Binding SelectedGameTool.CloseOnGameExit}" IsEnabled="{Binding SelectedGameTool.CanTrackProcess}" ToolTip="仅 EXE 或可解析的快捷方式目标能可靠跟踪进程；脚本和系统默认程序无法安全关闭" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="管理员权限" IsChecked="{Binding SelectedGameTool.RequiresAdmin}" Margin="0,0,18,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="启动延迟" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="启动延迟"/><TextBox Style="{StaticResource TrainerCompactNumericTextBox}" Width="72" Text="{Binding SelectedGameTool.LaunchDelaySeconds, UpdateSourceTrigger=LostFocus}" ToolTip="启动延迟，0-300 秒"/><TextBlock Text="秒" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></WrapPanel></StackPanel><WrapPanel Grid.Row="2" Margin="0,10,0,0"><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding LaunchGameToolCommand}" Content="启动"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding SaveGameToolCommand}" Content="保存设置"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding OpenGameToolDirectoryCommand}" Content="打开目录"/><ui:Button Command="{Binding RelocateGameToolCommand}" Content="重新定位" Margin="0,0,8,0"><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource GscWpfUiActionButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameTool.IsExternalReference}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:Button.Style></ui:Button><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DeleteGameToolCommand}" Content="解除绑定"/></WrapPanel></Grid></Border>
            </ScrollViewer>
        </Grid></TabItem>
        <TabItem Header="导入确认">
            <Border Style="{DynamicResource GscReadingCardStyle}" Padding="22" Margin="0,12,0,0" MaxWidth="980" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                    <TextBlock Text="确认导入" Style="{DynamicResource GscSectionTitleStyle}"/>
                    <TextBlock Text="当压缩包或目录中包含多个可执行文件时，GameSaveCenter 会要求你明确选择主程序；未确认前不会创建工具绑定。" Style="{DynamicResource GscCaptionStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <Border Style="{DynamicResource GscRedesignInfoBand}" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="暂无待确认导入"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingGameToolEntrySelection, Mode=OneWay}" Value="True"><Setter Property="Text" Value="当前有一个导入项目待确认"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="请选择要启动的 EXE，然后确认导入；取消会清理本次临时导入，不影响已有工具。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="主程序" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TrainerImportEntryComboBox" Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding ImportEntryCandidates}" SelectedItem="{Binding SelectedImportEntryCandidate}" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                        <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding ConfirmGameToolImportCommand}" Content="确认导入" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding CancelGameToolImportCommand}" Content="取消" Margin="0,0,8,8"/>
                        <TextBlock Text="如果当前没有待确认项目，请先从“已绑定工具”页导入 EXE、ZIP 或目录。" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </TabItem>
        <TabItem Header="FLiNG 在线库">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{DynamicResource GscReadingCardStyle}" Padding="16" MaxWidth="1080" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="TrainerSearchBoxHost" Width="680" MinWidth="0" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBox x:Name="TrainerSearchTextBox" Style="{DynamicResource GscWpfUiTextBox}" Width="680" MinWidth="0" MaxWidth="680" HorizontalAlignment="Stretch" Padding="12,3,38,3" VerticalAlignment="Center" Text="{Binding TrainerSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入游戏名称，搜索本地缓存的 FLiNG 目录" AutomationProperties.Name="搜索 FLiNG 目录"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                                    Tag="{Binding ElementName=TrainerSearchTextBox}" ToolTip="清除搜索"
                                    AutomationProperties.Name="清除 FLiNG 搜索" Click="OnClearSearchTextBoxClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GscSearchClearButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TrainerSearchTextBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=TrainerSearchTextBox}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SearchTrainerCatalogCommand}" Content="搜索目录" Margin="0,0,8,0"/>
                            <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding SyncTrainerCatalogCommand}" Content="刷新目录" Margin="0,0,0,0"/>
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border x:Name="TrainerCatalogResultsPanel" Grid.Row="1" Style="{StaticResource TrainerTableFrame}" Margin="0,12,0,0" MinHeight="236">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="搜索结果" FontWeight="SemiBold"/><TextBlock Text="选择一个目录结果后，在“可下载版本”中确认具体版本。" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TrainerCatalogResults.Count, Mode=OneWay, StringFormat={}{0} 个结果}" Foreground="{DynamicResource GscSecondaryTextBrush}" VerticalAlignment="Center"/></Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding TrainerCatalogResults}" SelectedItem="{Binding SelectedTrainerCatalogItem}" SelectionChanged="OnTrainerCatalogSelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Margin="10,0,10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource GscAccentTintStrongBrush}"><TextBlock Text="F" Foreground="{DynamicResource GscAccentBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"><Run Text="{Binding SourceDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding GameVersion, Mode=OneWay, TargetNullValue=版本未标注}"/><Run Text=" · "/><Run Text="{Binding OptionCount, Mode=OneWay}"/><Run Text=" 项功能"/></TextBlock></StackPanel><ui:Button Grid.Column="2" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding DataContext.LoadTrainerReleasesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="读取版本" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="没有匹配的 FLiNG 条目&#xA;先搜索本地缓存，或点击“刷新目录”同步最新目录。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding TrainerCatalogResults.Count}" Value="0"/><Condition Binding="{Binding IsTrainerCatalogLoading}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <ui:WorkspaceStatePresenter Grid.Row="1" State="Loading" Title="正在读取 FLiNG 目录" Message="正在查询本地目录缓存，请稍候。" IsHitTestVisible="False"><ui:WorkspaceStatePresenter.Style><Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrainerCatalogLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:WorkspaceStatePresenter.Style></ui:WorkspaceStatePresenter>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="可下载版本">
            <Grid x:Name="TrainerReleasesLayout" Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
                <Border x:Name="TrainerCatalogReleasesPanel" Style="{StaticResource TrainerTableFrame}" MinHeight="236">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="可下载版本" FontWeight="SemiBold"/><TextBlock Text="只在用户选择在线目录结果后按需读取。" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TrainerReleases.Count, Mode=OneWay, StringFormat={}{0} 个版本}" Foreground="{DynamicResource GscSecondaryTextBrush}" VerticalAlignment="Center"/></Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding TrainerReleases}" SelectedItem="{Binding SelectedTrainerRelease}" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Margin="10,0,10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel MinWidth="0"><TextBlock Text="{Binding VersionDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionDisplay}"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding OptionCountDisplay}"><Run Text="{Binding OptionCountDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PublishedDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding ReleaseId}" Foreground="{DynamicResource GscMutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReleaseId}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="选择 FLiNG 搜索结果后查看可下载版本。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding TrainerReleases.Count}" Value="0"/><Condition Binding="{Binding IsTrainerReleasesLoading}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <ui:WorkspaceStatePresenter Grid.Row="1" State="Loading" Title="正在读取可下载版本" Message="正在查询当前目录的版本信息，请稍候。" IsHitTestVisible="False"><ui:WorkspaceStatePresenter.Style><Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrainerReleasesLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:WorkspaceStatePresenter.Style></ui:WorkspaceStatePresenter>
                        <ui:Button Grid.Row="2" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding DownloadTrainerCommand}" Content="下载并绑定当前游戏" Margin="12" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
                <Border x:Name="TrainerReleaseInfoPanel" Grid.Column="2" Style="{DynamicResource GscRedesignSectionCard}" Padding="18">
                    <ScrollViewer x:Name="TrainerReleaseInfoScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="下载任务" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTrainerCatalogItem.Title, TargetNullValue=尚未选择目录结果}" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTrainerCatalogItem.Title}" Margin="0,4,0,0"/>
                            <Separator/>
                            <TextBlock Text="{Binding SelectedTrainerRelease.VersionDisplay, TargetNullValue=请选择版本}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTrainerRelease.VersionDisplay}"/>
                            <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"><Run Text="功能："/><Run Text="{Binding SelectedTrainerRelease.OptionCountDisplay, Mode=OneWay, TargetNullValue=未标注}"/><Run Text=" · 发布时间："/><Run Text="{Binding SelectedTrainerRelease.PublishedDisplay, Mode=OneWay, TargetNullValue=未标注}"/></TextBlock>
                            <Border Style="{DynamicResource GscDiagnosticHintBubble}" Margin="0,16,0,0"><TextBlock Style="{DynamicResource GscDiagnosticHintText}" Text="下载后会先校验并安全解压，再创建当前游戏的工具绑定；旧版本不会被覆盖。"/></Border>
                            <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding DownloadTrainerCommand}" Content="下载并绑定" HorizontalAlignment="Stretch" Margin="0,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>
    </TabControl></Grid>
</UserControl>
