<UserControl x:Class="GameSaveCenter.Playnite.Views.MediaCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Playnite.XamlValues"
             xmlns:converters="clr-namespace:GameSaveCenter.Playnite.Converters"
             xmlns:infra="clr-namespace:GameSaveCenter.Playnite.Infrastructure"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MediaInboxColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MediaInboxStableRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource GscStableDataGridRow}">
                <Setter Property="MinHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <converters:MediaThumbnailConverter x:Key="MediaThumbnailConverter"/>
            <converters:MediaVideoSourceConverter x:Key="MediaVideoSourceConverter"/>
            <DataTemplate x:Key="MediaGameTargetTemplate">
                <Grid MinWidth="224" Margin="0,2" ToolTip="{Binding IdentityDisplay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource GscAccentIconFillBrush}" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="{Binding PlatformDisplay}" FontSize="9" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Image Source="{Binding IconPath}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PlatformDisplay}" Style="{DynamicResource GscCaptionStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding IdentityDisplay}" Style="{DynamicResource GscCaptionStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="MediaDataGrid" TargetType="DataGrid" BasedOn="{StaticResource GscRedesignWorkspaceDataGrid}">
                <Setter Property="RowStyle" Value="{StaticResource MediaInboxStableRowStyle}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <!-- WPF's DataGrid has a large-data regression when column virtualization
                     and recycled rows are combined with star-sized text columns: after a
                     thumb drag the realized rows can be laid out at the bottom of an
                     otherwise empty viewport. Keep the inbox on stable item scrolling,
                     standard row virtualization and the top-aligned shared presenter.
                     Row virtualization remains enabled; only the unsafe recycling/column
                     virtualization combination is disabled for this 5000-item inbox. -->
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
                <Setter Property="EnableColumnVirtualization" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <!-- This grid already has a finite Grid viewport. The shared star-fill
                     workaround is intended for tables measured by an unbounded host; it
                     converts star columns to pixel widths and can invalidate the rows
                     presenter while the thumb is moving. Keep native finite-viewport
                     star measurement for the large inbox instead. -->
                <Setter Property="infra:DataGridStarFill.Enabled" Value="False"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource MediaInboxColumnHeaderStyle}"/>
            </Style>
            <Style x:Key="MediaLongText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="MediaTimeCell" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyTimeCell}">
                <Setter Property="ToolTip" Value="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
            </Style>
            <Style x:Key="MediaPathText" TargetType="TextBlock" BasedOn="{StaticResource GscPathText}">
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="MediaTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="MediaEmptyText" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="22"/></Style>
            <Style x:Key="MediaStatusPill" TargetType="Border"><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
            <Style x:Key="MediaFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaInboxColumnHeaderStyle}"><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MediaMiddleColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaInboxColumnHeaderStyle}"/>
            <Style x:Key="MediaLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaInboxColumnHeaderStyle}"><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MediaTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="MediaTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="GscTableFrame" TargetType="Border" BasedOn="{StaticResource MediaTableFrame}"/>
            <Style x:Key="GscFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaFirstColumnHeader}"/>
            <Style x:Key="GscLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaLastColumnHeader}"/>
            <Style x:Key="GscTabControl" TargetType="TabControl" BasedOn="{StaticResource MediaTabControl}"/>
            <Style x:Key="GscTabItem" TargetType="TabItem" BasedOn="{StaticResource MediaTabItem}"/>
            <Style x:Key="GscEmptyText" TargetType="TextBlock" BasedOn="{StaticResource MediaEmptyText}"/>
            <Style x:Key="GscStatusPill" TargetType="Border" BasedOn="{StaticResource MediaStatusPill}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:AmbientMaterialLayer Grid.RowSpan="2" Panel.ZIndex="-1"/>
        <Border x:Name="MediaSummaryPanel" Grid.Row="0" Style="{DynamicResource GscRedesignSectionCard}" Padding="6,14" MinHeight="84" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="14,2,14,0">
                    <TextBlock Text="{Binding MediaSummary.TotalCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="媒体文件 · 截图 "/><Run Text="{Binding MediaSummary.ScreenshotCount, Mode=OneWay}"/><Run Text=" · 录像 "/><Run Text="{Binding MediaSummary.VideoCount, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource GscTableDividerBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4"/>
                <StackPanel Grid.Column="2" Margin="14,2,14,0">
                    <TextBlock Text="{Binding MediaSummary.TotalSizeDisplay, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0" TextWrapping="Wrap" Text="归档占用 · 目录可访问"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource GscTableDividerBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4"/>
                <StackPanel Grid.Column="4" Margin="14,2,14,0">
                    <TextBlock Text="{Binding MediaSummary.FavoriteCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0" TextWrapping="Wrap" Text="收藏 · 支持批量收藏与备注"/>
                </StackPanel>
                <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource GscTableDividerBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4"/>
                <StackPanel Grid.Column="6" Margin="14,2,14,0">
                    <TextBlock Text="{Binding MediaInboxCountDisplay, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MediaInboxCountCaption, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="{DynamicResource GscCaptionFontSize}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl x:Name="MediaTabControl" Grid.Row="1" SelectedIndex="{Binding MediaTabIndex, Mode=TwoWay}" MinWidth="0" MinHeight="0" Margin="8,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource MediaTabControl}">
            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MediaTabItem}"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,4,0"/></Style></TabControl.Resources>
            <TabItem Header="待归类">
                <!-- Keep the real DataGrid in a finite viewport. The page surface is a
                     deliberate overflow channel for compact windows; the DataGrid below
                     still owns its own bounded, virtualized row viewport. -->
                 <ScrollViewer x:Name="MediaInboxPageScrollViewer" Style="{DynamicResource GscPageScrollViewer}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                 <Grid x:Name="MediaInboxScrollSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                 <Grid x:Name="MediaInboxPageSurface" Margin="0,12,0,0" VerticalAlignment="Stretch">
                     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="MediaInboxInfoBand" Style="{DynamicResource GscRedesignInfoBand}" Margin="0,0,0,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding MediaInboxTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="MediaInboxInfoDescription" Text="只保留无法唯一判断所属游戏的公共截图和录像，不会静默猜测。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource MediaStatusPill}" VerticalAlignment="Center"><TextBlock Text="{Binding MediaInboxItems.Count, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></Border>
                        </Grid>
                    </Border>
                    <!-- Keep the primary inbox readable in compact windows. The page
                         ScrollViewer owns the overflow; the grid itself must still show
                         the header plus roughly four rows before that fallback is used. -->
                    <Grid x:Name="MediaInboxLayout" Grid.Row="1" MinHeight="0" ClipToBounds="True">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" x:Name="MediaInboxTableFrame" Style="{StaticResource MediaTableFrame}" Padding="14,12,14,12" MinHeight="0" ClipToBounds="True" VerticalAlignment="Stretch">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <Border x:Name="MediaInboxStaleBanner" Padding="10" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GscDiagnosticHintBubble}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding MediaInboxStaleVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding MediaInboxStateTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding MediaInboxStateDetail}" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,3,8,0"/></StackPanel>
                                    <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding ReloadMediaInboxCommand}" Content="重试" AutomationProperties.Name="重试读取媒体收件箱" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <WrapPanel x:Name="MediaInboxBatchActionRow" Margin="0,0,0,10" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock Text="批量处理" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MediaInboxBatchSelectionSummary" Text="未选择媒体 · Ctrl / Shift 多选" Style="{DynamicResource GscCaptionStyle}" Width="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="批量选择摘要" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ui:Button x:Name="MediaInboxClearSelectionButton" Style="{DynamicResource GscWpfUiActionButton}" Content="清空选择" ToolTip="只清空当前媒体收件箱视图的选择，不改变视图或筛选条件" AutomationProperties.Name="清空媒体批量选择" Click="OnClearMediaInboxSelectionClick" Visibility="Collapsed" Margin="0,0,8,4"/>
                                <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Content="重置列宽" ToolTip="恢复媒体收件箱表格的默认列宽" AutomationProperties.Name="重置媒体收件箱表格列宽" Click="OnResetColumnLayoutClick" Margin="0,0,8,4"/>
                                <ComboBox x:Name="MediaInboxModeCombo" Width="104" Style="{DynamicResource GscWpfUiFilterComboBox}" ItemsSource="{Binding MediaInboxModeOptions}" SelectedItem="{Binding MediaInboxMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="OnMediaInboxModeSelectionChanged" ToolTip="切换媒体收件箱视图" AutomationProperties.Name="媒体收件箱视图" Margin="0,0,8,4"/>
                                <StackPanel x:Name="MediaInboxTargetActions" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding MediaInboxMode}" Value="已忽略"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox Width="220" Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding Games}" SelectedItem="{Binding InboxTargetGame}" ToolTip="批量归类目标游戏；显示名称、平台和 Playnite ID" AutomationProperties.Name="批量归类目标游戏" ItemTemplate="{StaticResource MediaGameTargetTemplate}" Margin="0,0,8,4"/>
                                    <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding AssignInboxMediaBatchCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaInboxGrid}" Margin="0,0,8,4" AutomationProperties.Name="归类所选媒体">
                                        <StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscActionIcon}" IconData="{StaticResource GscIconActionCategorize}"/><TextBlock Text="归类所选" VerticalAlignment="Center"/></StackPanel>
                                    </ui:Button>
                                </StackPanel>
                                <ui:Button x:Name="MediaInboxCompactDetailsButton" Style="{DynamicResource GscWpfUiSecondaryButton}" Content="查看预览与归类 ›" ToolTip="打开所选媒体的预览、归类建议和安全操作" AutomationProperties.Name="查看所选媒体预览与归类" Click="OnMediaInboxCompactDetailsClick" Visibility="Collapsed" Margin="2,0,0,4"/>
                            </WrapPanel>
                            <WrapPanel x:Name="MediaFilterPresetRow" Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="筛选预设" Style="{DynamicResource GscCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="MediaFilterPresetComboBox" Width="180" Style="{DynamicResource GscWpfUiFilterComboBox}" ItemsSource="{Binding MediaFilterPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMediaFilterPreset, Mode=TwoWay}" ToolTip="选择已保存的媒体筛选组合" AutomationProperties.Name="媒体筛选预设" Margin="0,0,8,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding ApplyMediaFilterPresetCommand}" Content="应用" ToolTip="应用选中的媒体筛选预设" AutomationProperties.Name="应用媒体筛选预设" Margin="0,0,8,0"/>
                                <TextBox x:Name="MediaFilterPresetNameBox" Width="132" Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding MediaFilterPresetNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入预设名称" AutomationProperties.Name="媒体筛选预设名称" Margin="0,0,8,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding SaveMediaFilterPresetCommand}" Content="保存" ToolTip="保存当前媒体筛选组合" AutomationProperties.Name="保存媒体筛选预设" Margin="0,0,8,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding RenameMediaFilterPresetCommand}" Content="重命名" ToolTip="确认后重命名选中的媒体筛选预设" AutomationProperties.Name="重命名媒体筛选预设" Margin="0,0,8,0"/>
                                <ui:Button Style="{DynamicResource GscWpfUiSecondaryButton}" Command="{Binding DeleteMediaFilterPresetCommand}" Content="删除" ToolTip="确认后删除选中的媒体筛选预设" AutomationProperties.Name="删除媒体筛选预设"/>
                            </WrapPanel>
                            <Border Style="{DynamicResource GscActionAvailabilityHintBubble}" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding MediaInboxAvailabilityHint, Mode=OneWay}"
                                               Style="{DynamicResource GscActionAvailabilityHintText}"
                                               AutomationProperties.Name="{Binding MediaInboxAvailabilityHint, Mode=OneWay}"
                                               AutomationProperties.HelpText="{Binding MediaInboxAvailabilityHint, Mode=OneWay}"/>
                                    <ui:Button Grid.Column="1" Content="去维护中心检查" Command="{Binding OpenMaintenanceCommand}" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="去维护中心检查媒体环境">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource GscWpfUiContextButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding MediaInboxNeedsMaintenance}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                            </Border>
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="MediaInboxGrid" Tag="FiniteViewport" Style="{StaticResource MediaDataGrid}" MinHeight="0" VerticalAlignment="Stretch" ItemsSource="{Binding MediaInboxItems}" SelectedItem="{Binding SelectedInboxMedia}"
                                      SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnMediaInboxSelectionChanged" infra:DataGridClipboardBehavior.Enabled="True" infra:DataGridClipboardBehavior.Profile="MediaInbox" ToolTip="Ctrl+C 复制所选行；Ctrl+Shift+C 复制当前单元格" AutomationProperties.HelpText="Ctrl+C 复制所选媒体行；Ctrl+Shift+C 复制当前单元格"
                                      RowStyle="{StaticResource MediaInboxStableRowStyle}"
                                      VerticalContentAlignment="Top"
                                      HorizontalContentAlignment="Stretch"
                                      VirtualizingPanel.ScrollUnit="Item"
                                      ClipToBounds="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaFirstColumnHeader}" Header="拍摄时间" infra:DataGridColumnHeaderHelpBehavior.Description="本地拍摄时间；悬停可查看完整时间。" Binding="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaTimeCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaMiddleColumnHeader}" Header="类型" infra:DataGridColumnHeaderHelpBehavior.Description="媒体类型；当前支持截图、录像和未知媒体。" Binding="{Binding KindDisplay, Mode=OneWay}" Width="72"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaMiddleColumnHeader}" Header="来源" infra:DataGridColumnHeaderHelpBehavior.Description="媒体来源；显示来源渠道，不代表归类结果。" Binding="{Binding SourceDisplay, Mode=OneWay}" Width="115"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaMiddleColumnHeader}" Header="文件" infra:DataGridColumnHeaderHelpBehavior.Description="文件名；单元格复制使用完整原始路径。" Binding="{Binding FileName, Mode=OneWay}" Width="*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaPathText}"><Setter Property="ToolTip" Value="{Binding OriginalPath}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaLastColumnHeader}" Header="原因" infra:DataGridColumnHeaderHelpBehavior.Description="归类原因；建议仅表示预览结果，应用仍受安全门禁约束。" Binding="{Binding ClassificationReason, Mode=OneWay}" Width="1.1*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
