                        </DataGrid><TextBlock Text="当前没有需要处理的诊断项。&#xA;Worker、备份和媒体状态正常时，这里会保持为空。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Findings.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    </Border>
                    <ScrollViewer x:Name="MaintenanceAuditInspector" Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource GscInspectorScrollViewer}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <Border Padding="14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="问题详情" Style="{DynamicResource GscSectionTitleStyle}"/>
                                        <Border x:Name="AuditInspectorSeverity" HorizontalAlignment="Right" Padding="9,4">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedFinding.Severity}" Value="Info"><Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedFinding.Severity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedFinding.Severity}" Value="Error"><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedFinding.Severity}" Value="Critical"><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedFinding.SeverityDisplay, TargetNullValue=提示}" Foreground="{DynamicResource GscPrimaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedFinding.GameName, TargetNullValue=选择一条诊断项查看详情}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <TextBlock Text="{Binding SelectedFinding.Title, TargetNullValue=暂无标题}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <Border Style="{DynamicResource GscRedesignSubCard}" Padding="10" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedFinding.Detail, TargetNullValue=暂无详细说明}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Border>
                                    <Border Style="{DynamicResource GscDiagnosticHintBubble}" Padding="10" Margin="0,12,0,0"><TextBlock Style="{DynamicResource GscDiagnosticHintText}" Text="{Binding SelectedFinding.SuggestedAction, TargetNullValue=暂无建议处理方式}"/></Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding DataContext.CopyDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="复制诊断"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}"/>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                        </TabItem>
                        <TabItem Header="审计记录">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="最近审计" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource GscTableFrame}" ClipToBounds="True">
                                    <Grid>
                                        <DataGrid x:Name="MaintenanceAuditLogGrid" Style="{StaticResource MaintenanceDataGrid}" RowStyle="{StaticResource GscStableDataGridRow}" ItemsSource="{Binding Audit}" MinHeight="236">
                                            <DataGrid.Columns><DataGridTextColumn HeaderStyle="{StaticResource MaintenanceFirstColumnHeader}" Header="时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="112"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{StaticResource MaintenanceLastColumnHeader}" Header="消息" Binding="{Binding Message}" Width="*" MinWidth="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="暂无审计记录。&#xA;同步、备份和媒体操作完成后会在这里留下时间线。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Audit.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="进程映射">
                <Grid x:Name="MaintenanceProcessScrollSurface"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <Grid x:Name="MaintenanceProcessLayout" Margin="0,12,0,0" VerticalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <Border x:Name="ProcessMappingEditorSurface"
                            Grid.ColumnSpan="3"
                            Padding="12"
                            Style="{DynamicResource GscRedesignSectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="映射编辑器" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <TextBlock Text="无法识别的游戏进程 EXE 名映射" Style="{DynamicResource GscCaptionStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Grid x:Name="ProcessMappingEditor" Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition x:Name="ProcessMappingEditorPrimaryRow" Height="Auto"/><RowDefinition x:Name="ProcessMappingEditorCompactRow" Height="0"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProcessMappingExecutableColumn" Width="*"/><ColumnDefinition x:Name="ProcessMappingEditorGutterColumn" Width="8"/><ColumnDefinition x:Name="ProcessMappingTargetColumn" Width="240"/><ColumnDefinition x:Name="ProcessMappingActionGutterColumn" Width="8"/><ColumnDefinition x:Name="ProcessMappingActionColumn" Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ProcessMappingExecutableTextBox" Grid.Column="0" Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding ProcessMappingExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入 EXE 文件名，例如 skse64.exe" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ProcessMappingTargetGameComboBox" Grid.Column="2" Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding Games}" SelectedItem="{Binding ProcessMappingTargetGame}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <ui:Button x:Name="ProcessMappingSaveButton" Grid.Column="4" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SaveProcessMappingCommand}" Content="绑定" Margin="0,0,0,8"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="MaintenanceProcessTable" Grid.Row="1" Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GscTableFrame}">
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessMapping}" Value="{x:Null}">
                                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid><DataGrid x:Name="MaintenanceProcessGrid" Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding ProcessMappings}" SelectedItem="{Binding SelectedProcessMapping}"><DataGrid.Columns><DataGridTextColumn HeaderStyle="{StaticResource MaintenanceFirstColumnHeader}" Header="EXE" Binding="{Binding ExecutableName}" Width="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="目标游戏" Binding="{Binding GameName}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn HeaderStyle="{StaticResource MaintenanceLastColumnHeader}" Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DataContext.DeleteProcessMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="删除"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="暂无进程映射。&#xA;绑定 EXE 文件名后，MOD 启动器等进程会被识别为对应游戏。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProcessMappings.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    </Border>
                    <Border x:Name="MaintenanceProcessInspector" Grid.Row="1" Grid.Column="2" Padding="16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessMapping}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel><TextBlock Text="映射详情" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="进程映射只用于识别未知进程或 MOD 启动器，不会通过 UI 误杀游戏进程。" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><Separator Margin="0,14,0,12"/><TextBlock Text="EXE 文件名" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding SelectedProcessMapping.ExecutableName, TargetNullValue=尚未选择映射}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProcessMapping.ExecutableName}" Margin="0,4,0,0"/><TextBlock Text="目标游戏" Style="{DynamicResource GscCaptionStyle}" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedProcessMapping.GameName, TargetNullValue=尚未选择游戏}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProcessMapping.GameName}" Margin="0,4,0,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DeleteProcessMappingCommand}" CommandParameter="{Binding SelectedProcessMapping}" Content="删除选中映射" Margin="0,18,0,0" HorizontalAlignment="Left"/></StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
