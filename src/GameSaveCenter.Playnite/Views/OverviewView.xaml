<UserControl x:Class="GameSaveCenter.Playnite.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="OverviewEmptyText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="22"/>
            </Style>
            <Style x:Key="OverviewMetricActionButton"
                   TargetType="ui:Button"
                   BasedOn="{StaticResource GscWpfUiButton}">
                <Setter Property="Appearance" Value="Transparent"/>
                <Setter Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/>
                <!-- 与今日概览其它胶囊保持一致的中性描边；浅红底保留“需关注”语义。 -->
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ui:Button.CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <!-- 与同网格内其它胶囊一致：内容沿容器拉伸后自上而下排列，
                     避免按钮模板把内容顶到角落造成视觉错位。 -->
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
            </Style>
            <Style x:Key="OverviewStatCard" TargetType="Border" BasedOn="{StaticResource GscRedesignMetricBorder}">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="MinHeight" Value="76"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <EventSetter Event="MouseEnter" Handler="OnStatCardMouseEnter"/>
                <EventSetter Event="MouseLeave" Handler="OnStatCardMouseLeave"/>
            </Style>
            <Style x:Key="OverviewTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <!-- UiLab reading cards use a calm, evenly padded surface. Keep this local alias
                 for the overview only so the real task/backup data contracts remain intact. -->
            <Style x:Key="OverviewReadingCard" TargetType="Border" BasedOn="{StaticResource GscReadingCardStyle}">
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Style>
            <Style x:Key="OverviewActivityFrame" TargetType="Border" BasedOn="{StaticResource OverviewTableFrame}">
                <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <Style x:Key="OverviewTaskProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource GscProgressTrackBrush}"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Running">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OverviewHeaderFrame" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Margin" Value="6,0,6,8"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>
            <Style x:Key="GscActivityRowBorder" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="OverviewStackScrollSurface"
                  Style="{DynamicResource GscPageScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="False">
    <Grid x:Name="OverviewLayoutGrid" Margin="0,4,0,8" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OverviewPrimaryLayoutRow" Height="*"/>
            <RowDefinition x:Name="OverviewCompactSecondaryRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="OverviewPrimaryColumn" Width="*"/>
            <ColumnDefinition x:Name="OverviewGutterColumn" Width="14"/>
            <!-- The risk rail needs enough width for the Demo's game name, status,
                 explanation and action controls to remain readable at maximized size. -->
            <ColumnDefinition x:Name="OverviewSecondaryColumn" Width="410"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="OverviewPrimaryPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" MinWidth="0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- Keep the complete left workbench in one page-level scroll channel. This
                 prevents the hero, second metric row, or activity section from being
                 measured into a clipped sibling row at common window heights. The list
                 still owns its finite local viewport and Recycling virtualization. -->
            <Grid x:Name="OverviewPrimaryScrollSurface"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  VerticalAlignment="Top">
            <Grid x:Name="OverviewPrimaryFlow" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="OverviewStackedSecondaryRow" Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OverviewFlowPrimaryColumn" Width="*"/>
                <ColumnDefinition x:Name="OverviewFlowGutterColumn" Width="14"/>
                <ColumnDefinition x:Name="OverviewFlowSecondaryColumn" Width="410"/>
            </Grid.ColumnDefinitions>
             <Grid x:Name="OverviewHeroAndGameRow" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="OverviewHeroGameCompactRow" Height="0"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="OverviewHeroColumn" Width="1*"/><ColumnDefinition x:Name="OverviewHeroGameGutterColumn" Width="14"/><ColumnDefinition x:Name="OverviewCurrentGameColumn" Width="1*"/></Grid.ColumnDefinitions>
                <Border x:Name="OverviewTodayHeroCard" Grid.Row="0" Grid.Column="0" Style="{DynamicResource GscRedesignSectionCard}" MinHeight="205">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Demo HomeView hero carries a soft ambient glow behind the
                             TODAY headline; production uses theme-adaptive radial gradients
                             so the glow stays cheap while scrolling large libraries. -->
                        <Ellipse Width="230" Height="230" IsHitTestVisible="False" Opacity="0.85" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-112,-112,0,0">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource GscAccentShadowColor}"/><GradientStop Offset="1" Color="Transparent"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="230" Height="230" IsHitTestVisible="False" Opacity="0.85" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-112,-86,0">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource GscInfoShadowColor}"/><GradientStop Offset="1" Color="Transparent"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="230" Height="230" IsHitTestVisible="False" Opacity="0.85" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-86,-112">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource GscSuccessShadowColor}"/><GradientStop Offset="1" Color="Transparent"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Row="0" MinWidth="0" VerticalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource GscRedesignHeroEyebrow}" Text="TODAY"/>
                            <TextBlock FontSize="35" FontWeight="SemiBold" Margin="0,8,0,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="存在需要处理的项目"/><Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Text" Value="整体状态安全"/><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="False"><Setter Property="Text" Value="Worker 异常"/><Setter Property="Foreground" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="本地备份始终是主副本；下方胶囊显示 Worker、云端与媒体的实时状态。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0">
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Fill" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Worker 异常"/><Setter Property="Foreground" Value="{DynamicResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Text" Value="Worker 正常"/><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource GscMutedStatusBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.LudusaviAvailable}" Value="True"><Setter Property="Fill" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Ludusavi 不可用"/><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.LudusaviAvailable}" Value="True"><Setter Property="Text" Value="Ludusavi 可用"/><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            <!-- 单胶囊承载“无需处理/N 项需处理”两种状态，避免互斥双胶囊产生空边框。 -->
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource GscWarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Fill" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding Snapshot.WarningGames, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/><Run Text=" 项需处理"/></TextBlock><TextBlock FontSize="11" Foreground="{DynamicResource GscSuccessBrush}" Text="无需处理"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource GscInfoBrush}"/><TextBlock FontSize="11" Foreground="{DynamicResource GscInfoBrush}"><Run Text="云端队列 "/><Run Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource GscSecondaryTextBrush}"/><TextBlock FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"><Run Text="待归类媒体 "/><Run Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/></TextBlock></StackPanel></Border>
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border x:Name="OverviewCurrentGameCard" Grid.Row="0" Grid.Column="2" Style="{DynamicResource GscRedesignSectionCard}" Padding="16" MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource GscSelectedGameIconControl}" Content="{Binding SelectedGameIcon}"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="11,0,0,0" MinWidth="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel MinWidth="0" VerticalAlignment="Center">
                                <TextBlock Text="当前游戏" Foreground="{DynamicResource GscAccentBrush}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedGame.Name, Mode=OneWay, TargetNullValue=请选择游戏}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Name, Mode=OneWay}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.HealthReasonDisplay, Mode=OneWay}"><Run Text="{Binding SelectedGame.PlatformDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="OverviewMetricPanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,6,6"><StackPanel><TextBlock Text="版本" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.BackupVersionCount, Mode=OneWay}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"/></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,6,6"><StackPanel><TextBlock Text="媒体" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"><Run Text="{Binding SelectedGame.MediaCount, Mode=OneWay}"/><Run Text=" 项"/></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,6,6"><StackPanel><TextBlock Text="云端" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.CloudStateDisplay, Mode=OneWay}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,0,6"><StackPanel><TextBlock Text="最新备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.LastBackupLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}, TargetNullValue=暂无}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"/></StackPanel></Border>
                        </WrapPanel>
                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Appearance="Primary" Command="{Binding BackupSelectedCommand}" Content="立即备份" MinHeight="38" MinWidth="88" Margin="0,0,4,4" VerticalAlignment="Center"/>
                            <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding LoadDetailsCommand}" Content="刷新详情" MinHeight="38" MinWidth="88" Margin="0,0,4,4" VerticalAlignment="Center"/>
                            <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" AutomationProperties.Name="查看需要关注的游戏、原因和建议处理方式" Command="{Binding OpenAttentionCenterCommand}" Content="查看需关注项" MinHeight="38" MinWidth="88" Margin="0,0,4,4" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Keep the Demo HomeView reading order: current context first, then the
                 six equal-height metrics. Production keeps real Snapshot counters and
                 a static one-line explanation per card; no demo placeholder numbers. -->
             <UniformGrid x:Name="OverviewStatStrip" Grid.Row="1" Grid.ColumnSpan="3" Columns="6" Margin="0,0,0,12">
                <Border Style="{StaticResource OverviewStatCard}" Margin="0,0,6,6"><StackPanel><TextBlock Text="已管理游戏" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Snapshot.ManagedGames, Mode=OneWay}" Foreground="{DynamicResource GscInfoBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="来自 Playnite 游戏库" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource OverviewStatCard}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="已匹配存档" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Snapshot.MatchedGames, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding Snapshot.MatchedGames, Mode=OneWay}" Maximum="{Binding Snapshot.ManagedGames, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.ManagedGames}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="已匹配到 Ludusavi 存档路径" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OverviewStatCard}" Margin="0,0,0,6"><StackPanel><TextBlock Text="正在运行" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Snapshot.RunningGames, Mode=OneWay}" Foreground="{DynamicResource GscSuccessBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="运行中游戏按策略周期备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource OverviewStatCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="需要注意" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Snapshot.WarningGames, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ProgressBar Height="4" Margin="0,8,0,0" Foreground="{DynamicResource GscWarningBrush}" Value="{Binding Snapshot.WarningGames, Mode=OneWay}" Maximum="{Binding Snapshot.ManagedGames, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.ManagedGames}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="健康 "/><Run Text="{Binding Snapshot.HealthyGames, Mode=OneWay}"/><Run Text=" · 注意 "/><Run Text="{Binding Snapshot.AttentionGames, Mode=OneWay}"/><Run Text=" · 风险 "/><Run Text="{Binding Snapshot.RiskGames, Mode=OneWay}"/><Run Text=" · 未知 "/><Run Text="{Binding Snapshot.UnknownGames, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OverviewStatCard}" Margin="0,0,6,0"><StackPanel><TextBlock Text="云端队列" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay}" Foreground="{DynamicResource GscInfoBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="失败不会撤销本地备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource OverviewStatCard}" Margin="0"><StackPanel><TextBlock Text="待归类媒体" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="来自共享截图目录" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
             </UniformGrid>

              <!-- The risk rail spans the recent-task and global-activity area. Keep
                   the two left cards in their own top-aligned column so the taller
                   right rail cannot stretch the recent-task card and leave a blank
                   gap below its finite list. -->
              <Grid x:Name="OverviewActivityColumn"
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    MinHeight="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border x:Name="OverviewRecentActivityCard" Grid.Row="0" Style="{StaticResource OverviewReadingCard}" Margin="0,0,0,14" MinHeight="0">
                <Grid>
                    <!-- The recent-task frame must follow the real item count. A fixed
                         second row makes a short list look like an empty oversized card
                         after the risk rail changes height. Keep a readable minimum and
                         cap only the list itself so larger histories scroll locally. -->
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource GscRedesignSectionTitle}" Text="最近任务"/>
                        <TextBlock Grid.Column="1" Text="{Binding OverviewTasks.Count, StringFormat=全部 {0} 个}" Style="{DynamicResource GscRedesignSectionSubtitle}" Foreground="{DynamicResource GscAccentBrush}" TextElement.Foreground="{DynamicResource GscAccentBrush}" FontSize="13" FontWeight="SemiBold" Opacity="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="最近任务数量"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource OverviewActivityFrame}" MinHeight="176">
                        <Grid>
                            <!-- Demo HomeView renders recent activity as icon-tile cards
                                 instead of a table. Each real task keeps its semantic
                                 status color on the 34x34 tile and stays selectable so the
                                 existing SelectedTask cross-page detail linkage is intact.
                                 The shared ListBox contract keeps local scrolling and
                                 Recycling virtualization on the capped 8-row list. -->
                            <ListBox x:Name="OverviewActivityList" ItemsSource="{Binding OverviewTasks}" SelectedItem="{Binding SelectedTask}" HorizontalContentAlignment="Stretch" MinHeight="168" MaxHeight="420" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="74"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                            <Border x:Name="OverviewTaskStatusPill" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GscAccentTintStrongBrush}" BorderBrush="{DynamicResource GscAccentTintStrongBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock x:Name="RecentActivityGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="0">
                                                <Grid MinWidth="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" MinWidth="0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TaskTypeDisplay, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskTypeDisplay, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding GameName, Mode=OneWay, TargetNullValue=全局}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                                    </Grid>
                                                </Grid>
                                                <Grid Margin="0,3,0,0" MinWidth="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DetailMessage, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailMessage}" VerticalAlignment="Center"/>
                                                    <ProgressBar x:Name="OverviewTaskProgressBar" Grid.Column="1" Style="{StaticResource OverviewTaskProgressBar}" Width="150" Margin="10,0,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                            <Border x:Name="OverviewTaskResultChip" Grid.Column="3" Style="{DynamicResource GscRedesignContextPill}" Padding="6,2" MinWidth="56" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="OverviewTaskResultText" Text="{Binding StateDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateDisplay, Mode=OneWay}"/>
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Text" Value="&#xE895;"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Foreground" Value="{DynamicResource GscMutedStatusBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscMutedStatusBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="暂无任务记录&#x0a;完成备份、同步或维护操作后会显示在这里。" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverviewEmptyText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverviewTasks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
             </Border>
             </Grid>
             </Border>
              <Border Grid.Row="1" Style="{StaticResource OverviewReadingCard}" Margin="0,0,0,14" MinHeight="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{DynamicResource GscRedesignSectionTitle}" Text="全局活动"/><TextBlock Style="{DynamicResource GscRedesignSectionSubtitle}" Text="备份、恢复、云端、媒体、工具、健康、冲突、完整性与仓库修复事件" Margin="0,4,0,0"/></StackPanel>
                        <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding RefreshCommand}" Content="刷新"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource OverviewActivityFrame}">
                        <Grid>
                            <ItemsControl x:Name="OverviewActivityTimelineList" ItemsSource="{Binding Activities}" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GscActivityRowBorder}">
                                        <Grid MinHeight="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ActivityKindPill" MinWidth="52" MinHeight="22" CornerRadius="9" Background="{DynamicResource GscAccentTintStrongBrush}" BorderBrush="{DynamicResource GscAccentBrush}" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,2">
                                                <TextBlock x:Name="ActivityKindChipText" Text="{Binding KindDisplay, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindDisplay, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock Text="{Binding GameName, Mode=OneWay, TargetNullValue=全局}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                                <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="ActivityResultChip" Grid.Column="2" Style="{DynamicResource GscRedesignContextPill}" Background="{DynamicResource GscInfoIconFillBrush}" BorderBrush="{DynamicResource GscInfoBrush}" BorderThickness="0" Padding="6,2" MinWidth="56" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="ActivityResultChipText" Text="{Binding ResultDisplay, Mode=OneWay}" Foreground="{DynamicResource GscInfoBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultDisplay, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border>
                                            <TextBlock Grid.Column="3" Text="{Binding CreatedDisplay, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,20,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CreatedDisplay, Mode=OneWay}"/>
                                        </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Compact">
                                                <Setter TargetName="ActivityKindPill" Property="Width" Value="52"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="Failed">
                                                <Setter TargetName="ActivityKindPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="ActivityKindPill" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                <Setter TargetName="ActivityResultChipText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="Warning">
                                                <Setter TargetName="ActivityKindPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="ActivityKindPill" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                <Setter TargetName="ActivityResultChipText" Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="Succeeded">
                                                <Setter TargetName="ActivityKindPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="ActivityKindPill" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                <Setter TargetName="ActivityResultChipText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:WorkspaceStatePresenter State="Empty" Title="暂无全局活动" Message="备份、同步、维护或健康事件完成后会显示在这里。" IsHitTestVisible="False">
                                <ui:WorkspaceStatePresenter.Style>
                                    <Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activities.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:WorkspaceStatePresenter.Style>
                            </ui:WorkspaceStatePresenter>
                        </Grid>
                    </Border>
                </Grid>
             </Border>
             </Grid>

        <Grid x:Name="OverviewSecondaryScrollViewer"
              Grid.Row="2"
              Grid.RowSpan="2"
              Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              MinHeight="0">
        <Grid x:Name="OverviewSecondaryPanel" MinWidth="0" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition x:Name="OverviewSummaryRow" Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Match the Demo's right rail: a compact risk card followed by an explicit
                 attention card. The content remains real and actionable; only the grouping
                 changes so the page reads like the reference instead of an admin dashboard. -->
            <Border x:Name="OverviewRiskCard" Grid.Row="0" Style="{StaticResource OverviewReadingCard}" VerticalAlignment="Top" MinWidth="360">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource GscRedesignSectionTitle}" Text="风险与提醒"/>
                        <TextBlock Style="{DynamicResource GscRedesignSectionSubtitle}" Text="最近 30 天游玩过的游戏" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="OverviewRiskViewport"
                                  Grid.Row="1"
                                  Style="{DynamicResource GscPageScrollViewer}"
                                  MaxHeight="620"
                                  Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  AutomationProperties.Name="风险与提醒列表">
                      <StackPanel x:Name="OverviewRiskScrollViewer">
                        <ItemsControl x:Name="OverviewProtectionPreviewItems"
                                      ItemsSource="{Binding RecentProtection.Items}"
                                      AutomationProperties.Name="最近游玩游戏保护状态">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource GscControlFillBrush}"
                                            BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8"
                                            Margin="0,0,0,6">
                                        <Grid MinWidth="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="OverviewProtectionPreviewDot" Width="8" Height="8" Fill="{DynamicResource GscWarningBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <StackPanel Grid.Column="1" MinWidth="0">
                                                <Grid MinWidth="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GameName, Mode=OneWay}"/>
                                                    <Border Grid.Column="1" x:Name="OverviewProtectionPreviewStatusPill"
                                                            Background="{DynamicResource GscSafetyFillBrush}"
                                                            BorderBrush="{DynamicResource GscWarningBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock x:Name="OverviewProtectionPreviewStatusText"
                                                                   Text="{Binding StatusDisplay, Mode=OneWay}"
                                                                   Foreground="{DynamicResource GscWarningBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding StatusDisplay, Mode=OneWay}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail, Mode=OneWay}"
                                                           Foreground="{DynamicResource GscSecondaryTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Detail, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProtected, Mode=OneWay}" Value="True">
                                            <Setter TargetName="OverviewProtectionPreviewDot" Property="Fill" Value="{DynamicResource GscSuccessBrush}"/>
                                            <Setter TargetName="OverviewProtectionPreviewStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                            <Setter TargetName="OverviewProtectionPreviewStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                            <Setter TargetName="OverviewProtectionPreviewStatusText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="OverviewLegacyRiskContent" Visibility="Collapsed">
                        <Border Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscSafetyStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{DynamicResource GscWarningBrush}" FontSize="17" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="安全恢复提示" FontWeight="SemiBold"/>
                                    <TextBlock Text="恢复始终需要人工确认，并会先创建当前快照。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource GscRedesignSubCard}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" Foreground="{DynamicResource GscWarningBrush}" FontSize="17" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding RecentProtection.WindowLabel, Mode=OneWay}"/><Run Text="玩过的游戏"/></TextBlock>
                                    <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"><Run Text="共 "/><Run Text="{Binding RecentProtection.RecentlyPlayedGames, Mode=OneWay}"/><Run Text=" 个 · 已保护 "/><Run Text="{Binding RecentProtection.ProtectedGames, Mode=OneWay}"/><Run Text=" 个 · 需处理 "/><Run Text="{Binding RecentProtection.AttentionGames, Mode=OneWay}"/><Run Text=" 个"/></TextBlock>
                                    <!-- Keep the Demo's game-level risk cards visible in the
                                         bounded risk viewport. Selection and safe commands
                                         remain in the disclosure below, so this preview is
                                         read-only and cannot accidentally execute an action. -->
                                     <ItemsControl x:Name="OverviewLegacyProtectionPreviewItems"
                                                   ItemsSource="{Binding RecentProtection.Items}"
                                                   Margin="0,10,0,0"
                                                   AutomationProperties.Name="最近游玩游戏保护状态">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <!-- The expanded list is the readable, actionable view. Do not make
                                                         the same games occupy the rail twice while the disclosure is open. -->
                                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=OverviewProtectionDisclosure}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="OverviewProtectionPreviewCard"
                                                        Background="{DynamicResource GscControlFillBrush}"
                                                        BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="9,8"
                                                        Margin="0,0,0,7">
                                                    <Grid MinWidth="0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="OverviewProtectionPreviewDot" Width="8" Height="8" Fill="{DynamicResource GscWarningBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <Grid MinWidth="0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GameName, Mode=OneWay}"/>
                                                                <Border Grid.Column="1" x:Name="OverviewProtectionPreviewStatusPill" Style="{DynamicResource GscRedesignContextPill}" Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscWarningBrush}" Padding="8,3" MinWidth="76" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                                    <TextBlock x:Name="OverviewProtectionPreviewStatusText" Text="{Binding StatusDisplay, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDisplay, Mode=OneWay}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected, Mode=OneWay}" Value="True">
                                                        <Setter TargetName="OverviewProtectionPreviewDot" Property="Fill" Value="{DynamicResource GscSuccessBrush}"/>
                                                        <Setter TargetName="OverviewProtectionPreviewStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                        <Setter TargetName="OverviewProtectionPreviewStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                        <Setter TargetName="OverviewProtectionPreviewStatusText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel x:Name="OverviewLegacyProtectionActions" Margin="0,10,0,0">
                                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding OpenProtectionGamesCommand}" Content="查看需要处理的游戏" MinHeight="38" MinWidth="128" Margin="0,0,6,6" AutomationProperties.Name="查看最近游玩但未受保护的游戏"/>
                                        <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding ApplyRecommendedProtectionCommand}" Content="启用所选保护" MinHeight="38" MinWidth="128" Margin="0,0,0,6" AutomationProperties.Name="为所选最近游玩游戏启用推荐保护"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,1,0,0">
                                        <Border Style="{DynamicResource GscRedesignContextPill}" Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscControlStrokeBrush}" Margin="0,0,6,6" Padding="8,3"><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}"><Run Text="未识别存档 "/><Run Text="{Binding RecentProtection.UnrecognizedSaveGames, Mode=OneWay}"/></TextBlock></Border>
                                        <Border Style="{DynamicResource GscRedesignContextPill}" Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscWarningBrush}" Margin="0,0,6,6" Padding="8,3"><TextBlock Foreground="{DynamicResource GscWarningBrush}"><Run Text="需要处理 "/><Run Text="{Binding RecentProtection.AttentionGames, Mode=OneWay}"/></TextBlock></Border>
                                    </WrapPanel>
                                    <Expander x:Name="OverviewProtectionDisclosure" Style="{StaticResource GscDisclosureCard}" Header="展开最近游戏保护明细" Margin="0,5,0,0">
                                        <StackPanel Margin="0,4,0,0">
                                            <ScrollViewer x:Name="OverviewProtectionItemsScrollViewer"
                                                           Style="{DynamicResource GscPageScrollViewer}"
                                                           MaxHeight="380"
                                                           Margin="0,0,0,6"
                                                           VerticalScrollBarVisibility="Auto"
                                                           HorizontalScrollBarVisibility="Disabled"
                                                           CanContentScroll="False"
                                                           AutomationProperties.Name="最近游戏保护明细列表">
                                             <ItemsControl x:Name="OverviewProtectionItems"
                                                           ItemsSource="{Binding RecentProtection.Items}"
                                                           Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                         <!-- Use a vertical detail card instead of squeezing the game,
                                                              status, explanation and action into one narrow line. This
                                                              keeps the disclosure readable in the fixed side rail. -->
                                                        <Border Background="{DynamicResource GscControlFillBrush}"
                                                                BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="10"
                                                                Margin="0,0,0,8">
                                                            <Grid MinWidth="0">
                                                                 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                 <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                 <CheckBox Grid.RowSpan="4" Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0" AutomationProperties.Name="选择此游戏"/>
                                                                 <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GameName}" VerticalAlignment="Center"/>
                                                                 <Border Grid.Row="1" Grid.Column="1" x:Name="OverviewProtectionStatusPill" Style="{DynamicResource GscRedesignContextPill}" Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscWarningBrush}" Margin="0,6,0,0" Padding="8,3" MinWidth="76" HorizontalAlignment="Left">
                                                                     <TextBlock x:Name="OverviewProtectionStatusText" Text="{Binding StatusDisplay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDisplay}"/>
                                                                 </Border>
                                                                 <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"><Run Text="{Binding Title, Mode=OneWay}"/><Run Text="："/><Run Text="{Binding Detail, Mode=OneWay}"/></TextBlock>
                                                                 <ui:Button Grid.Row="3" Grid.Column="1" Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding DataContext.OpenProtectionItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="查看" IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Right" Margin="0,8,0,0" AutomationProperties.Name="查看此游戏的保护详情"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Text="条目过多时只在此列表内滚动；选择游戏不会自动执行备份或恢复。" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource GscRedesignSubCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource GscInfoBrush}" FontSize="17" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="云端失败不会撤销本地备份" FontWeight="SemiBold"/><TextBlock Text="本地副本始终为主副本，失败任务可在任务中心诊断和重试。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                    <WrapPanel x:Name="OverviewProtectionActions" Grid.Row="2" Margin="0,8,0,0">
                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding OpenProtectionGamesCommand}" Content="查看需要处理的游戏" MinHeight="34" MinWidth="128" Margin="0,0,6,0" AutomationProperties.Name="查看最近游玩但未受保护的游戏"/>
                        <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding ApplyRecommendedProtectionCommand}" Content="启用所选保护" MinHeight="34" MinWidth="128" AutomationProperties.Name="为所选最近游玩游戏启用推荐保护"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="OverviewFindingsCard" Grid.Row="1" Style="{StaticResource OverviewReadingCard}" Margin="0,14,0,0" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource GscRedesignSectionTitle}" Text="需关注事项"/>
                    <ScrollViewer x:Name="OverviewAttentionScrollViewer"
                                                  Grid.Row="1"
                                                  Style="{DynamicResource GscPageScrollViewer}"
                                                  MaxHeight="190"
                                                  Margin="0,10,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  AutomationProperties.Name="需要关注的游戏列表">
                         <ItemsControl ItemsSource="{Binding AttentionFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9">
                                        <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border x:Name="AttentionFindingIcon" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GscWarningIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock x:Name="AttentionFindingGlyph" Text="!" FontWeight="Bold" Foreground="{DynamicResource GscWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                            <TextBlock Text="{Binding GameName, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding DataContext.OpenAttentionFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="查看原因" VerticalAlignment="Center" AutomationProperties.Name="查看关注原因"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="AttentionFindingIcon" Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/><Setter TargetName="AttentionFindingGlyph" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter TargetName="AttentionFindingIcon" Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/><Setter TargetName="AttentionFindingGlyph" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                         </ScrollViewer>
                    <ui:Button Grid.Row="2" Style="{DynamicResource GscWpfUiPrimaryButton}" AutomationProperties.Name="打开维护中心查看完整关注详情" ToolTip="点击查看需要关注的游戏、原因和建议处理方式" Command="{Binding OpenAttentionCenterCommand}" Content="打开维护中心" HorizontalAlignment="Right" MinWidth="140" Margin="0,3,0,0"/>
                </Grid>
            </Border>
        </Grid>
         </Grid>
         </Grid>
         </Grid>
         </Grid>
         </Grid>
    </ScrollViewer>
</UserControl>
