<UserControl x:Class="GameSaveCenter.Playnite.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             FontFamily="{DynamicResource GscUiFontFamily}"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="OverviewEmptyText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="22"/>
            </Style>
            <!-- Demo HomeView typography. Keep these aliases local to the overview so
                 production pages that still use their own density are not changed by a
                 homepage-only correction. -->
            <Style x:Key="OverviewDemoSectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource GscSectionFontSize}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="OverviewDemoCaption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource GscCaptionFontSize}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="OverviewFindingActionButton"
                   TargetType="ui:Button"
                   BasedOn="{StaticResource GscWpfUiCompactButton}">
                <!-- The Demo uses a real compact secondary button for the maintenance
                     entry. Keeping the chrome visible also prevents the empty-state action
                     from looking like an unstyled hyperlink. -->
                <Setter Property="Appearance" Value="Secondary"/>
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
                <Setter Property="ui:Button.CornerRadius" Value="10"/>
            </Style>
            <Style x:Key="OverviewMetricActionButton"
                   TargetType="ui:Button"
                   BasedOn="{StaticResource GscWpfUiButton}">
                <Setter Property="Appearance" Value="Transparent"/>
                <Setter Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/>
                <!-- 与今日概览其它胶囊保持一致的中性描边；浅红底保留“需关注”语义。 -->
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ui:Button.CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <!-- 与同网格内其它胶囊一致：内容沿容器拉伸后自上而下排列，
                     避免按钮模板把内容顶到角落造成视觉错位。 -->
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
            </Style>
            <Style x:Key="OverviewStatCard" TargetType="Border" BasedOn="{StaticResource GscRedesignMetricBorder}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,2"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <EventSetter Event="MouseEnter" Handler="OnStatCardMouseEnter"/>
                <EventSetter Event="MouseLeave" Handler="OnStatCardMouseLeave"/>
            </Style>
            <Style x:Key="OverviewTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <!-- UiLab reading cards use a calm, evenly padded surface. Keep this local alias
                 for the overview only so the real task/backup data contracts remain intact. -->
            <Style x:Key="OverviewReadingCard" TargetType="Border" BasedOn="{StaticResource GscReadingCardStyle}">
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Style>
            <Style x:Key="OverviewActivityFrame" TargetType="Border" BasedOn="{StaticResource OverviewTableFrame}">
                <!-- Activity rows are a finite reading surface. An opaque control fill is
                     intentional here: the old glass brush made the rows look black and
                     allowed the host background to show through between them. -->
                <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <Style x:Key="OverviewRecentTaskItemStyle" TargetType="ListBoxItem">
                <!-- The Demo uses a quiet row surface: only the selected task receives a
                     filled accent treatment; the remaining rows are separated by one line. -->
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="54"/>
                <Setter Property="MinHeight" Value="54"/>
                <Setter Property="MaxHeight" Value="54"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TaskItemChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TaskItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                    <Setter TargetName="TaskItemChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                    <Setter TargetName="TaskItemChrome" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="TaskItemChrome" Property="CornerRadius" Value="14"/>
                                    <Setter TargetName="TaskItemChrome" Property="Margin" Value="4,2"/>
                                    <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OverviewProtectionItemContainerStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{DynamicResource GscUiFontFamily}"
                                              TextElement.FontSize="{DynamicResource GscBodyFontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              RecognizesAccessKey="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OverviewTaskProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource GscProgressTrackBrush}"/>
                <Setter Property="Height" Value="7"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Running">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OverviewHeaderFrame" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Margin" Value="6,0,6,8"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>
            <Style x:Key="GscActivityRowBorder" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="OverviewStackScrollSurface"
                  Style="{DynamicResource GscPageScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="False">
    <!-- ScrollViewer measures its child with an unbounded horizontal constraint when
         horizontal scrolling is disabled. Bind the page flow to the finite viewport so
         star columns cannot grow to their desired width and push the current-game card
         and its real actions outside the host window. -->
    <Grid x:Name="OverviewLayoutGrid"
          Width="{Binding ViewportWidth, ElementName=OverviewStackScrollSurface}"
          Margin="0,4,0,8"
          MinWidth="0"
          MinHeight="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OverviewPrimaryLayoutRow" Height="*"/>
            <RowDefinition x:Name="OverviewCompactSecondaryRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="OverviewPrimaryColumn" Width="*"/>
            <ColumnDefinition x:Name="OverviewGutterColumn" Width="14"/>
            <!-- The risk rail needs enough width for the Demo's game name, status,
                 explanation and action controls to remain readable at maximized size. -->
            <ColumnDefinition x:Name="OverviewSecondaryColumn" Width="410"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="OverviewPrimaryPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" MinWidth="0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- Keep the complete left workbench in one page-level scroll channel. This
                 prevents the hero, second metric row, or activity section from being
                 measured into a clipped sibling row at common window heights. The list
                 still owns its finite local viewport and Recycling virtualization. -->
            <Grid x:Name="OverviewPrimaryScrollSurface"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  VerticalAlignment="Top">
            <Grid x:Name="OverviewPrimaryFlow" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="OverviewStackedSecondaryRow" Height="0"/><RowDefinition x:Name="OverviewCompactSecondaryContentRow" Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OverviewFlowPrimaryColumn" Width="*"/>
                <ColumnDefinition x:Name="OverviewFlowGutterColumn" Width="14"/>
                <ColumnDefinition x:Name="OverviewFlowSecondaryColumn" Width="410"/>
            </Grid.ColumnDefinitions>
            <!-- Auxiliary batch/environment actions stay available, but the real page
                 hierarchy starts with current state and the selected game. -->
            <Border x:Name="OverviewHomeToolbar" Grid.Row="2" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="OverviewHomeToolbarActionsRow" Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel MinWidth="0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource GscRedesignSectionTitle}" Text="今日工作台"/>
                        <TextBlock Style="{DynamicResource GscRedesignSectionSubtitle}" Text="全局批量命令保留在首页，不与单游戏操作混在一起。" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel x:Name="OverviewHomeToolbarActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding RefreshCommand}" Content="刷新" MinWidth="72"/>
                        <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding BackupAllCommand}" Content="全部备份" Margin="8,0,0,0" MinWidth="92"/>
                        <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding SyncMediaCommand}" Content="同步媒体" Margin="8,0,0,0" MinWidth="92"/>
                        <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding OpenAttentionCenterCommand}" Content="查看需关注项" Margin="8,0,0,0" MinWidth="116" AutomationProperties.Name="查看需要关注的游戏、原因和建议处理方式"/>
                    </WrapPanel>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="12" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GscRedesignInfoBand}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnboardingPending}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="首次环境检查尚未完成" FontWeight="SemiBold"/>
                                <TextBlock Text="首页仍可正常使用；开始检查后会打开维护中心完成环境准备。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiPrimaryButton}" Command="{Binding OpenMaintenanceCommand}" Content="开始环境检查" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
             <Grid x:Name="OverviewHeroAndGameRow" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="OverviewHeroGameCompactRow" Height="0"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="OverviewHeroColumn" Width="1*"/><ColumnDefinition x:Name="OverviewHeroGameGutterColumn" Width="14"/><ColumnDefinition x:Name="OverviewCurrentGameColumn" Width="1*"/></Grid.ColumnDefinitions>
                <Border x:Name="OverviewTodayHeroCard" Grid.Row="0" Grid.Column="0" Style="{DynamicResource GscRedesignSectionCard}" MinHeight="205">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Demo HomeView hero carries a soft ambient glow behind the
                             TODAY headline; production uses theme-adaptive radial gradients
                             so the glow stays cheap while scrolling large libraries. -->
                        <Ellipse Width="230" Height="230" IsHitTestVisible="False" Opacity="0.85" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-112,-112,0,0">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource GscAccentShadowColor}"/><GradientStop Offset="1" Color="Transparent"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="230" Height="230" IsHitTestVisible="False" Opacity="0.85" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-112,-86,0">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource GscInfoShadowColor}"/><GradientStop Offset="1" Color="Transparent"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="230" Height="230" IsHitTestVisible="False" Opacity="0.85" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-86,-112">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource GscSuccessShadowColor}"/><GradientStop Offset="1" Color="Transparent"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Row="0" MinWidth="0" VerticalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource GscRedesignHeroEyebrow}" Text="TODAY"/>
                            <TextBlock FontSize="35" FontWeight="SemiBold" Margin="0,8,0,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="存在需要处理的项目"/><Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Text" Value="整体状态安全"/><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="False"><Setter Property="Text" Value="Worker 异常"/><Setter Property="Foreground" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="本地备份始终是主副本；下方胶囊显示 Worker、云端与媒体的实时状态。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0">
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Fill" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Worker 异常"/><Setter Property="Foreground" Value="{DynamicResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Text" Value="Worker 正常"/><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource GscMutedStatusBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.LudusaviAvailable}" Value="True"><Setter Property="Fill" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Ludusavi 不可用"/><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.LudusaviAvailable}" Value="True"><Setter Property="Text" Value="Ludusavi 可用"/><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            <!-- 单胶囊承载“无需处理/N 项需处理”两种状态，避免互斥双胶囊产生空边框。 -->
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource GscWarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Fill" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding Snapshot.WarningGames, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/><Run Text=" 项需处理"/></TextBlock><TextBlock FontSize="11" Foreground="{DynamicResource GscSuccessBrush}" Text="无需处理"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource GscInfoBrush}"/><TextBlock FontSize="11" Foreground="{DynamicResource GscInfoBrush}"><Run Text="云端队列 "/><Run Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource GscSecondaryTextBrush}"/><TextBlock FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"><Run Text="待归类媒体 "/><Run Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"/></TextBlock></StackPanel></Border>
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border x:Name="OverviewCurrentGameCard" Grid.Row="0" Grid.Column="2" Style="{DynamicResource GscRedesignSectionCard}" Padding="16" MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource GscSelectedGameIconControl}" Content="{Binding SelectedGameIcon}"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="11,0,0,0" MinWidth="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel MinWidth="0" VerticalAlignment="Center">
                                <TextBlock Text="当前游戏" Foreground="{DynamicResource GscAccentBrush}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedGame.Name, Mode=OneWay, TargetNullValue=请选择游戏}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Name, Mode=OneWay}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.HealthReasonDisplay, Mode=OneWay}"><Run Text="{Binding SelectedGame.PlatformDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="OverviewMetricPanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,6,6"><StackPanel><TextBlock Text="版本" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.BackupVersionCount, Mode=OneWay}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"/></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,6,6"><StackPanel><TextBlock Text="媒体" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"><Run Text="{Binding SelectedGame.MediaCount, Mode=OneWay}"/><Run Text=" 项"/></TextBlock></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,6,6"><StackPanel><TextBlock Text="云端" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.CloudStateDisplay, Mode=OneWay}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignContextPill}" Margin="0,0,0,6"><StackPanel><TextBlock Text="最新备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.LastBackupLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}, TargetNullValue=暂无}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"/></StackPanel></Border>
                        </WrapPanel>
                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Appearance="Primary" Command="{Binding BackupSelectedCommand}" Content="立即备份" MinWidth="88" Margin="0,0,4,4" VerticalAlignment="Center"/>
                            <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding LoadDetailsCommand}" Content="刷新详情" MinWidth="88" Margin="0,0,4,4" VerticalAlignment="Center"/>
                            <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" AutomationProperties.Name="查看需要关注的游戏、原因和建议处理方式" Command="{Binding OpenAttentionCenterCommand}" Content="查看需关注项" MinWidth="88" Margin="0,0,4,4" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Keep the Demo HomeView reading order: current context first, then one
                 continuous six-metric strip. Production keeps real Snapshot counters and
                 ratio bars; no demo placeholder numbers. -->
             <Border x:Name="OverviewStatStrip" Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="6,14" MinHeight="84" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource OverviewStatCard}"><StackPanel><TextBlock Text="{Binding Snapshot.ManagedGames, Mode=OneWay}" Foreground="{DynamicResource GscInfoBrush}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="已管理游戏" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="来自 Playnite 游戏库" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource GscTableDividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                <Border Grid.Column="2" Style="{StaticResource OverviewStatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Snapshot.MatchedGames, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="已匹配存档" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        <ProgressBar Height="4" Margin="0,6,0,0" Value="{Binding Snapshot.MatchedGames, Mode=OneWay}" Maximum="{Binding Snapshot.ManagedGames, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.ManagedGames}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="已匹配到 Ludusavi 存档路径" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource GscTableDividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                <Border Grid.Column="4" Style="{StaticResource OverviewStatCard}"><StackPanel><TextBlock Text="{Binding Snapshot.RunningGames, Mode=OneWay}" Foreground="{DynamicResource GscSuccessBrush}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="正在运行" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="运行中游戏按策略周期备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource GscTableDividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                <Border Grid.Column="6" Style="{StaticResource OverviewStatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Snapshot.WarningGames, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="需要注意" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        <ProgressBar Height="4" Margin="0,6,0,0" Foreground="{DynamicResource GscWarningBrush}" Value="{Binding Snapshot.WarningGames, Mode=OneWay}" Maximum="{Binding Snapshot.ManagedGames, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.ManagedGames}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="健康 "/><Run Text="{Binding Snapshot.HealthyGames, Mode=OneWay}"/><Run Text=" · 注意 "/><Run Text="{Binding Snapshot.AttentionGames, Mode=OneWay}"/><Run Text=" · 风险 "/><Run Text="{Binding Snapshot.RiskGames, Mode=OneWay}"/><Run Text=" · 未知 "/><Run Text="{Binding Snapshot.UnknownGames, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
                <Rectangle Grid.Column="7" Width="1" Fill="{DynamicResource GscTableDividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                <Border Grid.Column="8" Style="{StaticResource OverviewStatCard}"><StackPanel><TextBlock Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay}" Foreground="{DynamicResource GscInfoBrush}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="云端队列" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="失败不会撤销本地备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Rectangle Grid.Column="9" Width="1" Fill="{DynamicResource GscTableDividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                <Border Grid.Column="10" Style="{StaticResource OverviewStatCard}"><StackPanel><TextBlock Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}" Foreground="{DynamicResource GscWarningBrush}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="待归类媒体" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="来自共享截图目录" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid>
             </Border>

              <!-- The risk rail spans the recent-task and global-activity area. Keep
                   the two left cards in their own top-aligned column so the taller
                   right rail cannot stretch the recent-task card and leave a blank
                   gap below its finite list. -->
              <Grid x:Name="OverviewActivityColumn"
                     Grid.Row="3"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    MinHeight="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border x:Name="OverviewRecentActivityCard" Grid.Row="0" Style="{StaticResource OverviewReadingCard}" Margin="0,0,0,14" MinHeight="0">
                <Grid>
                    <!-- The recent-task frame must follow the real item count. A fixed
                         second row makes a short list look like an empty oversized card
                         after the risk rail changes height. Keep a readable minimum and
                         cap only the list itself so larger histories scroll locally. -->
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OverviewDemoSectionTitle}" Text="最近任务"/>
                        <TextBlock Grid.Column="1" Text="{Binding OverviewTasks.Count, StringFormat=全部 {0} 个}" Style="{StaticResource OverviewDemoCaption}" Foreground="{DynamicResource GscAccentBrush}" TextElement.Foreground="{DynamicResource GscAccentBrush}" FontWeight="SemiBold" Opacity="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="最近任务数量"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource OverviewActivityFrame}" MinHeight="0">
                        <Grid>
                            <!-- Demo HomeView renders recent activity as icon-tile cards
                                 instead of a table. Each real task keeps its semantic
                                 status color on the 34x34 tile and stays selectable so the
                                 existing SelectedTask cross-page detail linkage is intact.
                                 The shared ListBox contract keeps local scrolling and
                                 Recycling virtualization on the capped 8-row list. -->
                            <ListBox x:Name="OverviewActivityList" ItemsSource="{Binding OverviewTasks}" SelectedItem="{Binding SelectedTask}" ItemContainerStyle="{StaticResource OverviewRecentTaskItemStyle}" HorizontalContentAlignment="Stretch" MinHeight="0" MaxHeight="420" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="74"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                            <Border x:Name="OverviewTaskStatusPill" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GscAccentTintBrush}" BorderBrush="{DynamicResource GscAccentTintBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock x:Name="RecentActivityGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="0">
                                                <Grid MinWidth="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" MinWidth="0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TaskTypeDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskTypeDisplay, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding GameName, Mode=OneWay, TargetNullValue=全局}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="12.5" Margin="6,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                                    </Grid>
                                                </Grid>
                                                <Grid Margin="0,3,0,0" MinWidth="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DetailMessage, Mode=OneWay}" FontSize="10.5" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailMessage}" VerticalAlignment="Center"/>
                                                    <ProgressBar x:Name="OverviewTaskProgressBar" Grid.Column="1" Style="{StaticResource OverviewTaskProgressBar}" Width="150" Margin="10,0,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                            <Border x:Name="OverviewTaskResultChip" Grid.Column="3" Style="{DynamicResource GscRedesignTableStatusPill}" MinWidth="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="OverviewTaskResultText" Text="{Binding StateDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateDisplay, Mode=OneWay}"/>
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Text" Value="&#xE895;"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="RecentActivityGlyph" Property="Foreground" Value="{DynamicResource GscMutedStatusBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscMutedStatusBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                <Setter TargetName="OverviewTaskResultChip" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                <Setter TargetName="OverviewTaskResultChip" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                <Setter TargetName="OverviewTaskResultText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="暂无任务记录&#x0a;完成备份、同步或维护操作后会显示在这里。" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverviewEmptyText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverviewTasks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
             </Border>
             </Grid>
             </Border>
              <Border Grid.Row="1" Style="{StaticResource OverviewReadingCard}" Margin="0,0,0,14" MinHeight="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                         <StackPanel><TextBlock Style="{StaticResource OverviewDemoSectionTitle}" Text="全局活动"/><TextBlock Style="{StaticResource OverviewDemoCaption}" Text="备份、恢复、云端、媒体、工具、健康、冲突、完整性与仓库修复事件" Margin="0,4,0,0"/></StackPanel>
                        <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding RefreshCommand}" Content="刷新"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource OverviewActivityFrame}">
                        <Grid>
                            <ItemsControl x:Name="OverviewActivityTimelineList" ItemsSource="{Binding Activities}" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GscActivityRowBorder}">
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ActivityKindPill" Style="{DynamicResource GscRedesignTableStatusPill}" MinWidth="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="ActivityKindChipText" Text="{Binding KindDisplay, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindDisplay, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock Text="{Binding GameName, Mode=OneWay, TargetNullValue=全局}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                                <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="ActivityResultChip" Grid.Column="2" Style="{DynamicResource GscRedesignTableStatusPill}" MinWidth="58" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="ActivityResultChipText" Text="{Binding ResultDisplay, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultDisplay, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border>
                                            <TextBlock Grid.Column="3" Text="{Binding CreatedDisplay, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,20,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CreatedDisplay, Mode=OneWay}"/>
                                        </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Compact">
                                                <Setter TargetName="ActivityKindPill" Property="Width" Value="52"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="Failed">
                                                <Setter TargetName="ActivityKindPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="ActivityKindPill" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                <Setter TargetName="ActivityResultChipText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="Warning">
                                                <Setter TargetName="ActivityKindPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="ActivityKindPill" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                <Setter TargetName="ActivityResultChipText" Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="Succeeded">
                                                <Setter TargetName="ActivityKindPill" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="ActivityKindPill" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                <Setter TargetName="ActivityResultChip" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                <Setter TargetName="ActivityResultChipText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:WorkspaceStatePresenter State="Empty" Title="暂无全局活动" Message="备份、同步、维护或健康事件完成后会显示在这里。" IsHitTestVisible="False">
                                <ui:WorkspaceStatePresenter.Style>
                                    <Style TargetType="ui:WorkspaceStatePresenter" BasedOn="{StaticResource GscWorkspaceStatePresenter}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activities.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:WorkspaceStatePresenter.Style>
                            </ui:WorkspaceStatePresenter>
                        </Grid>
                    </Border>
                </Grid>
             </Border>
             </Grid>

        <Grid x:Name="OverviewSecondaryScrollViewer"
              Grid.Row="3"
              Grid.RowSpan="2"
              Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              MinHeight="0">
        <Grid x:Name="OverviewSecondaryPanel" MinWidth="0" VerticalAlignment="Top">
            <Grid.RowDefinitions><RowDefinition x:Name="OverviewSummaryRow" Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Match the Demo's right rail: a compact risk card followed by an explicit
                 attention card. The content remains real and actionable; only the grouping
                 changes so the page reads like the reference instead of an admin dashboard. -->
            <Border x:Name="OverviewRiskCard" Grid.Row="0" Style="{StaticResource OverviewReadingCard}" VerticalAlignment="Top" MinWidth="360">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource OverviewDemoSectionTitle}" Text="风险与提醒"/>
                        <TextBlock Style="{StaticResource OverviewDemoCaption}" Text="最近 30 天游玩过的游戏" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="OverviewRiskViewport"
                                  Grid.Row="1"
                                  Style="{DynamicResource GscPageScrollViewer}"
                                  MaxHeight="420"
                                  Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  AutomationProperties.Name="风险与提醒列表">
                      <StackPanel x:Name="OverviewRiskScrollViewer">
                        <ListBox x:Name="OverviewProtectionPreviewItems"
                                      ItemsSource="{Binding RecentProtection.Items}"
                                      SelectionMode="Multiple"
                                      SelectionChanged="OnProtectionSelectionChanged"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="True"
                                      Tag="FiniteViewport"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ItemContainerStyle="{StaticResource OverviewProtectionItemContainerStyle}"
                                      AutomationProperties.Name="最近游玩游戏保护状态">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="OverviewProtectionPreviewCard"
                                            Background="{DynamicResource GscControlFillBrush}"
                                            BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8"
                                            Margin="0,0,0,6"
                                            TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}">
                                        <Grid MinWidth="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="OverviewProtectionPreviewDot" Width="8" Height="8" Fill="{DynamicResource GscWarningBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <StackPanel Grid.Column="1" MinWidth="0">
                                                <Grid MinWidth="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GameName, Mode=OneWay}"/>
                                                    <Border Grid.Column="1" x:Name="OverviewProtectionPreviewStatusPill"
                                                            Background="{DynamicResource GscSafetyFillBrush}"
                                                            BorderBrush="{DynamicResource GscWarningBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock x:Name="OverviewProtectionPreviewStatusText"
                                                                   Text="{Binding StatusDisplay, Mode=OneWay}"
                                                                   Foreground="{DynamicResource GscWarningBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding StatusDisplay, Mode=OneWay}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail, Mode=OneWay}"
                                                           Foreground="{DynamicResource GscSecondaryTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Detail, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                     <DataTrigger Binding="{Binding IsProtected, Mode=OneWay}" Value="True">
                                            <Setter TargetName="OverviewProtectionPreviewDot" Property="Fill" Value="{DynamicResource GscSuccessBrush}"/>
                                            <Setter TargetName="OverviewProtectionPreviewStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                            <Setter TargetName="OverviewProtectionPreviewStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                         <Setter TargetName="OverviewProtectionPreviewStatusText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                         <Setter TargetName="OverviewProtectionPreviewCard" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                         <Setter TargetName="OverviewProtectionPreviewCard" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                     </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                         </ListBox>
                         <!-- Demo intentionally has no second disclosure, checkbox list or per-item action here. -->
                       </StackPanel>
                     </ScrollViewer>
                    <StackPanel x:Name="OverviewProtectionActions" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ui:Button Style="{DynamicResource GscWpfUiCompactButton}" Command="{Binding OpenProtectionGamesCommand}" Content="查看需要处理的游戏" Height="{DynamicResource GscButtonHeight}" MinWidth="128" Margin="0,0,6,0" VerticalContentAlignment="Center" AutomationProperties.Name="查看最近游玩但未受保护的游戏"/>
                        <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding ApplyRecommendedProtectionCommand}" Content="启用所选保护" Height="{DynamicResource GscButtonHeight}" MinWidth="128" VerticalContentAlignment="Center" ToolTip="启用所选保护前会要求确认，并先创建当前快照。" AutomationProperties.Name="为所选最近游玩游戏启用推荐保护"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="OverviewFindingsCard" Grid.Row="1" Style="{StaticResource OverviewReadingCard}" Margin="0,14,0,0" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource OverviewDemoSectionTitle}" Text="需关注事项"/>
                    <ScrollViewer x:Name="OverviewAttentionScrollViewer"
                                                  Grid.Row="1"
                                                  Style="{DynamicResource GscPageScrollViewer}"
                                                  MaxHeight="190"
                                                  Margin="0,10,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  AutomationProperties.Name="需要关注的游戏列表">
                         <StackPanel>
                          <ItemsControl ItemsSource="{Binding AttentionFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9">
                                        <Grid>
                                        <!-- Keep the finding title readable. An unconstrained Auto action column
                                             can measure its full sentence and leave the title only a few pixels. -->
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                        <Border x:Name="AttentionFindingIcon" Width="18" Height="18" CornerRadius="9" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock x:Name="AttentionFindingGlyph" Text="!" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GscWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="0">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                            <TextBlock Text="{Binding GameName, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SuggestedAction, Mode=OneWay}" Foreground="{DynamicResource GscAccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SuggestedAction, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="AttentionFindingIcon" Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/><Setter TargetName="AttentionFindingGlyph" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter TargetName="AttentionFindingIcon" Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/><Setter TargetName="AttentionFindingGlyph" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                         </StackPanel>
                         </ScrollViewer>
                    <ui:Button Grid.Row="2" Style="{StaticResource OverviewFindingActionButton}" AutomationProperties.Name="打开维护中心查看完整关注详情" ToolTip="点击查看需要关注的游戏、原因和建议处理方式" Command="{Binding OpenAttentionCenterCommand}" Content="打开维护中心" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                </Grid>
            </Border>
        </Grid>
         </Grid>
         </Grid>
         </Grid>
         </Grid>
         </Grid>
    </ScrollViewer>
</UserControl>
