<UserControl x:Class="GameSaveCenter.Playnite.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/AcrylicReferenceTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/AcrylicReferenceColorsDark.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/AcrylicReferenceControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="OverviewTaskBadge" TargetType="Border" BasedOn="{StaticResource LabSubCard}">
                <Setter Property="MinWidth" Value="58"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
                <Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="OverviewActivityKindBadge" TargetType="Border" BasedOn="{StaticResource LabSubCard}">
                <Setter Property="MinWidth" Value="58"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
                <Setter Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="OverviewActivityResultBadge" TargetType="Border" BasedOn="{StaticResource LabSubCard}">
                <Setter Property="MinWidth" Value="58"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
                <Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="OverviewStackScrollSurface" Style="{StaticResource LabScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="OverviewLayoutGrid" Margin="0,0,6,0">

            <!-- ══════════ 今日 + 当前游戏 ══════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 今日状态 -->
                <Border x:Name="OverviewTodayHeroCard" Style="{StaticResource LabCard}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="8 月 16 日 · 星期日" Style="{StaticResource LabCaption}"/>
                        <TextBlock Text="一切正常运转" Style="{StaticResource LabTitle}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource LabBodySecondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="12,480 个游戏中有 2 个需要关注；最近的备份与云端同步保持健康节奏。"/>

                        <WrapPanel Margin="0,14,0,0">
                            <ContentControl Style="{StaticResource ChipSuccess}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource DotSuccess}" Width="6" Height="6"/>
                                    <TextBlock Text="Worker 运行中" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource ChipSuccess}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource DotSuccess}" Width="6" Height="6"/>
                                    <TextBlock Text="Ludusavi 已连接" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource ChipWarning}" Margin="8,0,0,0" Content="2 项需处理"/>
                            <ContentControl Style="{StaticResource ChipInfo}" Margin="8,0,0,0" Content="云端队列 3"/>
                            <ContentControl Style="{StaticResource ChipWarning}" Margin="8,0,0,0" Content="待归类媒体 17"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 当前游戏 -->
                <Border Grid.Column="2" Style="{StaticResource LabCard}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="当前游戏" Style="{StaticResource LabCaption}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ContentControl Style="{StaticResource GscSelectedGameIconControl}" Width="46" Height="46"
                                            Content="{Binding SelectedGameIcon}"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=请选择游戏}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedGame.PlatformDisplay, TargetNullValue=未选择游戏}" Style="{StaticResource LabCaption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedGame.BackupVersionCount}" Style="{StaticResource LabDisplay}" FontSize="22"/>
                                <TextBlock Text="备份版本" Style="{StaticResource LabCaption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedGame.MediaCount}" Style="{StaticResource LabDisplay}" FontSize="22"/>
                                <TextBlock Text="媒体文件" Style="{StaticResource LabCaption}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="{Binding SelectedGame.CloudState}" Style="{StaticResource LabDisplay}" FontSize="22"/>
                                <TextBlock Text="云端状态" Style="{StaticResource LabCaption}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <TextBlock Text="{Binding SelectedGame.LastBackupUtc, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource LabDisplay}" FontSize="22"/>
                                <TextBlock Text="上次备份" Style="{StaticResource LabCaption}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,2">
                            <Button Style="{StaticResource LabBtnPrimary}" Content="立即备份" Click="OnBackupClick" Width="100"/>
                            <Button Style="{StaticResource LabBtn}" Content="刷新详情" Margin="8,0,0,0" Click="OnLoadDetailsClick"/>
                            <Button Style="{StaticResource LabBtn}" Content="需关注" Margin="8,0,0,0"
                                    Tag="{Binding OpenAttentionCenterCommand}" Click="OnAttentionClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ 统计带（单卡分栏） ══════════ -->
            <Border x:Name="OverviewStatStrip" Style="{StaticResource LabCard}" Padding="6,14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="14,2,14,0">
                        <TextBlock Text="{Binding Snapshot.ManagedGames}" Style="{StaticResource LabDisplay}" FontSize="26"/>
                        <TextBlock Text="游戏总数" Style="{StaticResource LabCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                    <StackPanel Grid.Column="2" Margin="14,2,14,0">
                        <TextBlock Text="{Binding Snapshot.MatchedGames}" Style="{StaticResource LabDisplay}" FontSize="26"/>
                        <TextBlock Text="已匹配存档" Style="{StaticResource LabCaption}" Margin="0,4,0,0"/>
                        <ProgressBar Style="{StaticResource LabProgress}" Value="0.97" Maximum="1" Margin="0,6,0,2"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                    <StackPanel Grid.Column="4" Margin="14,2,14,0">
                        <TextBlock Text="{Binding Snapshot.RunningGames}" Style="{StaticResource LabDisplay}" FontSize="26"/>
                        <TextBlock Text="运行中" Style="{StaticResource LabCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="5" Width="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                    <StackPanel Grid.Column="6" Margin="14,2,14,0">
                        <TextBlock Text="{Binding Snapshot.WarningGames}" Style="{StaticResource LabDisplay}" FontSize="26" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="需关注" Style="{StaticResource LabCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="7" Width="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                    <StackPanel Grid.Column="8" Margin="14,2,14,0">
                        <TextBlock Text="{Binding Snapshot.PendingCloudTasks}" Style="{StaticResource LabDisplay}" FontSize="26"/>
                        <TextBlock Text="云端队列" Style="{StaticResource LabCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="9" Width="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Stretch" Margin="0,4"/>
                    <StackPanel Grid.Column="10" Margin="14,2,14,0">
                        <TextBlock Text="{Binding Snapshot.UnassignedMediaCount}" Style="{StaticResource LabDisplay}" FontSize="26" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="待归类媒体" Style="{StaticResource LabCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════ 主体双栏 ══════════ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左栏：最近任务 + 全局活动 -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource LabCard}" Padding="18,14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="最近任务" Style="{StaticResource LabSection}"/>
                                        <TextBlock Text="{Binding OverviewTasks.Count, StringFormat=全部 {0} 个}" Style="{StaticResource LabCaption}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                    <ListBox x:Name="OverviewActivityList" ItemsSource="{Binding OverviewTasks}" Margin="0,8,0,0"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,10" CornerRadius="{StaticResource RadiusS}"
                                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="44" CornerRadius="13"
                                                                Background="{DynamicResource GscAccentTintStrongBrush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock x:Name="OverviewTaskGlyph" Text="&#xE9D5;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="17"
                                                                       Foreground="{DynamicResource GscAccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center" MinWidth="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding TaskTypeDisplay}" FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding GameName}" FontSize="13.5" Margin="8,0,0,0"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DetailMessage}" FontSize="11.5" Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Grid Grid.Column="2" Width="180" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <ProgressBar Style="{StaticResource LabProgress}" Value="{Binding ProgressPercent}" Maximum="100"/>
                                                        </Grid>
                                                        <Border x:Name="OverviewTaskStatusPill" Grid.Column="3" Style="{StaticResource OverviewTaskBadge}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StateDisplay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="4" Text="{Binding CreatedLocal, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource LabCaption}" Margin="16,0,4,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding StateDisplay}" Value="成功">
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateDisplay}" Value="失败">
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateDisplay}" Value="执行中">
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateDisplay}" Value="等待中">
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateDisplay}" Value="等待确认">
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscWarningIconFillBrush}"/>
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateDisplay}" Value="已取消">
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="Background" Value="{DynamicResource GscWarningIconFillBrush}"/>
                                                        <Setter TargetName="OverviewTaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="Backup">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE74E;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="Restore">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE8AC;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="MediaSync">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE753;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="MediaInbox">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE8B7;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="TrainerDownload">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE8B5;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="CloudUpload">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE898;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskType}" Value="Validation">
                                                        <Setter TargetName="OverviewTaskGlyph" Property="Text" Value="&#xE9D9;"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Resources>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource LabProgress}"/>
                                        </ListBox.Resources>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LabCard}" Padding="18,14" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="全局活动" Style="{StaticResource LabSection}"/>
                                        <TextBlock Text="最近 100 条审计记录的业务视图" Style="{StaticResource LabCaption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ItemsControl x:Name="OverviewActivityTimelineList" ItemsSource="{Binding Activities}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="2,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="82"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource OverviewActivityKindBadge}" Height="28" HorizontalAlignment="Left"><TextBlock Text="{Binding KindDisplay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                                                                                                   HorizontalAlignment="Center" TextAlignment="Center"/></Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center" MinWidth="0">
                                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border x:Name="OverviewActivityResultPill" Grid.Column="2" Style="{StaticResource OverviewActivityResultBadge}" Height="28"><TextBlock Text="{Binding ResultDisplay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                                                                                                                   HorizontalAlignment="Center" TextAlignment="Center"/></Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding CreatedDisplay}" Style="{StaticResource LabCaption}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ResultDisplay}" Value="成功">
                                                        <Setter TargetName="OverviewActivityResultPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                        <Setter TargetName="OverviewActivityResultPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultDisplay}" Value="失败">
                                                        <Setter TargetName="OverviewActivityResultPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                                                        <Setter TargetName="OverviewActivityResultPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultDisplay}" Value="需关注">
                                                        <Setter TargetName="OverviewActivityResultPill" Property="Background" Value="{DynamicResource GscWarningIconFillBrush}"/>
                                                        <Setter TargetName="OverviewActivityResultPill" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ResultDisplay}" Value="信息">
                                                        <Setter TargetName="OverviewActivityResultPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                                                        <Setter TargetName="OverviewActivityResultPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="仅展示最近 12 条 · 不包含原始日志" Style="{StaticResource LabCaption}" Margin="2,10,0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右栏：风险与提醒 -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource LabCard}" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="风险与提醒" Style="{StaticResource LabSection}"/>
                                    <TextBlock Text="最近 30 天游玩过的游戏" Style="{StaticResource LabCaption}" Margin="0,3,0,0"/>

                                    <ItemsControl ItemsSource="{Binding Games}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,9" CornerRadius="{StaticResource RadiusS}" Margin="0,0,0,6"
                                                        Background="{DynamicResource SubFillBrush}"
                                                        BorderBrush="{DynamicResource SubStrokeBrush}" BorderThickness="1"
                                                        Opacity="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse" BasedOn="{StaticResource DotWarning}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Healthy"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Ready"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Running"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Attention"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Risk"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="LudusaviUnavailable"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthState}" Value="Unknown"><Setter Property="Fill" Value="{DynamicResource InfoBrush}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <Border x:Name="OverviewRiskBadge" Margin="8,0,0,0" MinWidth="52" Height="24"
                                                                        Padding="8,2" CornerRadius="{StaticResource RadiusS}"
                                                                        Background="{DynamicResource GscErrorIconFillBrush}"
                                                                        BorderBrush="{DynamicResource GscErrorBrush}" BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock x:Name="OverviewRiskBadgeText" Text="{Binding HealthStateDisplay}" FontSize="11"
                                                                               Foreground="{DynamicResource GscErrorBrush}"
                                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding HealthStateDisplay}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding HealthSummary}" FontSize="10.5" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Healthy">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Ready">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Running">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Attention">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscWarningIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Warning">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscWarningIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Risk">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="LudusaviUnavailable">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscErrorIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthState}" Value="Unknown">
                                                        <Setter TargetName="OverviewRiskBadge" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadge" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/>
                                                        <Setter TargetName="OverviewRiskBadgeText" Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{StaticResource LabBtnCompact}" Content="查看需要处理的游戏" Click="OnProtectionGamesClick"/>
                                        <Button Style="{StaticResource LabBtnCompactPrimary}" Content="启用所选保护" Margin="8,0,0,0"
                                                Tag="{Binding ApplyRecommendedProtectionCommand}" Click="OnApplyProtectionClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LabCard}" Padding="18,14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="需关注事项" Style="{StaticResource LabSection}"/>
                                    <ItemsControl ItemsSource="{Binding AttentionFindings}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,9" CornerRadius="{StaticResource RadiusS}" Margin="0,0,0,6"
                                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                   VerticalAlignment="Top" Margin="2,1,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding GameName}" FontSize="10.5" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SuggestedAction}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource LabBtnCompact}" Content="打开维护中心" HorizontalAlignment="Left" Margin="0,4,0,0"
                                            Tag="{Binding OpenMaintenanceCommand}"
                                            Click="OnOpenMaintenanceClick"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
