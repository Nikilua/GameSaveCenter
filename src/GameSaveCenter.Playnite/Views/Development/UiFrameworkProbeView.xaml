<UserControl x:Class="GameSaveCenter.Playnite.Views.Development.UiFrameworkProbeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- This view is a development-only audit surface. Use the same production
                     dictionary chain as Dashboard/workspaces so measurements cannot pass on
                     a WPF-UI-only fallback that users never see. -->
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/AcrylicProductionResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProbeLabel" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyCaption}">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="ProbeDataGrid" TargetType="DataGrid" BasedOn="{StaticResource GscRedesignWorkspaceDataGrid}">
                <Setter Property="Height" Value="246"/>
                <Setter Property="MinHeight" Value="246"/>
                <Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="ItemsSource" Value="{Binding ProbeRows}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource GscBackdropBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20" MaxWidth="1120" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="UI 精修校对夹具" Style="{StaticResource GscTypographyPageTitle}"/>
                    <TextBlock Margin="0,5,0,18"
                               Text="仅在开发审计入口验证生产资源、混排、控件状态、有限表格和主题降级；不代表备份、恢复、云端或媒体任务状态。"
                               Style="{StaticResource GscTypographyBody}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource GscReadingCardStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="中英混排与技术文本" Style="{StaticResource GscTypographySectionTitle}"/>
                            <TextBlock Margin="0,12,0,0" Text="存档中心  Save Center    媒体归类  Media Inbox" Style="{StaticResource GscTypographyBody}"/>
                            <TextBlock Margin="0,6,0,0" Text="备份完成，云端校验失败。可以稍后重试。" Style="{StaticResource GscTypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0" Text="赛博朋克 2077：往日之影 / Cyberpunk 2077: Phantom Liberty" Style="{StaticResource GscTypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0" Text="AgjQy  Il1 O0  0123456789  1,024 / 99,999  9% → 100%" Style="{StaticResource GscTypographyNumeric}"/>
                            <TextBlock Margin="0,6,0,0" Text="罕见字：𠮷；外文标题：NieR Replicant / Pokémon / 龍が如く" Style="{StaticResource GscTypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,10,0,0" Text="D:\Games\中文目录\Cyberpunk 2077\一个非常长的备份文件名.zip" Style="{StaticResource GscTypographyCaption}" ToolTip="D:\Games\中文目录\Cyberpunk 2077\一个非常长的备份文件名.zip" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0" Text="任务部分完成  FLING_DOWNLOAD_FORBIDDEN  ✓ × ⚠" Style="{StaticResource ProbeLabel}"/>
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="132"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="输入、选择与焦点状态" Style="{StaticResource GscTypographySectionTitle}"/>
                            <ListBox x:Name="ProbeChecklist" Grid.Row="1" Margin="0,12,0,0" SelectedIndex="0"
                                     AutomationProperties.Name="校对夹具键盘清单">
                                <ListBoxItem Content="焦点与方向键"/>
                                <ListBoxItem Content="局部资源隔离"/>
                                <ListBoxItem Content="缩放与滚动检查"/>
                            </ListBox>
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="可编辑文本" Style="{StaticResource GscWpfUiTextBox}" ToolTip="输入、光标、选择和 IME 组合文字" AutomationProperties.Name="校对文本框"/>
                                <ComboBox Grid.Column="2" SelectedIndex="0" Style="{StaticResource GscWpfUiComboBox}" ToolTip="Popup 与长选项主题" AutomationProperties.Name="校对选择器">
                                    <ComboBoxItem Content="全部项目"/>
                                    <ComboBoxItem Content="已就绪"/>
                                    <ComboBoxItem Content="需要处理"/>
                                </ComboBox>
                            </Grid>
                            <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                                <ui:Button Style="{StaticResource GscWpfUiPrimaryButton}" Content="主操作" ToolTip="正常、Hover、Pressed 和焦点状态" AutomationProperties.Name="校对主操作">
                                </ui:Button>
                                <ui:Button Style="{StaticResource GscWpfUiSecondaryButton}" Content="次要操作" Margin="8,0,0,0" AutomationProperties.Name="校对次要操作"/>
                                <ui:Button Style="{StaticResource GscWpfUiSecondaryButton}" Content="禁用操作" IsEnabled="False" Margin="8,0,0,0" ToolTip="禁用原因仍需可读" AutomationProperties.Name="校对禁用操作"/>
                            </WrapPanel>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="开关" IsChecked="True" OnContent="开" OffContent="关" AutomationProperties.Name="校对开关"/>
                                <ui:Button Style="{StaticResource GscIconOnlyToolbarButton}" ContentTemplate="{x:Null}" Margin="8,0,0,0" ToolTip="复制诊断" AutomationProperties.Name="复制诊断">
                                    <ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconBtnCopy}" Width="18" Height="18"/>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource GscReadingCardStyle}" Padding="20" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="246"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="状态徽章、进度与表格阅读面" Style="{StaticResource GscTypographySectionTitle}"/>
                        <WrapPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right">
                            <Border Style="{StaticResource GscRedesignTableStatusPill}" Background="{DynamicResource GscSuccessIconFillBrush}" BorderBrush="{DynamicResource GscSuccessBrush}"><StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconStatusSuccess}" Width="16" Height="16" Foreground="{DynamicResource GscSuccessBrush}"/><TextBlock Text="已完成" Margin="6,0,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource GscRedesignTableStatusPill}" Background="{DynamicResource GscWarningIconFillBrush}" BorderBrush="{DynamicResource GscWarningBrush}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconStatusWarning}" Width="16" Height="16" Foreground="{DynamicResource GscWarningBrush}"/><TextBlock Text="需关注" Margin="6,0,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource GscRedesignTableStatusPill}" Background="{DynamicResource GscErrorIconFillBrush}" BorderBrush="{DynamicResource GscErrorBrush}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><ui:ThemeAwareIcon Style="{StaticResource GscLineIcon}" IconData="{StaticResource GscIconStatusError}" Width="16" Height="16" Foreground="{DynamicResource GscErrorBrush}"/><TextBlock Text="失败" Margin="6,0,0,0"/></StackPanel></Border>
                        </WrapPanel>
                        <DataGrid x:Name="ProbeGrid" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource ProbeDataGrid}" AutomationProperties.Name="校对数据表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="110"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/>
                                <DataGridTextColumn Header="路径/诊断" Binding="{Binding Detail}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource GscTypographyCaption}"
                           Text="资源由此视图的 UserControl.Resources 合并，不写入 Playnite Application.Current.Resources。按钮按压态、键盘焦点、输入法组合和表格端点需结合行为探针/真机验收。"/>
            </Grid>
        </ScrollViewer>
        <Border x:Name="ProbeFailurePanel" Panel.ZIndex="10" Visibility="Collapsed" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" Margin="20" Padding="12" CornerRadius="12"
                Background="{DynamicResource GscErrorTintBrush}" BorderBrush="{DynamicResource GscErrorBrush}" BorderThickness="1">
            <TextBlock x:Name="ProbeFailureText" TextWrapping="Wrap" Foreground="{DynamicResource GscPrimaryTextBrush}"/>
        </Border>
        <ui:SnackbarPresenter x:Name="SnackbarHost" Panel.ZIndex="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"/>
    </Grid>
</UserControl>
