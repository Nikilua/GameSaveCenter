<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared timing vocabulary. Templates create their own target transforms; these tokens
         are immutable timing/easing metadata and are never animated themselves. -->
    <Duration x:Key="GscMotionFast">0:0:0.12</Duration>
    <Duration x:Key="GscMotionPress">0:0:0.10</Duration>
    <Duration x:Key="GscMotionNormal">0:0:0.20</Duration>
    <Duration x:Key="GscMotionSlow">0:0:0.32</Duration>
    <CubicEase x:Key="GscMotionEaseOut" EasingMode="EaseOut"/>
</ResourceDictionary>
