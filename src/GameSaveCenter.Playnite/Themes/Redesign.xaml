<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls">
    <ResourceDictionary.MergedDictionaries>
        <!-- Keep the WPF-UI adapters in this dictionary's parse scope.  The color/material
             tokens remain page-local and are consumed through DynamicResource. -->
        <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Final redesign geometry.  These values intentionally form a small, reusable scale
         rather than page-specific magic numbers. -->
    <CornerRadius x:Key="GscRedesignShellCorner">20</CornerRadius>
    <CornerRadius x:Key="GscRedesignSidebarCorner">18</CornerRadius>
    <CornerRadius x:Key="GscRedesignCardCorner">16</CornerRadius>
    <CornerRadius x:Key="GscRedesignControlCorner">10</CornerRadius>
    <Thickness x:Key="GscRedesignPagePadding">18</Thickness>
    <Thickness x:Key="GscRedesignCardPadding">16</Thickness>

    <Style x:Key="GscRedesignShellSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscRedesignShellCorner}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignSidebarSurface" TargetType="Border" BasedOn="{StaticResource GscRedesignShellSurface}">
        <Setter Property="Background" Value="{DynamicResource GscSidebarBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscRedesignSidebarCorner}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{DynamicResource GscSidebarEffect}"/>
    </Style>

    <Style x:Key="GscRedesignSectionCard" TargetType="Border">
        <!-- Demo cards are reading surfaces: mostly opaque, with translucency reserved for
             the shell/sidebar and floating layers. This prevents the six workspaces from
             becoming low-contrast glass panels when the host window is resized. -->
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Keep ordinary production cards identical to Demo's GscReadingCardStyle.
             Special surfaces (table, hero, metric and floating cards) override these
             values below, so this shared change does not alter their layout contracts. -->
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- All workspace tables share one opaque reading surface. Keeping this in the shared
         dictionary prevents a host theme from falling back to square/default DataGrid chrome
         and keeps rounded frames consistent across Saves, Media, Trainers and Maintenance. -->
    <Style x:Key="GscRedesignTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <!-- Clip the DataGrid viewport to the rounded frame so the first/last header and
             scrollbar never leak square pixels over the Apple-style corners. -->
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- One explicit LabGrid-like contract for every extracted workspace table. Pages may
         still override a row/header style for status-specific chrome, but geometry,
         sorting, resizing, scrolling and recycling stay centralized here. This keeps the
         real bindings and finite viewport layout intact while preventing Save/Media/Task/
         Maintenance from drifting into subtly different DataGrid behavior. -->
    <Style x:Key="GscRedesignWorkspaceDataGrid"
           TargetType="DataGrid"
           BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="{DynamicResource GscTableRowBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
        <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GscDataGridColumnHeaderStyle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignHeroCard" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Demo-inspired workspace hero used by the real Playnite pages. It is a
         lightweight reading surface only: pages keep their existing commands,
         bindings and virtualized data controls below this header. -->
    <Style x:Key="GscRedesignWorkspaceHeroCard" TargetType="Border" BasedOn="{StaticResource GscRedesignHeroCard}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="MinHeight" Value="76"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignHeroEyebrow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GscRedesignHeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscDisplayFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Floating picker follows the demo handoff: it is an in-host material surface,
         not a WPF Popup or a default Button overlay, so Playnite cannot paint a
         system-blue hover layer over the page behind it. -->
    <Style x:Key="GscRedesignFloatingPickerCard" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Effect" Value="{DynamicResource GscDialogEffect}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Feedback surfaces use the same quiet floating material as the Demo picker. These
         styles are consumed by the in-host toast/dialog so transient feedback does not
         grow a second card, radius or shadow language inside DashboardView. -->
    <Style x:Key="GscRedesignFeedbackToastCard" TargetType="Border" BasedOn="{StaticResource GscRedesignFloatingPickerCard}">
        <Setter Property="Width" Value="360"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14,12,10,12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="Effect" Value="{DynamicResource GscDialogEffect}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignFeedbackToastTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="GscRedesignFeedbackToastMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="MaxHeight" Value="72"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="GscRedesignFeedbackDialogOverlay" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource GscOverlayBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignFeedbackDialogCard" TargetType="Border" BasedOn="{StaticResource GscRedesignFloatingPickerCard}">
        <Setter Property="Width" Value="480"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="Effect" Value="{DynamicResource GscDialogEffect}"/>
    </Style>

    <Style x:Key="GscRedesignFeedbackDialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscDisplayFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="GscRedesignFeedbackDialogMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="GscRedesignMetricCard" TargetType="{x:Type ui:Card}" BasedOn="{StaticResource GscWpfUiCard}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Border.CornerRadius" Value="18"/>
        <Setter Property="MinHeight" Value="84"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GscRedesignMetricBorder" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="MinHeight" Value="84"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GscRedesignHeaderButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GscRedesignPrimaryHeaderButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource GscWpfUiPrimaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GscRedesignGameSelector" TargetType="ComboBox" BasedOn="{StaticResource GscWpfUiComboBox}">
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MaxDropDownHeight" Value="420"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="ToolTipService.ShowDuration" Value="16000"/>
    </Style>

    <!-- The active-game context is deliberately a button, not a ComboBox. A ComboBox
         materializes a large popup and becomes visibly slow for libraries with hundreds
         of games. Clicking this button opens the existing virtualized search/filter/sort
         browser, so there is only one game-selection surface at every breakpoint. -->
    <Style x:Key="GscRedesignGameContextButton" TargetType="Button">
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.ShowDuration" Value="16000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscRedesignStatusCard" TargetType="Border">
        <Setter Property="MinHeight" Value="58"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="GscRedesignContextPill" TargetType="Border">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="CornerRadius" Value="6"/>
        <!-- Context/stat cards are reading surfaces, not primary actions.  Keep their
             default neutral and let status-specific cards opt into a semantic tint. -->
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Inner reading surfaces that mirror the demo's sub-card hierarchy while
         keeping real page controls, bindings and commands in place. -->
    <Style x:Key="GscRedesignInfoBand" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignSubCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignCounterPill" TargetType="Border" BasedOn="{StaticResource GscRedesignContextPill}">
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
    </Style>

    <!-- Small semantic pills used inside dense tables. Keeping these shared prevents each
         DataGrid cell template from inventing a different radius, padding or theme fallback. -->
    <Style x:Key="GscRedesignTableStatusPill" TargetType="Border" BasedOn="{StaticResource GscRedesignContextPill}">
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>


    <Style x:Key="GscRedesignSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="GscRedesignSectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Production workspace tabs intentionally keep the project's existing tab chrome.
         Demo page geometry still owns the surrounding layout, but the tab bar itself is
         not the Demo's outer segmented pill. The header remains independently scrollable
         so narrow windows never clip the last tab or force the content area to grow. -->
    <Style x:Key="GscRedesignWorkspaceTabControl" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local"
                          SnapsToDevicePixels="True"
                          ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="1,1,1,10"
                                Background="Transparent"
                                ClipToBounds="False">
                            <ScrollViewer x:Name="HeaderScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          PanningMode="HorizontalOnly"
                                          Focusable="False">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent"
                                          ClipToBounds="False"/>
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          Margin="0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="HideHeaders">
                            <Setter TargetName="HeaderScrollViewer" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscRedesignWorkspaceTabItem" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent"
                          ClipToBounds="False"
                          UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Chrome"
                                Grid.Column="0"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="False"
                                UseLayoutRounding="True"
                                ClipToBounds="False">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Internal secondary tabs (retention/audit/compare) reuse the workspace pill
         language, but with a tighter rhythm so a nested tab strip does not consume
         the main table viewport. The content host still owns the finite star row. -->
    <Style x:Key="GscInternalTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="GscInternalTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style x:Key="GscRedesignSettingsTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local" LastChildFill="True">
                        <ScrollViewer x:Name="SettingsHeaderScroller"
                                      Width="248"
                                      DockPanel.Dock="Left"
                                      Margin="0,0,16,0"
                                      Padding="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Top"
                                      Focusable="False"
                                      KeyboardNavigation.TabNavigation="Local">
                            <!-- TabPanel is measured with an infinite vertical extent by the
                                 ScrollViewer. Keep the safety zone as a real child after the
                                 panel, rather than as Padding/Margin: WPF can otherwise
                                 arrange the last TabItem flush with the viewport and clip
                                 the lower anti-aliased corner pixels. -->
                            <StackPanel x:Name="SettingsHeaderItemsHost"
                                        VerticalAlignment="Top"
                                        ClipToBounds="False">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                                <Border x:Name="SettingsHeaderBottomSafetyZone"
                                        Height="16"
                                        Background="Transparent"
                                        IsHitTestVisible="False"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="SettingsScroller"
                                      Style="{DynamicResource GscPageScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      Padding="0,0,4,18"
                                      Focusable="False"
                                      KeyboardNavigation.TabNavigation="Continue">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Top">
                            <Setter TargetName="SettingsHeaderScroller" Property="Margin" Value="0,0,0,12"/>
                            <Setter TargetName="SettingsHeaderScroller" Property="DockPanel.Dock" Value="Top"/>
                            <Setter TargetName="SettingsHeaderScroller" Property="HorizontalScrollBarVisibility" Value="Auto"/>
                            <Setter TargetName="SettingsHeaderScroller" Property="VerticalScrollBarVisibility" Value="Disabled"/>
                            <Setter TargetName="SettingsHeaderScroller" Property="Width" Value="NaN"/>
                            <Setter TargetName="SettingsHeaderBottomSafetyZone" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscRedesignSettingsTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="MinWidth" Value="218"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- TabPanel owns the TabItem layout slot. A Border as the template
                         root can be clipped at that slot's edge, which turns the lower
                         rounded corners into a straight line. The non-clipping root keeps
                         the visual chrome independent from the TabItem slot. -->
                    <Grid x:Name="TabItemRoot"
                          ClipToBounds="False"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Border x:Name="Chrome"
                                MinHeight="0"
                                Padding="14,8"
                                CornerRadius="14"
                                ClipToBounds="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Margin="0,0,0,2"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Background="{DynamicResource GscControlFillBrush}"
                                BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                                BorderThickness="1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSelectedGameIconControl" TargetType="ContentControl">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="IconTile" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="13"
                            Background="{DynamicResource GscAccentTintBrush}">
                        <Grid>
                            <Image Source="{TemplateBinding Content}"
                                   Width="30" Height="30" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IconFallback"
                                       FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="22"
                                       Foreground="{DynamicResource GscAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconFallback" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Demo-compatible aliases. Keeping these names in the production dictionary lets
         migrated views use the same visual vocabulary as the standalone WPF demo without
         duplicating a second theme or changing any command/binding contract. -->
    <Style x:Key="GscShellStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- This dictionary is merged independently inside Playnite.  Do not reference a
             CornerRadius resource owned by the sibling DesignTokens dictionary: WPF may defer
             that StaticResource as UnsetValue and crash while the host arranges the Border. -->
        <Setter Property="CornerRadius" Value="{StaticResource GscRedesignShellCorner}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscDisplayFontFamily}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="GscSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GscRedesignSectionTitle}"/>
    <Style x:Key="GscCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="GscBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <!-- Demo-compatible aliases are intentionally explicit instead of inheriting the
         production section-card shadow/elevation. The demo's reading surfaces are opaque,
         quiet and evenly padded; keeping that contract here makes every extracted page match
         the same visual rhythm without changing any binding or command. -->
    <Style x:Key="GscReadingCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscSubCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscFloatingCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscPopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{DynamicResource GscPopupEffect}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GscPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GscButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscOnAccentTextBrush}"/>
    </Style>
    <Style x:Key="GscTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource GscWpfUiTextBox}"/>
    <Style x:Key="GscComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource GscWpfUiComboBox}"/>
    <Style x:Key="GscTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}"/>
    <Style x:Key="GscTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}"/>
    <Style x:Key="GscToolbarActionRow" TargetType="WrapPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="GscToolbarOverflowButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource GscWpfUiToolbarButton}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="GscWorkspaceStatePresenter" TargetType="ui:WorkspaceStatePresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:WorkspaceStatePresenter">
                    <Border Style="{DynamicResource GscRedesignSubCard}" Padding="18" MinHeight="96">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource GscAccentIconFillBrush}" HorizontalAlignment="Center">
                                <TextBlock x:Name="StateGlyphText" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StateDisplayText" Text="空" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="{TemplateBinding Message}" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="{TemplateBinding Detail}" Foreground="{DynamicResource GscMutedTextBrush}" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                            <ui:Button x:Name="RetryButton" Content="{TemplateBinding RetryText}" Command="{TemplateBinding RetryCommand}" Style="{DynamicResource GscWpfUiActionButton}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RetryCommand, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter TargetName="RetryButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="State" Value="Loading">
                            <Setter TargetName="StateGlyphText" Property="Text" Value="&#xE823;"/>
                            <Setter TargetName="StateGlyphText" Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
                            <Setter TargetName="StateDisplayText" Property="Text" Value="加载中"/>
                        </Trigger>
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="StateGlyphText" Property="Text" Value="&#xE711;"/>
                            <Setter TargetName="StateGlyphText" Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                            <Setter TargetName="StateDisplayText" Property="Text" Value="错误"/>
                        </Trigger>
                        <Trigger Property="State" Value="Degraded">
                            <Setter TargetName="StateGlyphText" Property="Text" Value="&#xE7BA;"/>
                            <Setter TargetName="StateGlyphText" Property="Foreground" Value="{DynamicResource GscWarningBrush}"/>
                            <Setter TargetName="StateDisplayText" Property="Text" Value="降级"/>
                        </Trigger>
                        <Trigger Property="State" Value="Offline">
                            <Setter TargetName="StateGlyphText" Property="Text" Value="&#xE774;"/>
                            <Setter TargetName="StateGlyphText" Property="Foreground" Value="{DynamicResource GscMutedStatusBrush}"/>
                            <Setter TargetName="StateDisplayText" Property="Text" Value="离线"/>
                        </Trigger>
                        <Trigger Property="State" Value="Disabled">
                            <Setter TargetName="StateGlyphText" Property="Text" Value="&#xE7B3;"/>
                            <Setter TargetName="StateGlyphText" Property="Foreground" Value="{DynamicResource GscMutedStatusBrush}"/>
                            <Setter TargetName="StateDisplayText" Property="Text" Value="已禁用"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
