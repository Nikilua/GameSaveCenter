<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Inter supplies the compact Latin/numeric rhythm; Noto Sans SC is preferred when
         installed for Chinese glyphs, with Windows UI fonts as dependable Playnite fallbacks. -->
    <FontFamily x:Key="GscUiFontFamily">Inter, Segoe UI Variable Text, Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="GscDisplayFontFamily">Inter, Segoe UI Variable Display, Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="GscNumericFontFamily">Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="GscCodeFontFamily">Cascadia Mono, Consolas, Noto Sans SC, Microsoft YaHei UI</FontFamily>

    <sys:Double x:Key="GscPageTitleFontSize">22</sys:Double>
    <sys:Double x:Key="GscDisplayTitleFontSize">28</sys:Double>
    <sys:Double x:Key="GscSectionFontSize">16</sys:Double>
    <sys:Double x:Key="GscBodyFontSize">14</sys:Double>
    <sys:Double x:Key="GscCaptionFontSize">12</sys:Double>

    <!-- Implicit bases cover existing view content without changing any layout, binding or
         control template. Named styles below carry hierarchy where a view declares it. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="{x:Type ui:Button}">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscTypographyPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscDisplayFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscPageTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscTypographySectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscDisplayFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscSectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscTypographyBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscTypographyCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscCaptionFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <!-- Caption hierarchy is expressed by its semantic color, not a second opacity
             multiplier. A TextBlock ancestor may already be translucent on a material
             surface; keeping this style opaque avoids turning CJK strokes into gray dust. -->
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscTypographyNumeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscNumericFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscTypographyCode" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscCodeFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscCaptionFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- Design-brief vocabulary. These aliases intentionally reuse the existing
         typography styles so there is one font and hierarchy source of truth. -->
    <Style x:Key="GscDisplayTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource GscDisplayFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscDisplayTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="GscPageTitle" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyPageTitle}"/>
    <Style x:Key="GscSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource GscTypographySectionTitle}"/>
    <Style x:Key="GscBodyText" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyBody}"/>
    <Style x:Key="GscCaptionText" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyCaption}"/>
    <Style x:Key="GscNumericText" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyNumeric}"/>
    <Style x:Key="GscCodeText" TargetType="TextBlock" BasedOn="{StaticResource GscTypographyCode}"/>
</ResourceDictionary>
