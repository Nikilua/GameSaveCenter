<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Shared surface radii. Keep the established production geometry while giving every
         shared surface a named value that can be checked consistently at fractional DPI. -->
    <CornerRadius x:Key="GscGeometryCornerTiny">2</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerSmall">8</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerPill">6</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerStatus">9</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerControl">10</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerCompact">11</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerTable">12</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerDenseCard">13</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerButton">14</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerCard">16</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerHeader">18</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerPanel">20</CornerRadius>
    <CornerRadius x:Key="GscGeometryCornerDialog">22</CornerRadius>

    <!-- One logical-pixel stroke remains one DIP at every supported display scale. -->
    <Thickness x:Key="GscHairlineThickness">1</Thickness>
    <Thickness x:Key="GscBottomHairlineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="GscFocusRingThickness">2</Thickness>
    <sys:Double x:Key="GscDividerThickness">1</sys:Double>

    <!-- Shared icon geometry is authored on a 24-unit view box; these values define
         the rendered sizes and stroke weight used by inline actions and navigation. -->
    <sys:Double x:Key="GscIconSizeDefault">24</sys:Double>
    <sys:Double x:Key="GscIconSizeAction">18</sys:Double>
    <Thickness x:Key="GscIconInlineGapThickness">0,0,4,0</Thickness>
    <sys:Double x:Key="GscIconStrokeThickness">1.8</sys:Double>

    <Style x:Key="GscHorizontalDivider" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource GscDividerThickness}"/>
        <Setter Property="Background" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
</ResourceDictionary>
