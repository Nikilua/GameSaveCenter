<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/GeometryTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="GscWpfUiFloatingSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscPopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource GscHairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscGeometryCornerTable}"/>
        <Setter Property="Effect" Value="{DynamicResource GscPopupEffect}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

</ResourceDictionary>
