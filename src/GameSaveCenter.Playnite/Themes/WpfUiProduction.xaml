<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
                    xmlns:infra="clr-namespace:GameSaveCenter.Playnite.Infrastructure">
    <ResourceDictionary.MergedDictionaries>
        <!-- StaticResource resolution happens while this dictionary is parsed. Keep WPF-UI's
             type-keyed defaults in the same resource scope as the production adapters; a
             sibling merge at the UserControl level is too late in Playnite's XAML loader. -->
        <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Production adapters keep WPF-UI templates while applying GameSaveCenter's spacing,
         focus and material tokens. This dictionary is merged only after DesignTokens.xaml
         inside a GameSaveCenter UserControl; it must never enter Playnite application-level resources. -->
    <Style x:Key="GscWpfUiCard"
           TargetType="{x:Type ui:Card}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="18"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <!-- GameSaveCenter tokens live in the parent UserControl dictionary. DynamicResource
                     keeps them theme-aware and avoids Playnite resolving a sibling dictionary too early. -->
                <DropShadowEffect Color="{DynamicResource GscSoftShadowColor}"
                                  BlurRadius="14" ShadowDepth="2" Opacity="0.28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI's type defaults are intentionally kept for the framework controls, but the
         production adapters own the input chrome so a Playnite host theme cannot reintroduce
         square white editors or an unthemed ComboBox popup.  These templates use only shared
         DynamicResource tokens and keep the content host/keyboard behavior of native WPF. -->
    <ControlTemplate x:Key="GscWpfUiTextBoxTemplate" TargetType="TextBox">
        <Border x:Name="Chrome"
                CornerRadius="10"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="0"
                          Padding="0"
                          BorderThickness="0"
                          VerticalAlignment="Stretch"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          TextElement.Foreground="{TemplateBinding Foreground}"
                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                          TextElement.FontSize="{TemplateBinding FontSize}"
                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                          CanContentScroll="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscControlFocusFillBrush}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="GscWpfUiComboBoxTemplate" TargetType="ComboBox">
        <Grid>
            <ToggleButton x:Name="DropDownToggle"
                          Focusable="False"
                          ClickMode="Press"
                          OverridesDefaultStyle="True"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                CornerRadius="10"
                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                            <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                <Path x:Name="Chevron"
                                      Grid.Column="1"
                                      Data="M 1 2 L 5 6 L 9 2"
                                      Stretch="None"
                                      Stroke="{DynamicResource GscSecondaryTextBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   AllowsTransparency="{DynamicResource GscPopupAllowsTransparency}"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Focusable="False"
                   PopupAnimation="{DynamicResource GscPopupAnimation}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,6,0,8"
                        Padding="5"
                        Background="{DynamicResource GscPopupBrush}"
                        BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Effect="{DynamicResource GscPopupEffect}">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.46"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Implicit item styling is scoped to the plugin resource dictionaries. It prevents the
         Popup from inheriting a bright host selection surface while preserving keyboard and
         automation semantics of ComboBoxItem. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keep every production ListBox on the same local scrolling/virtualization contract.
         Item cards own their rounded chrome below; the host ListBox itself stays transparent
         so nested workspaces do not acquire a second square panel or an infinite measure. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/>
        <!-- A finite list with only a few realized items must measure from its
             leading edge. Some host/theme templates otherwise center the ItemsPresenter
             in the viewport and expose a misleading blank area below the table header. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
    </Style>

    <!-- Shared rounded list-item chrome. Workspace-specific lists may override the template,
         but every implicit ListBox now keeps the same hover, selection and keyboard-focus
         language instead of falling back to the Playnite host's square blue item surface. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- This implicit style can be applied outside the UserControl resource
                         scope. An unresolved dynamic CornerRadius resource becomes UnsetValue
                         and crashes WPF during Border.Arrange. -->
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemChrome" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared Apple-style DataGrid chrome for extracted workspaces. The Dashboard shell has
         its own compatible local styles; keeping this implicit scope here makes Overview,
         Saves, Media, Tasks and Maintenance look identical without duplicating templates. -->
    <!-- Keep the scrolling contract at the shared control level as well as in each workspace's
         keyed style. This covers future tables and prevents a host/template change from
         silently turning touchpad scrolling into page scrolling or disabling Recycling. -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="{DynamicResource GscTableRowBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
        <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GscTableDividerBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <!-- Keep the virtualized rows anchored at the top of a short viewport.  Stretching
             the DataGrid content vertically lets some host templates arrange a small item
             set at the bottom and exposes phantom empty space after scrolling. -->
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
        <Setter Property="infra:DataGridStarFill.Enabled" Value="True"/>
        <!-- WPF creates a filler header when the visible columns do not consume the
             viewport.  Give that generated header the same theme as real columns; otherwise
             Playnite's host theme can paint the far-right strip white. -->
        <Setter Property="ColumnHeaderStyle" Value="{DynamicResource GscDataGridColumnHeaderStyle}"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="MinColumnWidth" Value="64"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <!-- This is the production header template; do not let the Playnite host replace
             it with its default (white) DataGrid header style. -->
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscCaptionFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <!-- Demo tables use one quiet header band owned by the rounded frame; individual
             columns must not become separate rounded pills. -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,0,8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Tag"><Setter.Value><CornerRadius>0</CornerRadius></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <!-- Host-generated headers may not have a Tag. Never pass an unset binding
                         result into Border.CornerRadius. -->
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Keep enough room for the full 13 DIP sort chevron and
                                     its optical inset.  The old 14 DIP slot clipped the
                                     right stroke, especially on narrow sorted columns. -->
                                <ColumnDefinition Width="22" MinWidth="22"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path x:Name="SortGlyph"
                                  Grid.Column="1"
                                  Data="M 1 6 L 7 1 L 13 6"
                                  Stretch="None"
                                  Stroke="{DynamicResource GscAccentBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"
                                  Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                            </Path>
                            <!-- WPF's DataGridColumnHeader logic locates these named thumbs
                                 to start a column resize.  Keep them transparent so the
                                 header remains visually quiet while the full 8 DIP edge
                                 remains an interactive resize target. -->
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   Width="8"
                                   HorizontalAlignment="Left"
                                   Cursor="SizeWE"
                                   Background="Transparent"
                                   Focusable="False">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   Width="8"
                                   HorizontalAlignment="Right"
                                   Cursor="SizeWE"
                                   Background="Transparent"
                                   Focusable="False">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortGlyph" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscDataGridColumnHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
    </Style>

    <!-- The column-header presenter owns WPF's generated filler header.  Styling only real
         DataGridColumnHeader instances leaves that unused strip to the Playnite host theme,
         which is why the final header could remain white. -->
    <Style TargetType="DataGridColumnHeadersPresenter">
        <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <!-- Text columns read naturally from the leading edge; status/progress/action
             templates can still opt into Center/Stretch explicitly.  Centering every
             text cell made long paths and task details look cramped in narrow windows. -->
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellChrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellChrome" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The selected row follows the Trainer card language: the normal table stays a
         quiet divider list, while the selected item gets an accent surface, outline and
         14 DIP rounded corners. SelectiveScrollingGrid keeps WPF row virtualization and
         details scrolling intact. -->
    <ControlTemplate x:Key="GscRoundedDataGridRowTemplate" TargetType="{x:Type DataGridRow}">
        <Border x:Name="RowChrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="0"
                Margin="0"
                SnapsToDevicePixels="True">
            <SelectiveScrollingGrid>
                <SelectiveScrollingGrid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </SelectiveScrollingGrid.ColumnDefinitions>
                <SelectiveScrollingGrid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </SelectiveScrollingGrid.RowDefinitions>
                <DataGridRowHeader Grid.RowSpan="2"
                                   Visibility="Collapsed"
                                   SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"/>
                <DataGridCellsPresenter x:Name="PART_CellsPresenter"
                                        Grid.Column="1"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        SelectiveScrollingGrid.SelectiveScrollingOrientation="Horizontal"/>
                <DataGridDetailsPresenter Grid.Row="1"
                                          Grid.Column="1"
                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                          Visibility="{TemplateBinding DetailsVisibility}"/>
            </SelectiveScrollingGrid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                <Setter TargetName="RowChrome" Property="BorderThickness" Value="1"/>
                <Setter TargetName="RowChrome" Property="CornerRadius" Value="14"/>
                <!-- Leave a safe area at the right edge. Playnite's host ScrollViewer
                     can overlay the last device pixels with its vertical track; keeping the
                     selected outline inside the rounded frame makes both side corners visible. -->
                <Setter TargetName="RowChrome" Property="Margin" Value="4,2,12,2"/>
                <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowChrome" Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="DataGridRow">
        <Setter Property="Height" Value="{DynamicResource GscTableRowHeight}"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscTableRowHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscTableRowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource GscRoundedDataGridRowTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Shared keyed row style used by the extracted workspace tables. -->
    <Style x:Key="GscStableDataGridRow" TargetType="DataGridRow">
        <Setter Property="Height" Value="{DynamicResource GscTableRowHeight}"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscTableRowHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscTableRowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource GscRoundedDataGridRowTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keep text-only action buttons bounded by their actual chrome.  The production
         pages intentionally use text content for commands; rendering that content through
         a shared TextBlock keeps long localized labels and game-derived actions centered
         and ellipsized instead of expanding past a toolbar or inspector boundary. -->
    <DataTemplate x:Key="GscWpfUiButtonTextTemplate">
        <TextBlock Text="{Binding}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding}"
                   SnapsToDevicePixels="True"/>
    </DataTemplate>

    <!-- Settings uses the same production palette as the workspace pages. Do not reuse
         AcrylicReferenceControls' Demo segment fill here: that legacy token is bright in
         the dark reference palette and becomes a gray slab in Playnite settings. -->
    <Style x:Key="GscSettingsSectionTabItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TabChrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSettingsSectionTabs" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource GscSettingsSectionTabItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscWpfUiButton"
           TargetType="{x:Type ui:Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate" Value="{StaticResource GscWpfUiButtonTextTemplate}"/>
        <Setter Property="ui:Button.CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <!-- The content must be measured inside the padded chrome. Keeping the
                         presenter beside an empty Border makes WPF size the button from the
                         text alone, which is why localized labels touched or crossed the
                         border on every page. -->
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="11"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <!-- Demo LabBtn state layers: keep the base surface readable and
                                 animate only the overlay opacity, never layout dimensions. -->
                            <Border x:Name="HoverOverlay"
                                    Background="{DynamicResource GscAccentTintBrush}"
                                    CornerRadius="11"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="PressedOverlay"
                                    Background="{DynamicResource GscAccentTintStrongBrush}"
                                    CornerRadius="11"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <!-- Stretch gives the shared text template a bounded measure so
                                 its ellipsis can work at narrow responsive widths. -->
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Appearance" Value="Primary">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource GscPrimaryButtonBrush}"/>
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource GscPrimaryButtonBorderBrush}"/>
                            <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource GscOnAccentHoverOverlayBrush}"/>
                            <Setter TargetName="PressedOverlay" Property="Background" Value="{DynamicResource GscOnAccentPressedOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscOnAccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscWpfUiSecondaryButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiButton}">
        <Setter Property="Appearance" Value="Secondary"/>
    </Style>

    <Style x:Key="GscWpfUiPrimaryButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiButton}">
        <Setter Property="Appearance" Value="Primary"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GscWpfUiCompactButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource GscCompactButtonHeight}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="GscWpfUiActionButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="GscWpfUiPrimaryActionButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiPrimaryButton}">
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="GscWpfUiToolbarButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
    </Style>

    <Style x:Key="GscWpfUiToolbarPrimaryButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiPrimaryButton}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
    </Style>

    <Style x:Key="GscWpfUiContextButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiCompactButton}">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <!-- Keep unavailable contextual actions in the layout. Collapsing them made a
             row jump when selection changed and hid the existence of a safe next step;
             the shared button template already exposes a readable disabled state. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GscWpfUiToggleSwitch"
           TargetType="{x:Type ui:ToggleSwitch}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="40" Height="23" CornerRadius="11.5"
                                Background="{DynamicResource GscControlStrokeBrush}"
                                BorderBrush="Transparent" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="{DynamicResource GscGlassStrongBrush}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Effect="{DynamicResource GscSliderThumbEffect}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="17" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI styles standard TextBox and ComboBox through ControlsDictionary. These keyed
         adapters make production migration explicit without replacing the framework template. -->
    <Style x:Key="GscWpfUiTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="FontFamily" Value="{DynamicResource GscUiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource GscBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="Height" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Template" Value="{StaticResource GscWpfUiTextBoxTemplate}"/>
    </Style>

    <Style x:Key="GscWpfUiComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Template" Value="{StaticResource GscWpfUiComboBoxTemplate}"/>
    </Style>

    <!-- Filter selectors always begin with the first, human-readable "全部" option.
         This style is intentionally opt-in: game/version/path selectors must be allowed
         to start empty until the real selection is loaded. It is declared after the base
         ComboBox adapter so StaticResource resolution remains valid in WPF. -->
    <Style x:Key="GscWpfUiFilterComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource GscWpfUiComboBox}">
        <Setter Property="SelectedIndex" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="{DynamicResource GscButtonHeight}"/>
    </Style>
</ResourceDictionary>
