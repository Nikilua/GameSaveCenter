    <Style x:Key="GscLineIcon" TargetType="{x:Type ui:ThemeAwareIcon}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="StrokeThickness" Value="1.85"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ThemeAwareIcon}">
                    <Viewbox Stretch="Uniform" SnapsToDevicePixels="True">
                        <Grid Width="24" Height="24">
                            <Path Data="{TemplateBinding IconData}"
                                  Fill="Transparent"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Path Data="{TemplateBinding FillData}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stroke="Transparent"/>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
