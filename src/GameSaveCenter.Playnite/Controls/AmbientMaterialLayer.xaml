<UserControl x:Class="GameSaveCenter.Playnite.Controls.AmbientMaterialLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False"
             ClipToBounds="True"
             SnapsToDevicePixels="True">
    <!-- Shared decorative material. The optional blur is attached only to these three
         fixed-size light sources; text, lists and virtualized rows never receive it. -->
    <Grid Opacity="{DynamicResource GscAmbientPageOpacity}">
        <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-96,-124,0,0" Opacity="0.90" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscAccentShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-88,-86,0" Opacity="0.68" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscInfoShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-86,-104" Opacity="0.68" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscSuccessShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
