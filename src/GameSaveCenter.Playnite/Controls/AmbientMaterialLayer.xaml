<UserControl x:Class="GameSaveCenter.Playnite.Controls.AmbientMaterialLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False"
             ClipToBounds="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <!-- Shared decorative material. The optional blur is attached only to these four
         fixed-size light sources; text, lists and virtualized rows never receive it. -->
    <Grid Opacity="{DynamicResource GscAmbientPageOpacity}">
        <Ellipse x:Name="LeftAmbientGlow"
                 Visibility="{Binding ShowLeftGlow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibility}}"
                 Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,18,0,0" Opacity="0.92" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscAccentShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <!-- Keep the fixed light source inside the rounded shell. Extending it past the
             right edge created a clipped blue/green bar instead of a soft corner bloom. -->
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,52,0" Opacity="0.72" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscInfoShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,52,28" Opacity="0.72" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscSuccessShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <!-- A broad, low-alpha center wash makes the material readable across large empty
             workspaces at high strength. It is still a fixed decorative ellipse and never
             becomes a blur over page content. -->
        <Ellipse Width="680" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.66" Effect="{DynamicResource GscAmbientBlurEffect}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource GscAmbientCenterShadowColor}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
